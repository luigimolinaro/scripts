#*------------------------------------------------------------
#* Define Defaults
#*    1: Tools Directory
#*------------------------------------------------------------

defineDefaults () {
    if [[ -z $CX ]]; then
        [[ $1 == . ]] || cd $1
        [[ $(pwd) == / ]] || CX=$(dirname $(pwd))
    fi
    [[ -z $CX ]] && CX="/usr/local/CX"
    export CPD_CLI_MANAGE_WORKSPACE=$CX
    Config4ROSA=$CX/data/cx.rosa.json
    [[ -f $Config4ROSA ]] || abort "ROSA Configuration, $Config4ROSA, not found"

    DeployOptions=(Hub IKC MANTA BAR)
}

#*------------------------------------------------------------
#* Replace CX
#*    1: String
#*------------------------------------------------------------

replaceCX () {
    sed -e "s/$(sed -e "s/\//\\\\\//g" <<< $CX)/\$CX/" <<< $1
}

#*------------------------------------------------------------
#* Get Color
#*    1: Color
#*------------------------------------------------------------

getColor () {
    [[ -z $Monochrome ]] && case $1 in
        Black)      echo "\033[0;30m";;
        BoldBlack)  echo "\033[1;30m";;
        Red)        echo "\033[0;31m";;
        Green)      echo "\033[0;32m";;
        Blue)       echo "\033[0;34m";;
        BoldBlue)   echo "\033[1;34m";;
        Purple)     echo "\033[0;35m";;
        BoldCyan)   echo "\033[1;36m";;
        None)       echo "\033[0m";;
    esac
}

#*------------------------------------------------------------
#* Color Text
#*    1: Text
#*------------------------------------------------------------

colorText () {
    echo -e -n "$*$(getColor None)"
}

#*------------------------------------------------------------
#* Normal Text
#*    1: Text
#*------------------------------------------------------------

normal () {
    colorText "$(getColor Black)$*"
}

#*------------------------------------------------------------
#* Bold Text
#*    1: Text
#*------------------------------------------------------------

bold () {
    colorText "$(getColor BoldBlack)$*"
}

#*------------------------------------------------------------
#* Blue Text
#*    1: Text
#*------------------------------------------------------------

blue () {
    colorText "$(getColor Blue)$*"
}

#*------------------------------------------------------------
#* Purple Text
#*    1: Text
#*------------------------------------------------------------

purple () {
    colorText "$(getColor Purple)$*"
}

#*------------------------------------------------------------
#* Always log this message
#*    1: Message
#*------------------------------------------------------------

log () {
    echo -e "[$(date +"%Y-%m-%d %H:%M %Z")] $*$(getColor None)" 1>&2
}

#*------------------------------------------------------------
#* Always log Command To this message
#*    1: Message
#*------------------------------------------------------------

logCommand () {
    echo -e "$(bold [$(date +"%Y-%m-%d %H:%M %Z")] Command to) $(getColor Blue)$*$(getColor None):-"
}

#*------------------------------------------------------------
#* Always log Content To this message
#*    1: Message
#*------------------------------------------------------------

logContent () {
    echo -e "$(bold [$(date +"%Y-%m-%d %H:%M %Z")] Content of) $(getColor Blue)$*$(getColor None):-"
}

#*------------------------------------------------------------
#* log this header message
#*    1: Message
#*------------------------------------------------------------

logHeader () {
    echo -e "$(bold [$(date +"%Y-%m-%d %H:%M %Z")]) $(getColor Blue)$*$(getColor None)"
}

#*------------------------------------------------------------
#* Log this Information Message if not Terse
#*    1: Message
#*    2: Force Verbose
#*------------------------------------------------------------

info () {
    [[ $_LoggingMode == --terse && -z $2 ]] || log "$(getColor Blue)INFO: $1"
}

#*------------------------------------------------------------
#* Log this Debug Message if Verbose
#*    1: Message
#*    2: Force Verbose
#*------------------------------------------------------------

debug () {
    [[ $_LoggingMode == --verbose || ! -z $2 ]] && log "$(getColor Purple)DEBUG: $1"
}

#*------------------------------------------------------------
#* Log this Warning Message if not Terse
#*    1: Message
#*    2: Force Verbose
#*------------------------------------------------------------

warning () {
    [[ $_LoggingMode == --terse && -z $2 ]] || log "$(getColor Purple)WARNING: $1"
}

#*------------------------------------------------------------
#* Log this Pass Message if not Terse
#*    1: Message
#*    2: Force Verbose
#*------------------------------------------------------------

pass () {
    [[ $_LoggingMode == --terse && -z $2 ]] || log "$(getColor Green)PASS: $1"
}

#*------------------------------------------------------------
#* Always log this Fail Message
#*    1: Message
#*------------------------------------------------------------

fail () {
    log "$(getColor Red)FAIL: $*"
}

#*------------------------------------------------------------
#* Always log this Abort Message
#*    1: Message
#*------------------------------------------------------------

abort () {
    log "$(getColor Red)Aborting: $*\n"
    exit 1
}

#*------------------------------------------------------------
#* Abort on Fail
#*    1: Outcome to achieve
#*    2: Command to execute
#*    3: Silently
#*------------------------------------------------------------

abortOnFail () {
    local Outcome2Achieve=$(tr -s ' ' <<< $1)
    local Command2Execute=$(tr -s ' ' <<< $2)
    local Silently=$3
    cat << EOF >> $LogFile

$(logCommand $Outcome2Achieve)$(echo -e $(getColor Purple))
$Command2Execute
$(echo -e $(getColor None))
EOF
    [[ -z $Silently ]] && info "  $Outcome2Achieve" force
    $Command2Execute >> $LogFile 2>&1 && pass "  $Outcome2Achieve" force || abort "Failed to $Outcome2Achieve"
}

#*------------------------------------------------------------
#* Continue on Fail
#*    1: Outcome to achieve
#*    2: Command to execute
#*    3: Silently
#*------------------------------------------------------------

continueOnFail () {
    local Outcome2Achieve=$(tr -s ' ' <<< $1)
    local Command2Execute=$(tr -s ' ' <<< $2)
    local Silently=$3
    cat << EOF >> $LogFile

$(logCommand $Outcome2Achieve)$(echo -e $(getColor Purple))
$Command2Execute
$(echo -e $(getColor None))
EOF
    [[ -z $Silently ]] && info "  $Outcome2Achieve" force
    $Command2Execute >> $LogFile 2>&1 && pass "  $Outcome2Achieve" force || fail "  $Outcome2Achieve"
}

#*------------------------------------------------------------
#* Option Name Text
#*    1: Text
#*------------------------------------------------------------

option () {
    colorText "$(getColor Blue)$*"
}

#*------------------------------------------------------------
#* Option Value Text
#*    1: Text
#*------------------------------------------------------------

value () {
    colorText "$(getColor Purple)$*"
}

#*------------------------------------------------------------
#* Options List
#*    1: List
#*------------------------------------------------------------

options () {
    colorText "$(getColor Purple)$*"
}

#*------------------------------------------------------------
#* Default Text
#*    1: Text
#*------------------------------------------------------------

default () {
    colorText "$(getColor Purple)$*"
}

#*------------------------------------------------------------
#* Red Text
#*    1: Text
#*------------------------------------------------------------

red () {
    colorText "$(getColor Red)$*"
}

#*------------------------------------------------------------
#* Bold Blue Text
#*    1: Text
#*------------------------------------------------------------

boldBlue () {
    colorText "$(getColor BoldBlue)$*"
}

#*------------------------------------------------------------
#* Dashes
#*    1: Count
#*------------------------------------------------------------

dashes () {
    printf '\055%.0s' $(seq $1)
}

#*------------------------------------------------------------
#* Get Options
#*    1: Type of Option
#*------------------------------------------------------------

getOptions () {
    case $1 in
        deploy) echo ${DeployOptions[@]};;
    esac
}

#*------------------------------------------------------------
#* List Options
#*    1: Type of Option
#*------------------------------------------------------------

listOptions () {
    unset Options
    for Option in $(getOptions $1); do
        [[ -z $Options ]] || Options+=", "
        Options+=$Option
    done
    echo $Options
}

#*------------------------------------------------------------
#* Get Default Option
#*    1: Type of Option
#*------------------------------------------------------------

getDefaultOption () {
    getOptions $1 | head -1 | awk '{print $1}'
}

#*------------------------------------------------------------
#* Show help
#*------------------------------------------------------------

showHelp () {
    local Release=$(jq --raw-output .release $Config4ROSA)
    cat << EOF 1>&2

Usage:
  $(bold $(basename $0)) $(option --configure) [$(option --worker) <$(value node)>] [$(option --CX) <$(value home)>] [$(option --monochrome)] [$(option --verbose)]

  $(bold $(basename $0)) $(option --deploy) <$(value option)> [$(option --CX) <$(value home)>] [$(option --monochrome)] [$(option --verbose)]

  $(bold $(basename $0)) $(option --query) [$(option --CX) <$(value home)>] [$(option --monochrome)] [$(option --verbose)]

  $(bold $(basename $0)) $(option --purge) [$(option --CX) <$(value home)>] [$(option --monochrome)] [$(option --verbose)]

  $(bold $(basename $0)) $(option --archive) { $(value List) [$(option --all)] | $(value Check) | $(value Size) | <$(value ID)> [ $(option --backup) [$(option --check)] | $(option --restore) <$(value ID)> | $(option --erase) ] [$(option --yes)] }
             [$(option --CX) <$(value home)>] [$(option --monochrome)] [$(option --verbose)]

  $(bold $(basename $0)) $(option --help) [$(option --CX) <$(value home)>] [$(option --monochrome)] [$(option --verbose)]

EOF
    if [[ $_LoggingMode == --verbose ]]; then
        cat << EOF 1>&2
    where
      $(option --configure)    Configure Pre-requisites
                         - Configure Utilities (podman, jq, yq, oc)
EOF
        [[ $Release =~ 5.1. ]] && cat << EOF 1>&2
                         - Configure special File Storage Class for Db2
EOF
        cat << EOF 1>&2
                         - Configure Container PIDs Limit
                         - Configure Pull Secrets
                         - Configure OLM Utilities
      $(option --worker)       Get Pull Secrets and Pids Limit from specific Worker Node ($(value default):- $(default Any Worker Node))

      $(option --deploy)       Deploy options
		     - $(value Hub)
                         - Configure IBM Certificate Manager and Licensing
                         - Configure IBM CPD Scheduler
                         - Authorize Instance Topology
                         - Setup IBM Software Hub
		     - $(value IKC)
                         - Enable Knowledge Graph
EOF
        [[ $Release =~ 5.1. ]] && cat << EOF 1>&2
                         - Configure unlimited privilege for Db2
                         - Configure unrestricted Db2-as-a-service
                         - Patch to create the missing databases
EOF
        cat << EOF 1>&2
		     - $(value MANTA)
		     - $(value BAR)

      $(option --query)        Query Cluster Detail
      $(option --purge)        Purge existing deployment

      $(option --archive)      Archive options
		     - $(value List)  Backups matching Archive suffix in S3 Object Store
                         $(option --all)     List all Backups in S3 Object Store
                     - $(value Check) Check if all deployed services support platform backup and restore
                     - $(value Size)  Estimate Backup Size
                     - <$(value ID)>  Archive prefix (default show OADP Backup status from S3 Object Store)
                         $(option --backup)  Execute OADP Backup
                             $(option --check)  Check all deployed services support BAR and Estimate Backup Size
                         $(option --restore) Execute OADP Restore with Restore ID prefix
                         $(option --erase)   Erase OADP Backup from S3 Object Store
      $(option --yes)          Bypass Confirmation

      $(option --CX)           CX Home ($(value default):- $(default $CX))
      $(option --monochrome)   Monochrome Logging
      $(option --verbose)      Verbose Execution

      $(option --help)         Print this usage help

Assumptions:
- Cluster has been created. Instructions are available in below reference document
- File Storage Class has been created
- Script will be used to deploy Cloud Pak for Data 5.[12].x on any officially supported OCP version

Reference:
  Deploying IBM Cloud Pak for Data on Red Hat OpenShift Service on AWS (ROSA)
  https://aws.amazon.com/blogs/ibm-redhat/deploying-ibm-cloud-pak-for-data-on-red-hat-openshift-service-on-aws-rosa/

EOF
    fi
    exit $?
}

#*------------------------------------------------------------
#* Log Usage
#*    1: Message
#*------------------------------------------------------------

usage () {
    echo 1>&2
    fail "$1"
    echo 1>&2
    showHelp 1
}

#*------------------------------------------------------------
#* Check Parameter
#*    1: Name of Option
#*    2: Name of Value
#*    3: Value specified
#*------------------------------------------------------------

checkParameter () {
    [[ -z $3 || $(echo $3 | cut -c1,1) == - ]] && usage "--$1 <$2> not specified"
}

#*------------------------------------------------------------
#* Check Option
#*    1: Name of Option
#*    2: Name of Value
#*    3: Value specified
#*------------------------------------------------------------

checkOption () {
    checkParameter $1 $2 $3
    for Option in $(getOptions $1); do
        [[ $Option == $3 ]] && return 0
    done
    echo 1>&2
    echo "Invalid $2 ($3) specified for --$1" 1>&2
    echo "Valid $1 ${2}s: $(listOptions $1)" 1>&2
    echo 1>&2
    showHelp 2
}

#*------------------------------------------------------------
#* Parse Options
#*------------------------------------------------------------

parseOptions () {
    unset DeployOption ArchiveID AllBackups CheckBAR BypassConfirmation Monochrome _LoggingMode TheWorkerNode
    _Action=showHelp
    for opt in $*; do
        case $1 in
            -c | --configure)                                                          _Action=configure;      shift;;
            -w | --worker)     checkParameter worker node $2; TheWorkerNode=$2;                                shift 2;;
            -d | --deploy)     checkOption deploy option $2;  DeployOption=$2;         _Action=deploy$2;       shift 2;;
            -q | --query)                                                              _Action=queryDetail;    shift;;
            -p | --purge)                                                              _Action=purgeDeploy;    shift;;

            -a | --archive)    checkParameter archive ID $2;  ArchiveID=$2;                                    shift 2;;
            --all)                                            AllBackups=true;                                 shift;;
            --check)                                          CheckBAR=true;                                   shift;;
            -e | --erase)                                                              _Action=eraseBackup;    shift;;
            -b | --backup)                                                             _Action=executeBackup;  shift;;
            -r | --restore)    checkParameter restore ID $2;  RestoreID=$2;            _Action=executeRestore; shift 2;;
            -y | --yes)                                       BypassConfirmation=true;                         shift;;

            -T | --Test)                                                               _Action=testSnippet;    shift;;

            -C | --CX)         checkParameter CX home $2;     CX=$2;                                           shift 2;;
            -m | --monochrome)                                Monochrome=--monochrome;                         shift;;
            -v | --verbose)                                   _LoggingMode=--verbose;                          shift;;

            -h | --help)                                                               _Action=showHelp;       shift;;
            -u | --usage)                                                              _Action=showHelp;       shift;;
            *) break;;
        esac
    done

    [[ $# -ne 0 ]] && usage "Invalid option $1"
    if [[ $_Action == showHelp ]]; then
        if [[ $ArchiveID == List ]]; then
            _Action=listBackups
        elif [[ $ArchiveID == Check ]]; then
            _Action=checkRegistry
        elif [[ $ArchiveID == Size ]]; then
            _Action=estimateSize
        elif [[ ! -z $ArchiveID ]]; then
            _Action=statusBackup
        else
            showHelp 0
        fi
    elif [[ "|executeBackup|executeRestore|eraseBackup|" =~ "|$_Action|" && -z $ArchiveID ]]; then
        abort "Archive ID required for Backup, Restore or Erase operation. Not specified"
    fi
}

#*------------------------------------------------------------
#* Parse OpenShift Cluster Configuration
#*    1: Silently
#*------------------------------------------------------------

parseConfiguration () {
    local Silently=$1
    [[ -z $Silently ]] && info "Checking OpenShift Cluster Configurations" force

    InstanceNS=$(jq --raw-output .namespace.instance $Config4ROSA)
    [[ $InstanceNS == null ]] && abort "Instance Namespace definition is missing in ROSA Configuration, $Config4ROSA"
    [[ -z $InstanceNS ]] && abort "Instance Namespace is missing in ROSA Configuration, $Config4ROSA"
    OperatorNS=$(jq --raw-output .namespace.operator $Config4ROSA)
    [[ $OperatorNS == null ]] && abort "Operator Namespace definition is missing in ROSA Configuration, $Config4ROSA"
    [[ -z $OperatorNS ]] && abort "Operator Namespace is missing in ROSA Configuration, $Config4ROSA"
    SchedulerNS=$(jq --raw-output .namespace.scheduler $Config4ROSA)
    [[ $SchedulerNS == null ]] && abort "IBM CPD Scheduler Namespace definition is missing in ROSA Configuration, $Config4ROSA"
    [[ -z $SchedulerNS ]] && abort "IBM CPD Scheduler Namespace is missing in ROSA Configuration, $Config4ROSA"
    CertManagerNS=$(jq --raw-output .namespace.certManager $Config4ROSA)
    [[ $CertManagerNS == null ]] && abort "IBM Certificate Manager Namespace definition is missing in ROSA Configuration, $Config4ROSA"
    [[ -z $CertManagerNS ]] && abort "IBM Certificate Manager Namespace is missing in ROSA Configuration, $Config4ROSA"
    LicensingNS=$(jq --raw-output .namespace.licensing $Config4ROSA)
    [[ $LicensingNS == null ]] && abort "IBM Licensing Namespace definition is missing in ROSA Configuration, $Config4ROSA"
    [[ -z $LicensingNS ]] && abort "IBM Licensing Namespace is missing in ROSA Configuration, $Config4ROSA"

    FileStorageClass=$(jq --raw-output .storageClass.file $Config4ROSA)
    [[ $FileStorageClass == null ]] && abort "File Storage Class definition is missing in ROSA Configuration, $Config4ROSA"
    [[ -z $FileStorageClass ]] && abort "File Storage Class name is missing in ROSA Configuration, $Config4ROSA"
    BlockStorageClass=$(jq --raw-output .storageClass.block $Config4ROSA)
    [[ $BlockStorageClass == null ]] && abort "Block Storage Class definition is missing in ROSA Configuration, $Config4ROSA"
    [[ -z $BlockStorageClass ]] && abort "Block Storage Class name is missing in ROSA Configuration, $Config4ROSA"

    if [[ $Release =~ 5.1. ]]; then
        Db2FileStorageClass=$(jq --raw-output .storageClass.db2 $Config4ROSA)
        [[ $Db2FileStorageClass == null ]] && abort "Db2-specific File Storage Class definition is missing in ROSA Configuration, $Config4ROSA"
        [[ -z $Db2FileStorageClass ]] && abort "Db2-specific File Storage Class name is missing in ROSA Configuration, $Config4ROSA"
    fi

    [[ -z $Silently ]] && echo
}

#*------------------------------------------------------------
#* Configure utilities
#*    1: Log File
#*------------------------------------------------------------

configureUtilities () {
    local LogFile=$1
    log "  Configure Utilities"

    local Utility="Podman Utility"
    [[ -z $(which podman 2>/dev/null) ]] && abortOnFail "Configure $Utility" "yum install -y podman --allowerasing" Silently
    info "  $Utility $(podman version | awk '{if($1=="Version:") print $2}')" force

    Utility="JSON Processor (jq) Utility"
    [[ -z $(which jq 2>/dev/null) ]] && abortOnFail "Configure $Utility" "yum install -y jq" Silently
    info "  $Utility $(jq --version | awk -F'-' '{print $2}')" force

    Utility="YAML Processor (yq) Utility"
    if [[ -z $(which yq 2>/dev/null) ]]; then
        local YQ=https://github.com/mikefarah/yq/releases/latest/download/yq_linux
        case $(uname -m) in
            x86_64)  YQ+="_amd64";;
            ppc64le) YQ+="_ppc64le";;
        esac
        abortOnFail "Download latest $Utility" "wget -qO /usr/local/bin/yq $YQ" Silently
        abortOnFail "Add execute permission to $Utility" "chmod u+x /usr/local/bin/yq" Silently
    fi
    info "  $Utility $(yq --version | awk '{print $NF}')" force

    local OpenShiftClient=$(jq --raw-output .openshift.clientVersion $Config4ROSA)
    [[ $OpenShiftClient == null ]] && abort "OpenShift Client Version definition is missing in ROSA Configuration, $Config4ROSA"
    [[ -z $OpenShiftClient ]] && abort "OpenShift Client Version is missing in ROSA Configuration, $Config4ROSA"

    Utility="OpenShift Client Utility"
    if [[ -z $(which oc 2>/dev/null) ]]; then
        local Tarball=https://mirror.openshift.com/pub/openshift-v4/clients/ocp/stable-$OpenShiftClient/openshift-client-linux
        [[ $(uname -m) == ppc64le ]] && Tarball+="-ppc64le"
        Tarball+=".tar.gz"
        local Outcome2Achieve="Configure $Utility $OpenShiftClient"
        cat << EOF >> $LogFile

$(logCommand $Outcome2Achieve)$(echo -e $(getColor Purple))
wget -c $Tarball -O - 2>/dev/null | sudo tar -xz -C /usr/local/bin
$(echo -e $(getColor None))
EOF
        wget -c $Tarball -O - 2>/dev/null | sudo tar -xz -C /usr/local/bin >> $LogFile 2>&1 || abort "Failed to $Outcome2Achieve"
        pass "  $Outcome2Achieve" force
    fi
    info "  $Utility $(oc version 2>/dev/null | awk '/Client Version/{print $NF}')" force
}

#*------------------------------------------------------------
#* Generate DaemonSet to push updated Pull Secrets to worker nodes
#*------------------------------------------------------------

generateDaemonSet2PushPullSecrets () {
    cat << EOF
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: $SecretName
  namespace: kube-system
  labels:
    tier: management
    app: $SecretName
spec:
  selector:
    matchLabels:
      name: $SecretName
  template:
    metadata:
      labels:
        name: $SecretName
    spec:
      hostNetwork: true
      hostPID: true
      hostIPC: true
      containers:
        - name: sleepforever
          resources:
            requests:
              cpu: 0.01
          image: registry.access.redhat.com/ubi8:latest
          command: ["/bin/sh", "-c"]
          args:
            - >
              date >> /ext-tmp/$SecretName.log ;
              echo "Following new Pull Secrets configuration will be applied to $PullSecretsConfigJSON" ;
              cat /pull-secret/newdockerconfigjson ;
              cat /pull-secret/newdockerconfigjson > /ext-config/$(basename $PullSecretsConfigJSON) ;
              while true; do
                sleep 100000;
              done
          volumeMounts:
            - name: pull-secret
              mountPath: /pull-secret
              readOnly: true
            - name: modifytmp
              mountPath: /ext-tmp
            - name: modifyconfig
              mountPath: /ext-config
      volumes:
        - name: pull-secret
          secret:
            secretName: $SecretName
        - name: modifytmp
          hostPath:
            path: /tmp
        - name: modifyconfig
          hostPath:
            path: $(dirname $PullSecretsConfigJSON)
EOF
}

#*------------------------------------------------------------
#* Wait for DaemonSet
#*    1: DaemonSet Name
#*    2: Outcome to Achieve
#*    3: Expected Pod Count
#*------------------------------------------------------------

wait4DaemonSet () {
    local DaemonSetName=$1
    local Outcome2Achieve=$2
    local ExpectedPodCount=$3
    local Counter=0
    while true; do
        (( Counter++ ))
        [[ $(oc get pod --selector name=$DaemonSetName --namespace kube-system --no-headers 2>> /dev/null |\
             awk '{if($2==Ready&&$3=Status) print $1}' Ready=1/1 Status=Running | wc -l) -eq $ExpectedPodCount ]] && break
        [[ $Counter -eq 120 ]] && abort "Failed to $Outcome2Achieve even after $(expr $Counter / 6) mins"
        [[ $(expr $Counter % 6) -eq 0 ]] && info "  Still waiting to $Outcome2Achieve after $(expr $Counter / 6) mins" force
        sleep 10
    done
}

#*------------------------------------------------------------
#* Wait for Rolling Upgrade
#*------------------------------------------------------------

wait4RollingUpgrade () {
    local Counter=0
    while [[ $(oc get MachineConfigPool worker --output json |\
               jq --raw-output --arg type Updated '.status.conditions[] | select(.type == $type) | .status') == True && \
             $(oc get MachineConfigPool master --output json |\
               jq --raw-output --arg type Updated '.status.conditions[] | select(.type == $type) | .status') == True ]]; do
        (( Counter++ ))
        [[ $(expr $Counter % 6) -eq 0 ]] && info "  Still waiting for Rolling Upgrade to begin after $(expr $Counter / 6) mins ..." force
        sleep 10
    done
    Counter=0
    info "  Rolling Upgrade started" force
    while [[ $(oc get MachineConfigPool worker --output json |\
               jq --raw-output --arg type Updated '.status.conditions[] | select(.type == $type) | .status') == False || \
             $(oc get MachineConfigPool master --output json |\
               jq --raw-output --arg type Updated '.status.conditions[] | select(.type == $type) | .status') == False ]]; do
        (( Counter++ ))
        if [[ $(expr $Counter % 12) -eq 0 ]]; then
            info "  Still waiting for Rolling Upgrade to complete after $(expr $Counter / 6) mins ..." force
            oc get MachineConfigPool | awk '{print $1" "$3" "$4" "$5" "$6" "$7" "$8" "$9}' |\
            sed -e "s/NAME/Name/;s/UPDATED/Updated/g;s/UPDATING/Updating/g;s/DEGRADED/Degraded/g;s/MACHINECOUNT/MachineCount/g" | column -t
        fi
        sleep 10
    done
    pass "  Rolling Upgrade Completed" force
}

#*------------------------------------------------------------
#* Configure Pull Secrets
#*    1: Log File
#*------------------------------------------------------------

configurePullSecrets () {
    local LogFile=$1

    log "  Checking Credentials to access Public IBM Container Registry (ICR)"
    local URL4ICR=$(jq --raw-output .access.registry.URL $Config4ROSA)
    [[ $URL4ICR == null ]] && abort "URL for IBM Container Registry definition is missing in ROSA Configuration, $Config4ROSA"
    [[ -z $URL4ICR ]] && abort "URL for IBM Container Registry is missing in ROSA Configuration, $Config4ROSA"
    local Email4ICR=$(jq --raw-output .access.registry.email $Config4ROSA)
    [[ $Email4ICR == null ]] && abort "Email Address for IBM Container Registry definition is missing in ROSA Configuration, $Config4ROSA"
    [[ -z $Email4ICR ]] && abort "Email Address for IBM Container Registry is missing in ROSA Configuration, $Config4ROSA"
    local User4ICR=$(jq --raw-output .access.registry.user $Config4ROSA)
    [[ $User4ICR == null ]] && abort "User for IBM Container Registry definition is missing in ROSA Configuration, $Config4ROSA"
    [[ -z $User4ICR ]] && abort "User for IBM Container Registry is missing in ROSA Configuration, $Config4ROSA"
    local Key4ICR=$(jq --raw-output .access.registry.key $Config4ROSA)
    [[ $Key4ICR == null ]] && abort "Key for IBM Container Registry definition is missing in ROSA Configuration, $Config4ROSA"
    [[ -z $Key4ICR ]] && abort "Key for IBM Container Registry is missing in ROSA Configuration, $Config4ROSA"
    local TargetPullSecret=$(echo -n "$User4ICR:$Key4ICR" | base64 -w0)

    log "  Checking Pull Secrets from worker node, $TheWorkerNode"
    local PullSecretsConfigJSON=/var/lib/kubelet/config.json
    local RemotePullSecretsJSON=$CX/data/rosa.config.json
    local UpdatedPullSecretsJSON=$CX/data/updated.rosa.config.json
    [[ -f $UpdatedPullSecretsJSON ]] && rm -f $UpdatedPullSecretsJSON 2>/dev/null
    local Outcome2Achieve="Get Pull Secrets Config JSON, $PullSecretsConfigJSON, from $TheWorkerNode"
    cat << EOS >> $LogFile

$(logCommand $Outcome2Achieve)$(echo -e $(getColor Purple))
cat << EOF | oc debug node/$TheWorkerNode > $(replaceCX $RemotePullSecretsJSON)
chroot /host
cat $PullSecretsConfigJSON
EOF
$(echo -e $(getColor None))
EOS
    cat << EOF | oc debug node/$TheWorkerNode > $RemotePullSecretsJSON 2>>$LogFile || abort "Failed to $Outcome2Achieve"
chroot /host 2>/dev/null
cat $PullSecretsConfigJSON
EOF
    local RemotePullSecret=$(jq --raw-output --arg RepoPath $URL4ICR '.auths | .[$RepoPath] | .auth' $RemotePullSecretsJSON)
    if [[ $RemotePullSecret == null ]]; then
        info "  Append Pull Secret for $URL4ICR" force
        jq --arg URL $URL4ICR \
           --arg PullSecret "$TargetPullSecret" \
           --arg Email $Email4ICR \
           '.auths += {($URL): {"auth": $PullSecret,
                                "email": $Email}}' $RemotePullSecretsJSON > $UpdatedPullSecretsJSON
    elif [[ $RemotePullSecret != $TargetPullSecret ]]; then
        info "  Update Pull Secret for $URL4ICR" force
        jq --arg URL $URL4ICR \
           --arg PullSecret "$TargetPullSecret" \
           '.auths += {($URL): {"auth": $PullSecret}}' $RemotePullSecretsJSON > $UpdatedPullSecretsJSON
    fi
    if [[ ! -f $UpdatedPullSecretsJSON ]]; then
        info "Pull Secrets are up-to-date" force
        return
    fi

    if [[ $(oc version | awk '/Server Version/{print $3}') =~ 4.1[2-4]. ]]; then
        Need2RestartCrio=true
        local SecretName=rosa-pull-secrets
        [[ -z $(oc get secret $SecretName --namespace kube-system --ignore-not-found 2> /dev/null) ]] || \
            abortOnFail "Delete Secret, $SecretName" "oc delete secret $SecretName --namespace kube-system" Silently
        abortOnFail "Create Generic Secret, $SecretName, from $(replaceCX $UpdatedPullSecretsJSON)" \
                    "oc create secret generic $SecretName --namespace kube-system --from-file=newdockerconfigjson=$UpdatedPullSecretsJSON" Silently

        if [[ ! -z $(oc get DaemonSet $SecretName --namespace kube-system --ignore-not-found 2> /dev/null) ]]; then
            abortOnFail "Delete DaemonSet, $SecretName, that push updated Pull Secrets to all worker nodes" \
                        "oc delete DaemonSet $SecretName --namespace kube-system" Silently
            wait4DaemonSet $SecretName "Delete DaemonSet, $SecretName, to push updated Pull Secrets to all worker nodes" 0
        fi

        Outcome2Achieve="Create DaemonSet, $SecretName, to push updated Pull Secrets to all worker nodes"
        cat << EOS >> $LogFile

$(logCommand $Outcome2Achieve)$(echo -e $(getColor Purple))
cat << EOF | oc apply -f -
$(generateDaemonSet2PushPullSecrets | yq --colors)$(echo -e $(getColor Purple))
EOF
$(echo -e $(getColor None))
EOS
        generateDaemonSet2PushPullSecrets | oc apply -f - >> $LogFile 2>&1 && pass "  $Outcome2Achieve" force || abort "Failed to $Outcome2Achieve"
        wait4DaemonSet $SecretName "Apply DaemonSet, $SecretName, to push updated Pull Secrets to all worker nodes" $WorkerNodes
    else
        Outcome2Achieve="Configure Pull Secrets"
        cat << EOF >> $LogFile

$(logCommand $Outcome2Achieve)$(echo -e $(getColor Purple))
oc set data secret/pull-secret --namespace openshift-config \\
                               --from-file=.dockerconfigjson=\$CX/data/$(basename $UpdatedPullSecretsJSON)
$(echo -e $(getColor None))
EOF
        oc set data secret/pull-secret --namespace openshift-config \
                                       --from-file=.dockerconfigjson=$UpdatedPullSecretsJSON >> $LogFile 2>&1 \
            && pass "  $Outcome2Achieve" force || abort "Failed to $Outcome2Achieve"
        wait4RollingUpgrade
    fi
    sleep 60
}

#*------------------------------------------------------------
#* Generate PIDs Limit YAML
#*------------------------------------------------------------

generatePIDsLimitYAML () {
    cat << EOF
apiVersion: machineconfiguration.openshift.io/v1
kind: ContainerRuntimeConfig
metadata:
  name: new-large-pidlimit
spec:
  containerRuntimeConfig:
    pidsLimit: $MinimumPIDsLimit
  machineConfigPoolSelector:
    matchExpressions:
    - key: pools.operator.machineconfiguration.openshift.io/worker
      operator: Exists
EOF
}

#*------------------------------------------------------------
#* Configure PIDs Limit
#*    1: Log File
#*------------------------------------------------------------

configurePIDsLimit () {
    local LogFile=$1
    local MinimumPIDsLimit=$(jq --raw-output .minimumPIDsLimit $Config4ROSA)
    [[ $MinimumPIDsLimit == null ]] && abort "Minimum PIDs Limit definition is missing in ROSA Configuration, $Config4ROSA"
    [[ -z $MinimumPIDsLimit ]] && abort "Minimum PIDs Limit is missing in ROSA Configuration, $Config4ROSA"

    log "  Checking PIDs Limit from worker node, $TheWorkerNode"
    cat << EOS >> $LogFile

$(logCommand Get current PIDs Limit)$(echo -e $(getColor Purple))
    cat << EOF | oc debug node/$TheWorkerNode 2>/dev/null | awk '/pids_limit/{print $NF}'
chroot /host 2>/dev/null
cat /etc/crio/crio.conf.d/*
EOF
$(echo -e $(getColor None))
EOS
    local CurrentPIDsLimit=$(cat << EOF | oc debug node/$TheWorkerNode 2>/dev/null | awk '/pids_limit/{print $NF}'
chroot /host 2>/dev/null
cat /etc/crio/crio.conf.d/*
EOF
)
    if [[ $CurrentPIDsLimit -lt $MinimumPIDsLimit ]]; then
        Need2RestartCrio=true
        local Outcome2Achieve="Configure PIDs Limit to $MinimumPIDsLimit from $CurrentPIDsLimit on all worker nodes"
        cat << EOS >> $LogFile

$(logCommand $Outcome2Achieve)$(echo -e $(getColor Purple))
cat << EOF | oc apply -f -
$(generatePIDsLimitYAML | yq --colors)$(echo -e $(getColor Purple))
EOF
$(echo -e $(getColor None))
EOS
        generatePIDsLimitYAML | oc apply -f - >> $LogFile 2>&1 || abort "Failed to $Outcome2Achieve"
        local attempt=1
        while true; do
            cat << EOF | oc debug node/$TheWorkerNode 2>/dev/null | grep "pids_limit = $MinimumPIDsLimit" >> /dev/null && break
chroot /host 2>/dev/null
cat /etc/crio/crio.conf.d/*
EOF
            [[ $attempt -eq 90 ]] && abort "Failed to $Outcome2Achieve even after $(expr $attempt / 6) mins"
            [[ $(expr $attempt % 6) -eq 0 ]] && info "  $Outcome2Achieve still not completed after $(expr $attempt / 6) mins" force
            sleep 10
            (( attempt++ ))
        done
        pass "  $Outcome2Achieve" force
    else
        pass "  PIDs Limit of $CurrentPIDsLimit from $TheWorkerNode node satisfies minimum PIDs limit ($MinimumPIDsLimit) needed on the worker nodes" force
    fi
}

#*------------------------------------------------------------
#* Restart CRI-O Service
#*    1: Log File
#*------------------------------------------------------------

restartCrioService () {
    local LogFile=$1
    local Outcome2Achieve="Restart CRI-O Service on ROSA Worker Node"
    info "  ${Outcome2Achieve}s" force
    for WorkerNode in $(oc get nodes --selector node-role.kubernetes.io/worker --output custom-columns='name:.metadata.name' --no-headers); do
        [[ -z $(oc get node $WorkerNode --show-labels | grep node-role.kubernetes.io=infra) ]] || continue
        cat << EOS >> $LogFile

$(logCommand $Outcome2Achieve, $WorkerNode)$(echo -e $(getColor Purple))
cat << EOF | oc debug node/$WorkerNode
chroot /host
systemctl restart crio
EOF
$(echo -e $(getColor None))
EOS
        cat << EOF | oc debug node/$WorkerNode >> $LogFile 2>&1 && pass "    $Outcome2Achieve, $WorkerNode" force || fail "    $Outcome2Achieve, $WorkerNode"
chroot /host 2>/dev/null
systemctl restart crio
EOF
    done
    sleep 60
}

#*------------------------------------------------------------
#* Generate Db2-specific File Storage Class
#*    1: Db2-specific File Storage Class
#*    2: File System ID
#*------------------------------------------------------------

generateDb2FileStorageClass () {
    local Db2FileStorageClass=$1
    local FileSystemID=$2
    cat << EOF
apiVersion: storage.k8s.io/v1
kind: StorageClass
metadata:
  name: $Db2FileStorageClass
parameters:
  directoryPerms: "777"
  fileSystemId: $FileSystemID
  uid: "0"
  gid: "0"
  provisioningMode: efs-ap
provisioner: efs.csi.aws.com
reclaimPolicy: Delete
volumeBindingMode: Immediate
EOF
}

#*------------------------------------------------------------
#* Configure Storage Classes
#*    1: Log File
#*------------------------------------------------------------

configureStorageClasses () {
    local LogFile=$1
    log "  Configure Storage Classes"

    FileStorageClass=$(jq --raw-output .storageClass.file $Config4ROSA)
    [[ $FileStorageClass == null ]] && abort "File Storage Class definition is missing in ROSA Configuration, $Config4ROSA"
    [[ -z $FileStorageClass ]] && abort "File Storage Class name is missing in ROSA Configuration, $Config4ROSA"
    oc get StorageClass $FileStorageClass >/dev/null 2>&1 \
        && info "  File Storage Class, $FileStorageClass" force || abort "File Storage Class, $FileStorageClass, not found"

    BlockStorageClass=$(jq --raw-output .storageClass.block $Config4ROSA)
    [[ $BlockStorageClass == null ]] && abort "Block Storage Class definition is missing in ROSA Configuration, $Config4ROSA"
    [[ -z $BlockStorageClass ]] && abort "Block Storage Class name is missing in ROSA Configuration, $Config4ROSA"
    oc get StorageClass $BlockStorageClass >/dev/null 2>&1 \
        && info "  Block Storage Class, $BlockStorageClass" force || abort "Block Storage Class, $BlockStorageClass, not found"

    [[ $Release =~ 5.1. ]] || return
    Db2FileStorageClass=$(jq --raw-output .storageClass.db2 $Config4ROSA)
    [[ $Db2FileStorageClass == null ]] && abort "Db2-specific File Storage Class definition is missing in ROSA Configuration, $Config4ROSA"
    [[ -z $Db2FileStorageClass ]] && abort "Db2-specific File Storage Class name is missing in ROSA Configuration, $Config4ROSA"
    if [[ -z $(oc get StorageClass $Db2FileStorageClass 2>/dev/null) ]]; then
        local FileSystemID=$(oc get StorageClass $FileStorageClass --output jsonpath='{.parameters.fileSystemId}')
        [[ -z $FileSystemID ]] && abort "Failed to get File System ID from File Storage Class, $FileStorageClass"
        local Outcome2Achieve="Create Db2-specific File Storage Class, $Db2FileStorageClass"
        cat << EOS >> $LogFile
$(logCommand $Outcome2Achieve)$(echo -e $(getColor Purple))
cat << EOF | oc apply -f -
$(generateDb2FileStorageClass $Db2FileStorageClass $FileSystemID | yq --colors)$(echo -e $(getColor Purple))
EOF
$(echo -e $(getColor None))
EOS
        generateDb2FileStorageClass $Db2FileStorageClass $FileSystemID | oc apply -f - >> $LogFile 2>&1 \
            && pass "  $Outcome2Achieve" || abort "Failed to $Outcome2Achieve"
    else
        info "  Db2-specific File Storage Class, $Db2FileStorageClass" force
    fi
}

#*------------------------------------------------------------
#* Configure OLM Utilities
#*    1: Log File
#*------------------------------------------------------------

configureOLMutilities () {
    local LogFile=$1

    local ImageOLM=olm-utils-v3
    local ContainerOLM=olm-utils-play-v3
    export run_utils="podman exec $ContainerOLM"

    if [[ ! -z $(podman images | grep $ImageOLM) && ! -z $(podman ps | grep $ContainerOLM) ]]; then
        podman exec $ContainerOLM versioninfo >> /dev/null 2>&1
        [[ $? -eq 126 ]] || return
    fi

    for ExistingContainerOLM in $(podman ps | awk '/olm-utils-play/{print $NF}'); do
        abortOnFail "Terminate running OLM Utility, $ExistingContainerOLM" "podman rm --force $ExistingContainerOLM" Silently
    done
    for ImageID in $(podman images | awk '/olm-utils/{print $3}'); do
        abortOnFail "Delete existing OLM Utility Image with ID, $ImageID" "podman rmi --force $ImageID" Silently
    done

    export work_dir=$CX/work
    [[ -d $work_dir ]] && rm -rf $work_dir
    mkdir -p $work_dir
    chmod 777 $work_dir

    Release=$(jq --raw-output .release $Config4ROSA)
    [[ $Release == null ]] && abort "Cloud Pak for Data Release definition is missing in ROSA Configuration, $Config4ROSA"
    [[ -z $Release ]] && abort "Cloud Pak for Data Release is missing in ROSA Configuration, $Config4ROSA"

    abortOnFail "Initialize OLM Utilities" "podman run -d --name $ContainerOLM -v $work_dir:/tmp/work icr.io/cpopen/cpd/$ImageOLM:$Release" Silently
    local Counter=0
    while true; do
        (( Counter++ ))
        $run_utils ls -d /tmp/work/.airgap >> /dev/null 2>&1 && break
        [[ $Counter -eq 60 ]] && abort "Failed waiting for OLM Utilities to initialize after $(expr $Counter / 6) mins"
        [[ $(expr $Counter % 12) -eq 0 ]] && info "  Still waiting for OLM Utilities to initialize after $(expr $Counter / 6) mins" force
        sleep 10
    done
    [[ -z $(grep "export CPD_CLI_MANAGE_WORKSPACE=$CX" ~/.bashrc 2>/dev/null) ]] && echo "export CPD_CLI_MANAGE_WORKSPACE=$CX" >> ~/.bashrc
    podman cp $ContainerOLM:/opt/ansible/ansible-play/config-vars/global.yml $CX/data/global.yml
    podman cp $ContainerOLM:/opt/ansible/ansible-play/config-vars/release-$Release.yml $CX/data/release-$Release.yml
}

#*------------------------------------------------------------
#* Configure Pre-requisites
#*------------------------------------------------------------

configurePreRequisites () {
    local LogFile=$CX/log/Configure.PreReqs.$(date +%F_%H%M%S).log
    log "Configure Pre-requisites"
    configureUtilities $LogFile
    prepareOLMutilities $LogFile
    configureStorageClasses $LogFile
    local Need2RestartCrio
    unset Need2RestartCrio
    configurePIDsLimit $LogFile
    configurePullSecrets $LogFile
    [[ -z $Need2RestartCrio ]] || restartCrioService $LogFile
}

#*------------------------------------------------------------
#* Login via OLM Utilities
#*    1: Log File
#*------------------------------------------------------------

loginViaOLMutilities () {
    local LogFile=$1
    log "  Checking Credentials to access OpenShift Cluster"
    URL4REST=$(jq --raw-output .access.openshiftAPI.restURL $Config4ROSA)
    [[ $URL4REST == null ]] && abort "URL for OpenShift REST API definition is missing in ROSA Configuration, $Config4ROSA"
    [[ -z $URL4REST ]] && abort "URL for OpenShift REST API is missing in ROSA Configuration, $Config4ROSA"

    Token4REST=$(jq --raw-output .access.openshiftAPI.token $Config4ROSA)
    if [[ $Token4REST == null ]]; then
        unset Token4REST
        User4REST=$(jq --raw-output .access.openshiftAPI.adminUser $Config4ROSA)
        if [[ $User4REST == null ]]; then
            abort "Token for OpenShift REST API definition is missing in ROSA Configuration, $Config4ROSA"
        else
            [[ -z $User4REST ]] && abort "User for OpenShift REST API is missing in ROSA Configuration, $Config4ROSA"
            Password4REST=$(jq --raw-output .access.openshiftAPI.password $Config4ROSA)
            [[ $Password4REST == null ]] && abort "Password for OpenShift REST API definition is missing in ROSA Configuration, $Config4ROSA"
            [[ -z $Password4REST ]] && abort "Password for OpenShift REST API is missing in ROSA Configuration, $Config4ROSA"
        fi
    elif [[ -z $Token4REST ]]; then
        abort "Token for OpenShift REST API is missing in ROSA Configuration, $Config4ROSA"
    fi
    oc cluster-info >/dev/null 2>&1
    if [[ $? -eq 0 ]]; then
        $run_utils oc cluster-info >/dev/null 2>&1 && return 0
    fi

    local Outcome2Achieve="Login to OpenShift Cluster"
    if [[ -z $Token4REST ]]; then
        cat << EOF >> $LogFile

$(logCommand $Outcome2Achieve)$(echo -e $(getColor Purple))
$run_utils login-to-ocp \\
    --username $User4REST \\
    --password <Password for $User4REST> \\
    --server=$URL4REST
$(echo -e $(getColor None))
EOF
        oc login \
            --username $User4REST \
            --password $Password4REST \
            --server=$URL4REST \
            --insecure-skip-tls-verify=true >> $LogFile 2>&1 && pass "  $Outcome2Achieve" || abort "Failed to $Outcome2Achieve"
        Outcome2Achieve+=" via OLM utilities"
        $run_utils login-to-ocp \
            --username $User4REST \
            --password $Password4REST \
            --server=$URL4REST >> $LogFile 2>&1 && pass "  $Outcome2Achieve" || abort "Failed to $Outcome2Achieve"
    else
        cat << EOF >> $LogFile

$(logCommand $Outcome2Achieve)$(echo -e $(getColor Purple))
$run_utils login-to-ocp \\
    --token <Token> \\
    --server=$URL4REST
$(echo -e $(getColor None))
EOF
        oc login \
            --token $Token4REST \
            --server=$URL4REST \
            --insecure-skip-tls-verify=true >> $LogFile 2>&1 && pass "  $Outcome2Achieve" || abort "Failed to $Outcome2Achieve"
        Outcome2Achieve+=" via OLM utilities"
        $run_utils login-to-ocp \
            --token $Token4REST \
            --server=$URL4REST >> $LogFile 2>&1 && pass "  $Outcome2Achieve" || abort "Failed to $Outcome2Achieve"
    fi
}

#*------------------------------------------------------------
#* Prepare OLM Utilities
#*    1: Log File
#*------------------------------------------------------------

prepareOLMutilities () {
    local LogFile=$1
    configureOLMutilities $LogFile
    loginViaOLMutilities $LogFile

    if [[ ! -z $(which jq 2>/dev/null) ]]; then
        Release=$(jq --raw-output .release $Config4ROSA)
        [[ $Release == null ]] && abort "Cloud Pak for Data Release definition is missing in ROSA Configuration, $Config4ROSA"
        [[ -z $Release ]] && abort "Cloud Pak for Data Release is missing in ROSA Configuration, $Config4ROSA"
    fi

    if [[ ! -z $(which oc 2>/dev/null) ]]; then
        if [[ $_Action == configure && -z $TheWorkerNode ]]; then
            for WorkerNode in $(oc get nodes --selector node-role.kubernetes.io/worker \
                                   --output custom-columns='name:.metadata.name' --no-headers | sort -R); do
                [[ -z $(oc get node $WorkerNode --show-labels | grep node-role.kubernetes.io=infra) ]] || continue
                TheWorkerNode=$WorkerNode
                break
            done
        fi

        WorkerNodes=$(oc get nodes --selector node-role.kubernetes.io/worker --no-headers | wc -l)
        (( WorkerNodes -= $(oc get nodes --selector node-role.kubernetes.io/worker,node-role.kubernetes.io/infra --no-headers 2>/dev/null | wc -l) ))
    fi
}

#*------------------------------------------------------------
#* Get Cloud Pak for Data (cpd-cli) Version
#*------------------------------------------------------------

getCloudPak4DataUtilityVersion () {
    local Version=$(cpd-cli version)
    echo "$(awk '/CPD Release Version:/{print $NF}' <<< $Version)-$(awk '{if($1=="Version:") print $2}' <<< $Version) Build ($(awk '/Build Number:/{print $NF}'  <<< $Version))"
}

#*------------------------------------------------------------
#* Configure Cloud Pak for Data CLI Utility
#*------------------------------------------------------------

configureCPDCLI () {
    local LogFile=$CX/log/Configure.cpd-cli.$(date +%F_%H%M%S).log
    local URL=$(jq --raw-output '."cpd-cli"' $Config4ROSA)
    [[ $URL == null ]] && abort "CPD CLI URL definition is missing in ROSA Configuration, $Config4ROSA"
    [[ -z $URL ]] && abort "CPD CLI URL is missing in ROSA Configuration, $Config4ROSA"

    while true; do
        if [[ $(awk -F'-' '{print $NF}' <<< $URL | sed -e "s/\.tgz//") == \
              $(cpd-cli version 2>/dev/null | awk '{if($1==ID) print $2}' ID=Version:) ]]; then
            pass "  Found Cloud Pak for Data (cpd-cli) Utility $(getCloudPak4DataUtilityVersion)" force
            return
        fi
        [[ -z $(which cpd-cli 2>/dev/null) ]] && break
        local OriginalDir4CPDCLI=$(dirname $(which cpd-cli 2>/dev/null))
        rm -rf $OriginalDir4CPDCLI.old
        debug "Renaming $OriginalDir4CPDCLI to $OriginalDir4CPDCLI.old" force
        mv $OriginalDir4CPDCLI $OriginalDir4CPDCLI.old
    done

    log "  Configure Cloud Pak for Data (cpd-cli) Utility"
    local TarBall=$CX/$(basename $URL)
    rm -f $TarBall
    curl --silent --location --fail --noproxy \* $URL --output $TarBall 2>/dev/null
    [[ -f $TarBall ]] || abort "Failed to download $URL"
    tar xzvf $TarBall --directory=$CX >/dev/null || abort "Failed to untar $(basename $TarBall)"
    rm -rf $TarBall $CX/CPD
    mv $CX/$(cd ..; ls -d cpd-cli*) $CX/CPD
    if [[ -z $(grep "export PATH=$CX/CPD:\$PATH" ~/.bashrc >>/dev/null) ]]; then
        echo "export PATH=$CX/CPD:\$PATH" >> ~/.bashrc
        export PATH=$CX/CPD:$PATH
        fi
    if [[ -z $(grep "export CPD_CLI_MANAGE_WORKSPACE=$CX" ~/.bashrc 2>/dev/null) ]]; then
        echo "export CPD_CLI_MANAGE_WORKSPACE=$CX" >> ~/.bashrc
        export CPD_CLI_MANAGE_WORKSPACE=$CX
    fi
    mkdir -p $CX/work
    pass "  Configured Cloud Pak for Data (cpd-cli) Utility $(getCloudPak4DataUtilityVersion)" force
}

#*------------------------------------------------------------
#* Generate YAML
#*    1: Type: Namespace, OperatorGroup
#*------------------------------------------------------------

generateYAML () {
    case $1 in
        Namespace) cat << EOF
apiVersion: v1
kind: Namespace
metadata:
  name: $OadpNS
EOF
                   ;;
        OperatorGroup) cat << EOF
apiVersion: operators.coreos.com/v1
kind: OperatorGroup
metadata:
  name: $OadpNS
  namespace: $OadpNS
spec:
  targetNamespaces:
  - $OadpNS
EOF
                       ;;
        Subscription) local ChannelVersion=stable-1.4
                      cat << EOF
apiVersion: operators.coreos.com/v1alpha1
kind: Subscription
metadata:
  name: redhat-oadp-operator
  namespace: $OadpNS
spec:
  channel: $ChannelVersion
  installPlanApproval: Automatic
  name: redhat-oadp-operator
  source: redhat-operators
  sourceNamespace: openshift-marketplace
EOF
                      ;;
        CustomResource) local BedrockPluginVersion=4.10.0
                        cat << EOF
apiVersion: oadp.openshift.io/v1alpha1
kind: DataProtectionApplication
metadata:
  name: dpa-sample
  namespace: $OadpNS
spec:
  configuration:
    velero:
      customPlugins:
      - image: icr.io/cpopen/cpd/cpdbr-velero-plugin:$Release$([[ $Release =~ 5.1.0 ]] && echo "-$(uname -m)")
        name: cpdbr-velero-plugin
EOF
                        [[ $Release =~ 5.1. ]] || cat << EOF
      - image: icr.io/cpopen/cpd/swhub-velero-plugin:$Release
        name: swhub-velero-plugin
      - image: icr.io/cpopen/cpfs/cpfs-oadp-plugins:$BedrockPluginVersion
        name: cpfs-oadp-plugin
      - image: icr.io/db2u/db2u-velero-plugin:$Release
        name: db2u-velero-plugin
EOF
                        cat << EOF
      defaultPlugins:
      - aws
      - openshift
      - csi
      podConfig:
        resourceAllocations:
          limits:
            cpu: "1"
            memory: 4Gi
          requests:
            cpu: 500m
            memory: 256Mi
      resourceTimeout: 60m
    nodeAgent:
      enable: true
      timeout: 72h
      uploaderType: kopia
      podConfig:
        resourceAllocations:
          limits:
            cpu: "2"
            memory: 32Gi
          requests:
            cpu: 500m
            memory: 256Mi
      tolerations:
        - key: icp4data
          operator: Exists
          effect: NoSchedule
  backupImages: false
  backupLocations:
  - velero:
      provider: aws
      default: true
      objectStorage:
        bucket: $S3Bucket
        prefix: $S3Prefix
      config:
        region: $S3Region
        s3ForcePathStyle: "true"
        s3Url: $S3URL
      credential:
        name: $S3Credential
        key: cloud
EOF
                        ;;
    esac
}

#*------------------------------------------------------------
#* Wait for Redhat OADP Operator to be Ready
#*------------------------------------------------------------

wait4Operator4OADP () {
    for ResourceTypeName in Subscription "Cluster Service Version" Deployment; do
        ResourceName="Redhat OADP $ResourceTypeName"
        ResourceType=$(tr -d ' ' <<< $ResourceTypeName)
        cat << EOF >> $LogFile

$(logCommand Check $ResourceName Status)$(echo -e $(getColor Purple))
oc get $ResourceType --selector operators.coreos.com/redhat-oadp-operator.$OadpNS= --namespace $OadpNS$(echo -e $(getColor None))
EOF
        FailedCount=0
        Counter=1
        while true; do
            ServiceStatus=Completed
            TheQuery="oc get $ResourceType --selector operators.coreos.com/redhat-oadp-operator.$OadpNS= --namespace $OadpNS"
            if [[ $ResourceType == Subscription ]]; then
                [[ -z $($TheQuery --no-headers --ignore-not-found | awk '{print $1}') ]] && ServiceStatus=Not-Found
            elif [[ $ResourceType == ClusterServiceVersion ]]; then
                [[ -z $($TheQuery --no-headers --ignore-not-found | awk '/Succeeded/{print $NF}') ]] && ServiceStatus=In-Progress
            elif [[ $ResourceKind == Deployment ]]; then
                ReadyStatus=$($TheQuery --no-headers --ignore-not-found | awk '{print $2}' 2> /dev/null)
                if [[ -z $ReadyStatus ]]; then
                    ServiceStatus=Not-Found
                elif [[ $(cut -d'/' -f1 <<< $ReadyStatus) -ne $(cut -d'/' -f2 <<< $ReadyStatus) ]]; then
                    ServiceStatus=In-Progress
                fi
            fi
            local ElapsedMins=$(expr $Counter / 6)
            [[ $ServiceStatus == failed || $ServiceStatus == Failed ]] && abort "Failed to create $ResourceName"
            if [[ ":successful:Succeeded:Completed:Complete:Running:" =~ ":$ServiceStatus:" ]]; then
                pass "  $ResourceName is ready $([[ $ElapsedMins -eq 0 ]] || echo after $ElapsedMins mins)" force
                break
            fi
            [[ $Counter -eq 120 ]] && abort "Failed to create $ResourceName after $ElapsedMins mins"
            if [[ $Counter -eq 1 ]]; then
                info "  Waiting for $ResourceName to be ready" force
                debug "    $TheQuery" force
            fi
            [[ $(expr $Counter % 12) -eq 0 ]] && info "  Still waiting for $ResourceName to be ready after $ElapsedMins mins" force
            (( Counter++ ))
            sleep 10
        done
    done
}

#*------------------------------------------------------------
#* List Velero Restic Pods
#*
#* Each line describes a Velero Restic Pod
#*
#* <Name>:<Label>:<Ready>:<Count>:<Deploy>
#*
#* where:
#*     <Name>: Pod Name
#*     <Label>: Pod Label
#*     <Ready>: Ready
#*     <Count>: Pod Count
#*     <Deploy>: Deployment Name
#*------------------------------------------------------------

listVeleroResticPods () {
    local NodeAgents=$(oc get DaemonSet node-agent --namespace $OadpNS \
                          --output custom-columns='desired:.status.desiredNumberScheduled' --no-headers 2>/dev/null)
    cat << EOF
Nodeagent Pods|name=node-agent|1/1|$NodeAgents|nodeagent
Velero Pod|app.kubernetes.io/name=velero|1/1|1|velero
EOF
}

#*------------------------------------------------------------
#* Wait for Redhat OADP Operand to be Ready
#*------------------------------------------------------------

wait4Operand4OADP () {
    while IFS= read -r VeleroResticPod; do
        local Count=$(cut -d'|' -f4 <<< $VeleroResticPod)
        local Pods="$Count Redhat OADP $(cut -d'|' -f1 <<< $VeleroResticPod)"
        local Label=$(cut -d'|' -f2 <<< $VeleroResticPod)
        local Ready=$(cut -d'|' -f3 <<< $VeleroResticPod)
        local Counter=1
        while true; do
            [[ $(oc get pods --selector $Label --namespace $OadpNS --no-headers 2>/dev/null |\
                 awk -F' ' '{if($2==Ready && $3=="Running") print $1}' Ready=$Ready | wc -l) == $Count ]] && break
            [[ $Counter -eq 30 ]] && abort "$Pods not found even after 5 mins"
            [[ $(expr $Counter % 6) -eq 0 ]] && info "  Still waiting for $Pods to be ready after $(expr $Counter / 6) mins" force
            (( Counter++ ))
            sleep 10
        done
        pass "  Found $Pods" force
    done < <(listVeleroResticPods)
    cat << EOF >> $LogFile

$(logCommand Velero Restic OADP Pods)$(echo -e $(getColor Purple))
$(oc get pods --namespace $OadpNS)
$(echo -e $(getColor None))
EOF
}

#*------------------------------------------------------------
#* Execute YAML
#*    1: Outcome to achieve
#*    2: Identifier for YAML
#*    3: Silently
#*------------------------------------------------------------

executeYAML () {
    local Outcome2Achieve=$1
    local Identifier4YAML=$2
    local Silently=$3
    cat << EOF >> $LogFile

$(logCommand $Outcome2Achieve)$(echo -e $(getColor Purple))
$(generateYAML $Identifier4YAML)
$(echo -e $(getColor None))
EOF
    [[ -z $Silently ]] && info "  $Outcome2Achieve" force
    generateYAML $Identifier4YAML | oc apply -f - >> $LogFile 2>&1 && pass "  $Outcome2Achieve" force || abort "Failed to $Outcome2Achieve"
    case $Identifier4YAML in
        Subscription)   wait4Operator4OADP;;
        CustomResource) wait4Operand4OADP;;
    esac
}

#*------------------------------------------------------------
#* Generate Dummy Pod
#*------------------------------------------------------------

generateDummyPod () {
    cat << EOF
apiVersion: v1
kind: Pod
metadata:
  name: $DummyPodName
  namespace: $InstanceNS
spec:
  imagePullSecrets:
  - name: regcred
  containers:
  - name: busybox-container
    image: busybox
    command:
      - sleep
      - infinity
    volumeMounts:
      - name: data
        mountPath: /data
  volumes:
   - name:  data
     persistentVolumeClaim:
       claimName: $ClaimName
EOF
}

#*------------------------------------------------------------
#* Deploy BAR App
#*------------------------------------------------------------

deployApp4BAR () {
    local DeleteProjectNamespace=$CX/tools/delete-cpd-namespace.sh
    if [[ ! -f $DeleteProjectNamespace ]]; then
        curl https://raw.githubusercontent.com/IBM/cpd-cli/refs/heads/master/cpdops/files/delete-cpd-namespace.sh 2> /dev/null |\
            sed -e "s/read -p.*/REPLY=Y/;s/retry_delay=5/retry_delay=30/" > $DeleteProjectNamespace
        chmod 755 $DeleteProjectNamespace
    fi
    rm -f $CX/app/scripts/delete-cpd-namespace.sh
    cp $DeleteProjectNamespace $CX/app/scripts

    rm -f $CX/app/config/global.yml
    cp $CX/data/global.yml $CX/app/config

    local ROSAappJSON=$(jq --null-input \
                           --arg Namespace $(jq --raw-output .namespace.oadp $CX/data/cx.rosa.json) \
                           '.namespace += {oadp: $Namespace}')
    ROSAappJSON=$(jq --arg Namespace $(jq --raw-output .namespace.oadpApp $CX/data/cx.rosa.json) \
                     '.namespace += {oadpApp: $Namespace}' <<< $ROSAappJSON)
    ROSAappJSON=$(jq --arg Namespace $(jq --raw-output .namespace.operator $CX/data/cx.rosa.json) \
                     '.namespace += {operator: $Namespace}' <<< $ROSAappJSON)
    ROSAappJSON=$(jq --arg Namespace $(jq --raw-output .namespace.instance $CX/data/cx.rosa.json) \
                     '.namespace += {instance: $Namespace}' <<< $ROSAappJSON)
    ROSAappJSON=$(jq --argjson ArchiveJSON $(jq --compact-output .archive $CX/data/cx.rosa.json) \
                     '. += {archive: $ArchiveJSON}' <<< $ROSAappJSON)
    ROSAappJSON=$(jq --arg URL $(jq --raw-output '."cpd-cli"' $CX/data/cx.rosa.json) \
                     '. += {"cpd-cli": $URL}' <<< $ROSAappJSON)
    ROSAappJSON=$(jq --arg WebHook $(jq --raw-output '."oadp-app-webhook"' $CX/data/cx.rosa.json) \
                     '. += {"oadp-app-webhook": $WebHook}' <<< $ROSAappJSON)
    jq . <<< $ROSAappJSON > $CX/app/config/cx.oadp.app.json
    pass "  Generated CX OADP App JSON" force

    local AppLogFile=$CX/log/Deploy.BAR.App.$(date +%F_%H%M%S).log
    local Outcome2Achieve="Configure REST API app for Backup / Restore Operations"
    cat << EOF >> $LogFile

$(logCommand $Outcome2Achieve)$(echo -e $(getColor Purple))
$CX/app/oadp_app/deploy.sh -c $URL4REST -u $User4REST -p <Admin Password> > $AppLogFile$(echo -e $(getColor None))
EOF
    $CX/app/oadp_app/deploy.sh -c $URL4REST -u $User4REST -p $Password4REST > $AppLogFile 2>&1 || abort "Failed to $Outcome2Achieve"
    pass "  $Outcome2Achieve" force
}

#*------------------------------------------------------------
#* Deploy BAR
#* https://www.ibm.com/docs/en/software-hub/5.1.x?topic=software-installing-configuring-oadp-utility
#* https://www.ibm.com/docs/en/cloud-paks/cp-data/4.8.x?topic=restore-offline-backup-fails-pvc-not-bound-error
#*------------------------------------------------------------

deployBAR () {
    local LogFile=$CX/log/Deploy.BAR.$(date +%F_%H%M%S).log
    rm -f $LogFile
    log "Deploy BAR"
    prepareOLMutilities $LogFile

    log "  Checking OpenShift Cluster Configurations"
    local OadpNS=$(jq --raw-output .namespace.oadp $Config4ROSA)
    if [[ $OadpNS == null ]]; then
        local OldConfig4ROSA=$(sed -s "s/json/$(date +"%Y%m%d%H%M").json/" <<< $Config4ROSA)
        debug "Saving original configuration as $OldConfig4ROSA" force
        cp $Config4ROSA $OldConfig4ROSA
        local ConfigurationJSON=$(jq '.namespace     += {"oadp":            "openshift-adp"}'                      $Config4ROSA)
        [[ $(jq --raw-output .namnespace.oadpApp              $Config4ROSA) == null ]] && \
            ConfigurationJSON=$(jq '.namespace       += {"oadpApp":         "openshift-adp-app"}'                  <<< $ConfigurationJSON)
        [[ $(jq --raw-output .access.docker.username          $Config4ROSA) == null ]] && \
            ConfigurationJSON=$(jq '.access.docker   += {"username":        "Docker User"}'                        <<< $ConfigurationJSON)
        [[ $(jq --raw-output .access.docker.password          $Config4ROSA) == null ]] && \
            ConfigurationJSON=$(jq '.access.docker   += {"password":        "Password for Docker User"}'           <<< $ConfigurationJSON)
        [[ $(jq --raw-output .access.amazonS3.bucket          $Config4ROSA) == null ]] && \
            ConfigurationJSON=$(jq '.access.amazonS3 += {"bucket":          "S3 Bucket"}'                          <<< $ConfigurationJSON)
        [[ $(jq --raw-output .access.amazonS3.prefix          $Config4ROSA) == null ]] && \
            ConfigurationJSON=$(jq '.access.amazonS3 += {"prefix":          "S3 Prefix"}'                          <<< $ConfigurationJSON)
        [[ $(jq --raw-output .access.amazonS3.region          $Config4ROSA) == null ]] && \
            ConfigurationJSON=$(jq '.access.amazonS3 += {"region":          "us-east-1"}'                          <<< $ConfigurationJSON)
        [[ $(jq --raw-output .access.amazonS3.URL             $Config4ROSA) == null ]] && \
            ConfigurationJSON=$(jq '.access.amazonS3 += {"URL":             "https://s3.us-east-1.amazonaws.com"}' <<< $ConfigurationJSON)
        [[ $(jq --raw-output .access.amazonS3.accessKeyID     $Config4ROSA) == null ]] && \
            ConfigurationJSON=$(jq '.access.amazonS3 += {"accessKeyID":     "Access Key ID"}'                      <<< $ConfigurationJSON)
        [[ $(jq --raw-output .access.amazonS3.secretAccessKey $Config4ROSA) == null ]] && \
            ConfigurationJSON=$(jq '.access.amazonS3 += {"secretAccessKey": "Secret Access Key"}'                  <<< $ConfigurationJSON)
        [[ $(jq --raw-output '."cpd-cli"'                     $Config4ROSA) == null ]] && \
            ConfigurationJSON=$(jq '.                += {"cpd-cli":         "https://github.com/IBM/cpd-cli/releases/download/v14.1.3/cpd-cli-linux-EE-14.1.3.tgz"}' <<< $ConfigurationJSON)
        jq . <<< $ConfigurationJSON > $Config4ROSA
        abort "Please update the missing ROSA Configuration, $Config4ROSA"
    fi
    [[ -z $OadpNS ]] && abort "OADP Namespace is missing in ROSA Configuration, $Config4ROSA"
    local OadpAppNS=$(jq --raw-output .namespace.oadpApp $Config4ROSA)
    [[ $OadpAppNS == null ]] && abort "OADP App Namespace definition is missing in ROSA Configuration, $Config4ROSA"
    [[ -z $OadpAppNS ]] && abort "OADP App Namespace is missing in ROSA Configuration, $Config4ROSA"
    local OperatorNS=$(jq --raw-output .namespace.operator $Config4ROSA)
    [[ $OperatorNS == null ]] && abort "Operator Namespace definition is missing in ROSA Configuration, $Config4ROSA"
    [[ -z $OperatorNS ]] && abort "Operator Namespace is missing in ROSA Configuration, $Config4ROSA"
    local InstanceNS=$(jq --raw-output .namespace.instance $Config4ROSA)
    [[ $InstanceNS == null ]] && abort "Instance Namespace definition is missing in ROSA Configuration, $Config4ROSA"
    [[ -z $InstanceNS ]] && abort "Instance Namespace is missing in ROSA Configuration, $Config4ROSA"
    local DockerUsername=$(jq --raw-output .access.docker.username $Config4ROSA)
    [[ $DockerUsername == null ]] && abort "Docker Username definition is missing in ROSA Configuration, $Config4ROSA"
    [[ -z $DockerUsername ]] && abort "Docker Username is missing in ROSA Configuration, $Config4ROSA"
    local DockerPassword=$(jq --raw-output .access.docker.password $Config4ROSA)
    [[ $DockerPassword == null ]] && abort "Docker Password definition is missing in ROSA Configuration, $Config4ROSA"
    [[ -z $DockerPassword ]] && abort "Docker Password is missing in ROSA Configuration, $Config4ROSA"
    local S3Bucket=$(jq --raw-output .access.amazonS3.bucket $Config4ROSA)
    [[ $S3Bucket == null ]] && abort "S3 Bucket definition is missing in ROSA Configuration, $Config4ROSA"
    [[ -z $S3Bucket ]] && abort "S3 Bucket is missing in ROSA Configuration, $Config4ROSA"
    local S3Prefix=$(jq --raw-output .access.amazonS3.prefix $Config4ROSA)
    [[ $S3Prefix == null ]] && abort "S3 Prefix definition is missing in ROSA Configuration, $Config4ROSA"
    [[ -z $S3Prefix ]] && abort "S3 Prefix is missing in ROSA Configuration, $Config4ROSA"
    local S3Region=$(jq --raw-output .access.amazonS3.region $Config4ROSA)
    [[ $S3Region == null ]] && abort "S3 Region definition is missing in ROSA Configuration, $Config4ROSA"
    [[ -z $S3Region ]] && abort "S3 Region is missing in ROSA Configuration, $Config4ROSA"
    local S3URL=$(jq --raw-output .access.amazonS3.URL $Config4ROSA)
    [[ $S3URL == null ]] && abort "S3 URL definition is missing in ROSA Configuration, $Config4ROSA"
    [[ -z $S3URL ]] && abort "S3 URL is missing in ROSA Configuration, $Config4ROSA"
    local S3AccessKeyID=$(jq --raw-output .access.amazonS3.accessKeyID $Config4ROSA)
    [[ $S3AccessKeyID == null ]] && abort "S3 Access Key ID definition is missing in ROSA Configuration, $Config4ROSA"
    [[ -z $S3AccessKeyID ]] && abort "S3 Access Key ID is missing in ROSA Configuration, $Config4ROSA"
    local S3SecretAccessKey=$(jq --raw-output .access.amazonS3.secretAccessKey $Config4ROSA)
    [[ $S3SecretAccessKey == null ]] && abort "S3 Secret Access Key definition is missing in ROSA Configuration, $Config4ROSA"
    [[ -z $S3SecretAccessKey ]] && abort "S3 Secret Access Key is missing in ROSA Configuration, $Config4ROSA"

    if [[ -z $(oc project $OadpNS 2>/dev/null) ]]; then
        executeYAML "Create OADP Namespace $OadpNS"                    Namespace     Silently
        executeYAML "Create OADP Operator Group for Namespace $OadpNS" OperatorGroup Silently
        abortOnFail "Annotate OADP Namespace, $OadpNS" \
                    "oc annotate namespace $OadpNS openshift.io/node-selector= --overwrite" \
                    Silently
    fi
    if [[ -z $(oc get secret dockerpullsecret --namespace $OadpNS --no-headers 2>/dev/null) ]]; then
        abortOnFail "Create OADP Docker Registry Pull Secret for Namespace $OadpNS" \
                    "oc create secret docker-registry dockerpullsecret --docker-server=docker.io \
                                                                       --docker-username=$DockerUsername \
                                                                       --docker-password="$DockerPassword" --namespace $OadpNS" \
                    Silently
        abortOnFail "Link OADP Docker Pull Secret for Namespace $OadpNS" \
                    "oc secrets link default dockerpullsecret --for=pull --namespace $OadpNS" \
                    Silently
    fi

    configureCPDCLI
    if [[ ! -z $(oc project $OperatorNS 2>/dev/null) ]]; then
        local Outcome2Achieve="Install CPDBR Tenant"
        local Command2Execute="cpd-cli oadp install --component=cpdbr-tenant --namespace $OadpNS --tenant-operator-namespace $OperatorNS --skip-recipes"
        if [[ ! -z $(oc get pod --selector icpdsupport/addOnId=cpdbr --namespace $OperatorNS 2>/dev/null) ]]; then
            Outcome2Achieve="Upgrade CPDBR Tenant"
            Command2Execute+=" --upgrade"
        fi
        [[ $_LoggingMode == --verbose ]] && Command2Execute+=" --verbose --log-level=debug"
        abortOnFail "$Outcome2Achieve" "$Command2Execute" Silently
    fi

    executeYAML "Create Redhat OADP Subscription"           Subscription   Silently
    local S3Credential=cloud-credential
    if [[ -z $(oc get secret $S3Credential --namespace $OadpNS --no-headers 2>/dev/null) ]]; then
       cat << EOF > $CX/data/credentials-velero
[default]
aws_access_key_id = $S3AccessKeyID
aws_secret_access_key = "$S3SecretAccessKey"
EOF
        abortOnFail "Create generic Cloud credentials" \
                    "oc create secret generic $S3Credential --namespace $OadpNS \
                        --from-file cloud=$CX/data/credentials-velero" \
                    Silently
    fi
    executeYAML "Create Redhat OADP Protection Application" CustomResource Silently
    cat << EOF >> $LogFile

$(logHeader Backup Storage Location)$(echo -e $(getColor Purple))
$(cpd-cli oadp backup-location list --namespace $OadpNS)
$(echo -e $(getColor None))
EOF

    Outcome2Achieve="Set Client Config OADP Namespace to $OadpNS"
    cat << EOF >> $LogFile

$(logCommand $Outcome2Achieve)$(echo -e $(getColor Purple))
cpd-cli oadp client config set namespace=$OadpNS --namespace $OadpNS$(echo -e $(getColor None))
EOF
    local Counter=0
    while true; do
        (( Counter++ ))
        cpd-cli oadp client config set namespace=$OadpNS --namespace $OadpNS >> $LogFile 2>&1 && break
        [[ $Counter -eq 60 ]] && abort "Failed to $Outcome2Achieve after $(expr $Counter / 6) mins"
        [[ $(expr $Counter % 12) -eq 0 ]] && info "  Still waiting to $Outcome2Achieve after $(expr $Counter / 6) mins" force
        sleep 10
    done
    pass "  $Outcome2Achieve" force

    deployApp4BAR

    local DummyPodName=debug-pod-$(date +%F-%H%M%S)
    for ClaimName in $(oc get PersistentVolumeClaim --namespace $InstanceNS | awk '{if($2==Status) print $1}' Status=Pending); do
        Outcome2Achieve="Create Pod, $DummyPodName, with pending persistent volume claim, $ClaimName"
        cat << EOS >> $LogFile

$(logCommand $Outcome2Achieve)$(echo -e $(getColor Purple))
cat << EOF | oc apply -f -
$(generateDummyPod | yq --colors)$(echo -e $(getColor Purple))
EOF
$(echo -e $(getColor None))
EOS
        generateDummyPod | oc apply -f - >> $LogFile 2>&1 && pass "  $Outcome2Achieve" force || fail "  $Outcome2Achieve"
        continueOnFail "Delete Pod, $DummyPodName" "oc delete Pod $DummyPodName --namespace $InstanceNS" Silently
    done

    [[ $(cpd-cli oadp backup-location list --namespace $OadpNS | grep -v ^NAME | awk '{print $5}') == Available ]] && pass "Deploy BAR" force || fail "Deploy BAR"
}

#*------------------------------------------------------------
#* Get Metadata ID
#*    1: Component ID
#*    2: Metadata ID
#*------------------------------------------------------------

getMetadataID () {
    local ComponentID=$1
    local MetadataID=$2
    yq .global_components_meta.$ComponentID.$MetadataID < $CX/data/global.yml
}

#*------------------------------------------------------------
#* Get Release Metadata ID
#*    1: Component ID
#*    2: Metadata ID
#*------------------------------------------------------------

getReleaseMetadataID () {
    local ComponentID=$1
    local MetadataID=$2
    yq .release_components_meta.$ComponentID.$MetadataID < $CX/data/release-$Release.yml
}


#*------------------------------------------------------------
#* Wait for Component
#*    1: Log File
#*    2: Component ID
#*------------------------------------------------------------

wait4Component () {
    local LogFile=$1
    local ComponentID=$2
    local ResourceKind=$(getMetadataID $ComponentID cr_kind)
    [[ $ResourceKind == null ]] && return
    local ResourceNames=$(getMetadataID $ComponentID cr_name)
    [[ $ResourceNames == null ]] && warning "Missing Resource Name for $ComponentID"
    local StatusField=$(getMetadataID $ComponentID status_field)
    [[ "|placeholderStatus|null|" =~ "|$StatusField|" ]] && return
    local StatusSuccess=$(getMetadataID $ComponentID status_success)
    [[ $StatusSuccess == null ]] && StatusSuccess=Completed
    local StatusFailed=$(getMetadataID $ComponentID status_failed)
    [[ $StatusFailed == null ]] && StatusFailed=Failed
    local MaxRetries=$(getMetadataID $ComponentID status_max_retries)
    [[ $MaxRetries == null ]] && MaxRetries=25
    MaxRetries=$(expr $MaxRetries \* 6)

    local ComponentName=$(getMetadataID $ComponentID description)
    [[ $ComponentName == null ]] && ComponentName=$(getMetadataID $ComponentID crd_description)
    [[ $ComponentName == null ]] && ComponentName=$(getMetadataID $ComponentID cr_comment)
    [[ $ComponentName == null ]] && ComponentName=$ResourceKind

    if [[ $ResourceKind != NotebookRuntime ]]; then
        local MaxCounter=60
        [[ $ComponentID == cpd_platform ]] && MaxCounter=180
        local Counter=1
        while true; do
            local ActualResourceName=$(oc get $ResourceKind --namespace $InstanceNS --no-headers 2> /dev/null | awk '{if($2!=Type) print $1}' Type=serviceInstance)
            [[ -z $ActualResourceName ]] || break
            [[ $Counter -eq $MaxCounter ]] && abort "Failed to get Actual Resource Name for $ResourceKind even after $(expr $MaxCounter / 6) mins"
            if [[ $(expr $Counter % 6) -eq 0 ]]; then
                [[ $MaxCounter -eq 60 || $Counter -gt 120 ]] && info "  Still waiting to get Actual Resource Name for $ResourceKind after $(expr $Counter / 6) mins ..." force
            fi
            (( Counter++ ))
            sleep 10
        done
        if [[ $(wc -w <<< $ActualResourceName) -gt 1 && $ResourceKind != rstudio ]]; then
            warning "Found multiple Custom Resource Names for $ResourceKind" force
            oc get $ResourceKind --sort-by=.metadata.creationTimestamp --namespace $InstanceNS
            ActualResourceName=$(oc get $ResourceKind --sort-by=.metadata.creationTimestamp --namespace $InstanceNS -o name | awk -F'/' '{print $2}' | tail -1)
        fi
        if [[ $ActualResourceName != $ResourceNames ]]; then
            if [[ $ResourceNames == null ]]; then
                warning "Replacing missing OLM Utils Resource Name with $ActualResourceName from cluster" force
            elif [[ $ResourceKind != rstudio ]]; then
                warning "Replacing OLM Utils Resource Name, $ResourceNames with $ActualResourceName from cluster" force
            fi
            ResourceNames=$ActualResourceName
        fi
    fi

    for ResourceName in $ResourceNames; do
        cat << EOF >> $LogFile

$(logCommand Checking $ComponentName)$(echo -e $(getColor Purple))
oc get $ResourceKind $ResourceName --namespace $InstanceNS --output jsonpath="{.status.$StatusField}"
$(echo -e $(getColor None))
EOF
        local FailedCount=0
        local Retry=1
        while true; do
            local ElapsedMins=$(expr $Retry / 6)
            local ResourceStatus=$(oc get $ResourceKind $ResourceName --namespace $InstanceNS --output jsonpath="{.status.$StatusField}" 2> /dev/null)
            if [[ $ResourceStatus == $StatusSuccess ]]; then
                [[ $ElapsedMins -eq 0 ]] && pass "  $ComponentName is ready" force || pass "  $ComponentName is ready after $ElapsedMins mins" force
                break
            elif [[ $ResourceStatus == $StatusFailed ]]; then
                [[ $FailedCount -gt 180 ]] && abort "Failed to deploy $ComponentName"
                if [[ $FailedCount -eq 0 ]]; then
                    debug "Ignoring Failed reported by $ResourceKind.$ResourceName.$StatusField. Normally would have aborted ..." force
                elif [[ $(expr $FailedCount % 6) -eq 0 ]]; then
                    debug "Ignoring Failed reported by $ResourceKind.$ResourceName.$StatusField after $(expr $FailedCount / 6) mins. Normally would have aborted ..." force
                else
                    debug "Ignoring Failed reported by $ResourceKind.$ResourceName.$StatusField. Normally would have aborted ..."
                fi
                ResourceStatus="In-Progress"
                (( FailedCount++ ))
            else
                FailedCount=0
            fi
            if [[ $Retry -eq 1 ]]; then
                info "  Waiting for $ComponentName to be ready" force
                debug "    oc get $ResourceKind $ResourceName --namespace $InstanceNS -o jsonpath='{.status.$StatusField}'" force
            fi
            [[ $Retry -gt $MaxRetries ]] && abort "Still waiting for $ComponentName to be running after $ElapsedMins mins"
            [[ $(expr $Retry % 30) -eq 0 ]] && info "  Still waiting for $ComponentName to be ready after $ElapsedMins mins" force
            (( Retry++ ))
            sleep 10
        done
    done
}

#*------------------------------------------------------------
#* Wait for all Related Components to be Ready
#*    1: Component ID
#*    2: Log File
#*------------------------------------------------------------

wait4AllRelatedComponents () {
    local ComponentID=$1
    local LogFile=$2
    local ParentComponentName=$(getMetadataID $ComponentID description)
    [[ $ParentComponentName == null ]] && ParentComponentName=$(getMetadataID $ComponentID crd_description)
    [[ $ParentComponentName == null ]] && ParentComponentName=$(getMetadataID $ComponentID cr_comment)
    [[ $ParentComponentName == null ]] && ParentComponentName=$ResourceKind
    info "Waiting for $ParentComponentName-related Custom Resources to be Ready" force
    sleep 120

    for DependentComponentID in $($run_utils list-prereqs --components=$ComponentID --release=$Release |\
                                  sed -e "s/.*: //" | tr -d "[,']"); do
        local ResourceKind=$(getMetadataID $ComponentID cr_kind)
        local ResourceName=$(getMetadataID $ComponentID cr_name)
        if [[ $ComponentID == wkc ]]; then
            if [[ $DependentComponentID == datastage_ent ]]; then
                [[ $(oc get $ResourceKind $ResourceName --namespace $InstanceNS -o jsonpath='{.spec.enableDataQuality}')       == true ]] || continue
            elif [[ "|opencontent_fdb|fdb_k8s|ibm_neo4j|" =~ "|$DependentComponentID|" ]]; then
                if [[ $(oc get $ResourceKind $ResourceName --namespace $InstanceNS -o jsonpath='{.spec.enableKnowledgeGraph}') == true ]]; then
                    ResourceKind=$(yq .global_components_meta.opencontent_fdb.cr_kind < $CX/data/global.yml)
                    if [[ -z $(oc get $ResourceKind --namespace $InstanceNS --output custom-columns='name:.metadata.name' --no-headers 2>/dev/null) ]]; then
                        [[ "|opencontent_fdb|fdb_k8s|" =~ "|$DependentComponentID|" ]] && continue
                    else
                        [[ $DependentComponentID == ibm_neo4j ]] && continue
                    fi
                else
                    continue
                fi
            fi
        fi
        if [[ $DependentComponentID == ws_runtimes ]]; then
            local ResourceKind=$(getMetadataID $DependentComponentID cr_kind)
            for ResourceName in $(oc get $ResourceKind --namespace $InstanceNS --output custom-columns='name:.metadata.name' --no-headers 2>/dev/null); do
                wait4Component $LogFile $DependentComponentID $ResourceKind $ResourceName
            done
        else
            wait4Component $LogFile $DependentComponentID
        fi
    done

    wait4Component $LogFile $ComponentID
}

#*------------------------------------------------------------
#* Deploy IBM Software Hub
#*------------------------------------------------------------

deploySoftwareHub () {
    local LogFile=$CX/log/Deploy.Software.Hub.$(date +%F_%H%M%S).log
    rm -f $LogFile
    prepareOLMutilities $LogFile

    log "  Checking OpenShift Cluster Configurations"
    local OperatorNS=$(jq --raw-output .namespace.operator $Config4ROSA)
    [[ $OperatorNS == null ]] && abort "Operator Namespace definition is missing in ROSA Configuration, $Config4ROSA"
    [[ -z $OperatorNS ]] && abort "Operator Namespace is missing in ROSA Configuration, $Config4ROSA"
    local InstanceNS=$(jq --raw-output .namespace.instance $Config4ROSA)
    [[ $InstanceNS == null ]] && abort "Instance Namespace definition is missing in ROSA Configuration, $Config4ROSA"
    [[ -z $InstanceNS ]] && abort "Instance Namespace is missing in ROSA Configuration, $Config4ROSA"
    local SchedulerNS=$(jq --raw-output .namespace.scheduler $Config4ROSA)
    [[ $SchedulerNS == null ]] && abort "IBM CPD Scheduler Namespace definition is missing in ROSA Configuration, $Config4ROSA"
    [[ -z $SchedulerNS ]] && abort "IBM CPD Scheduler Namespace is missing in ROSA Configuration, $Config4ROSA"
    local CertManagerNS=$(jq --raw-output .namespace.certManager $Config4ROSA)
    [[ $CertManagerNS == null ]] && abort "IBM Certificate Manager Namespace definition is missing in ROSA Configuration, $Config4ROSA"
    [[ -z $CertManagerNS ]] && abort "IBM Certificate Manager Namespace is missing in ROSA Configuration, $Config4ROSA"
    local LicensingNS=$(jq --raw-output .namespace.licensing $Config4ROSA)
    [[ $LicensingNS == null ]] && abort "IBM Licensing Namespace definition is missing in ROSA Configuration, $Config4ROSA"
    [[ -z $LicensingNS ]] && abort "IBM Licensing Namespace is missing in ROSA Configuration, $Config4ROSA"

    local FileStorageClass=$(jq --raw-output .storageClass.file $Config4ROSA)
    [[ $FileStorageClass == null ]] && abort "File Storage Class definition is missing in ROSA Configuration, $Config4ROSA"
    [[ -z $FileStorageClass ]] && abort "File Storage Class is missing in ROSA Configuration, $Config4ROSA"
    local BlockStorageClass=$(jq --raw-output .storageClass.block $Config4ROSA)
    [[ $BlockStorageClass == null ]] && abort "Block Storage Class definition is missing in ROSA Configuration, $Config4ROSA"
    [[ -z $BlockStorageClass ]] && abort "Block Storage Class is missing in ROSA Configuration, $Config4ROSA"

    local Outcome2Achieve="Configure IBM Certificate Manager and Licensing"
    local AnsibleLogFile=$CX/log/OLM.Configure.CertManager.Licensing.$(date +%F_%H%M%S).log
    cat << EOF >> $LogFile

$(logCommand $Outcome2Achieve)$(echo -e $(getColor Purple))
$run_utils apply-cluster-components \\
    --release=$Release \\
    --enable_licensing=true \\
    --cert_manager_ns=$CertManagerNS \\
    --licensing_ns=$LicensingNS \\
    --license_acceptance=true > $AnsibleLogFile
$(echo -e $(getColor None))
EOF
    info "  $Outcome2Achieve" force
    $run_utils apply-cluster-components \
        --release=$Release \
        --enable_licensing=true \
        --cert_manager_ns=$CertManagerNS \
        --licensing_ns=$LicensingNS \
        --license_acceptance=true > $AnsibleLogFile 2>&1 \
        && pass "  $Outcome2Achieve" force || abort "Failed to $Outcome2Achieve"
    cat << EOF >> $LogFile 2>&1
$(oc get pods --namespace $CertManagerNS)

$(oc get pods --namespace $LicensingNS | grep "NAME\|licensing")
EOF

# Failed to deploy IBM CPD Scheduler on Classic ROSA cluster OCP 4.18.16
if [[ skip == step ]]; then
    Outcome2Achieve="Configure IBM CPD Scheduler, $SchedulerNS"
    AnsibleLogFile=$CX/log/OLM.Configure.CPD.Scheduler.$(date +%F_%H%M%S).log
    cat << EOF >> $LogFile

$(logCommand $Outcome2Achieve)$(echo -e $(getColor Purple))
$run_utils apply-scheduler \\
    --release=$Release \\
    --scheduler_ns=$SchedulerNS \\
    --license_acceptance=true > $AnsibleLogFile
$(echo -e $(getColor None))
EOF
    info "  $Outcome2Achieve" force
    $run_utils apply-scheduler \
        --release=$Release \
        --scheduler_ns=$SchedulerNS \
        --license_acceptance=true > $AnsibleLogFile 2>&1 \
        && pass "  $Outcome2Achieve" force || abort "Failed to $Outcome2Achieve"
fi

    Outcome2Achieve="Authorize Instance Topology, $InstanceNS"
    AnsibleLogFile=$CX/log/OLM.Authorize.Instance.Topology.$InstanceNS.$(date +%F_%H%M%S).log
    cat << EOF >> $LogFile

$(logCommand $Outcome2Achieve)$(echo -e $(getColor Purple))
$run_utils authorize-instance-topology \\
    --cpd_operator_ns=$OperatorNS \\
    --cpd_instance_ns=$InstanceNS > $AnsibleLogFile
$(echo -e $(getColor None))
EOF
    info "  $Outcome2Achieve" force
    $run_utils authorize-instance-topology \
        --cpd_operator_ns=$OperatorNS \
        --cpd_instance_ns=$InstanceNS > $AnsibleLogFile 2>&1 \
        && pass "  $Outcome2Achieve" force || abort "Failed to $Outcome2Achieve"

    Outcome2Achieve="Setup IBM Software Hub, $InstanceNS"
    AnsibleLogFile=$CX/log/OLM.Setup.Software.Hub.$InstanceNS.$(date +%F_%H%M%S).log
    cat << EOF >> $LogFile

$(logCommand $Outcome2Achieve)$(echo -e $(getColor Purple))
$run_utils setup-instance \\
    --release=$Release \\
    --file_storage_class=$FileStorageClass \\
    --block_storage_class=$BlockStorageClass \\
    --cpd_operator_ns=$OperatorNS \\
    --cpd_instance_ns=$InstanceNS \\
    --license_acceptance=true > $AnsibleLogFile
$(echo -e $(getColor None))
EOF
    info "  $Outcome2Achieve" force
    $run_utils setup-instance \
        --release=$Release \
        --file_storage_class=$FileStorageClass \
        --block_storage_class=$BlockStorageClass \
        --cpd_operator_ns=$OperatorNS \
        --cpd_instance_ns=$InstanceNS \
        --license_acceptance=true > $AnsibleLogFile 2>&1 \
        && pass "  $Outcome2Achieve" force || abort "Failed to $Outcome2Achieve"

    wait4Component $LogFile cpd_platform
}

#*------------------------------------------------------------
#* Generate Db2U Product Config Map to grant unlimited privilege 
#*------------------------------------------------------------

generateDb2uProductConfigMap () {
    cat << EOF
apiVersion: v1
data:
  DB2U_RUN_WITH_LIMITED_PRIVS: "false"
kind: ConfigMap
metadata:
  name: db2u-product-cm
  namespace: $OperatorNS
EOF
}

#*------------------------------------------------------------
#* Configure Unlimited Privilege for Db2U
#*    1: Log File
#*------------------------------------------------------------

configureUnlimitedPrivilege4Db2U () {
    local LogFile=$1

    info "Checking OpenShift Cluster Instance Namespace definition" force
    local InstanceNS=$(jq --raw-output .namespace.instance $Config4ROSA)
    [[ $InstanceNS == null ]] && abort "Instance Namespace definition is missing in ROSA Configuration, $Config4ROSA"
    [[ -z $InstanceNS ]] && abort "Instance Namespace is missing in ROSA Configuration, $Config4ROSA"

    if [[ $(oc get ConfigMap db2u-product-cm --namespace $InstanceNS --output jsonpath='{.data}' 2>/dev/null |\
            jq --raw-output .DB2U_RUN_WITH_LIMITED_PRIVS) == false ]]; then
        pass "  Db2U is configured to run with unlimited privileges" force
    else
        local Outcome2Achieve="Configure Db2U to run with unlimited privileges"
        cat << EOS >> $LogFile

$(logCommand $Outcome2Achieve)$(echo -e $(getColor Purple))
    cat << EOF | oc apply -f -
$(generateDb2uProductConfigMap | yq --colors)
EOF
$(echo -e $(getColor None))
EOS
        info "  $Outcome2Achieve" force
        generateDb2uProductConfigMap | oc apply -f - >> $LogFile 2>&1 || abort "Failed to $Outcome2Achieve"
        pass "  $Outcome2Achieve" force
    fi
}

#*------------------------------------------------------------
#* Patch Db2-as-a-service
#*    1: Log File
#*------------------------------------------------------------

patchDb2 () {
    local LogFile=$1
    local Execute="oc exec --stdin=false --tty=false c-db2oltp-wkc-db2u-0 --namespace $InstanceNS -- su - db2inst1 -c"
    local Outcome2Achieve="for Db2U Cluster db2oltp-wkc to be ready"
    info "  Waiting $Outcome2Achieve" force
    local Counter=0
    unset ZenDatabaseCore Command2Execute
    while true; do
        (( Counter++ ))
        if [[ $(oc get db2uclusters db2oltp-wkc --namespace $InstanceNS --output custom-columns='name:.status.state' --no-headers 2>/dev/null) == Ready ]]; then
            if [[ -z $ZenDatabaseCore ]]; then
                ZenDatabaseCore=$(oc get pod --selector component=zen-database-core --namespace $InstanceNS \
                                             --output custom-columns='name:.metadata.name' --no-headers)
                Outcome2Achieve="for Zen Database Core to be ready"
            fi
            if [[ ! -z $ZenDatabaseCore && -z $Command2Execute ]]; then
                Command2Execute=$(oc logs $ZenDatabaseCore --namespace $InstanceNS |\
                                  grep "manage_databases --dblist" | tail -1 |\
                                  sed -e "s/.*command //;s/\".*//;s/--db-cfg-overrides /--db-cfg-overrides '/;s/$/'/")
                Outcome2Achieve="to extract command to create the remaining three databases"
            fi
            [[ -z $Command2Execute ]] || break
        fi
        [[ $Counter -eq 720 ]] && abort "Failed to wait $Outcome2Achieve even after $(expr $Counter / 6) mins"
        [[ $(expr $Counter % 60) -eq 0 ]] && info "  Still waiting $Outcome2Achieve after $(expr $Counter / 6) mins" force
        sleep 10
    done
    pass "  Extracted command to create the remaining three databases" force

    Outcome2Achieve="Current list of databases and aliases"
    cat << EOF >> $LogFile 2>&1
$(logCommand $Outcome2Achieve)$(echo -e $(getColor Purple))
$($Execute "manage_databases --show" 2>/dev/null)
$(echo -e $(getColor None))
EOF

    Outcome2Achieve="Create the remaining three databases"
    local Db2LogFile=$CX/log/Db2.Create.Databases.$InstanceNS.$(date +%F_%H%M%S).log
    cat << EOF >> $LogFile

$(logCommand $Outcome2Achieve)$(echo -e $(getColor Purple))
$Execute "$Command2Execute" > $Db2LogFile
$(echo -e $(getColor None))
EOF
    info "  $Outcome2Achieve" force
    $Execute "$Command2Execute" > $Db2LogFile 2>&1

    Outcome2Achieve="Current list of databases and aliases"
    Counter=0
    while true; do
        [[ $(expr $Counter % 6) -eq 0 ]] && cat << EOF >> $LogFile 2>&1
$(logCommand $Outcome2Achieve)$(echo -e $(getColor Purple))
$($Execute "manage_databases --show" 2>/dev/null)
$(echo -e $(getColor None))
EOF
        (( Counter++ ))
        [[ $($Execute "manage_databases --show" 2>/dev/null | grep ^Database | wc -l) -ne 8 ]] && continue
        pass "  All 4 Db2 databases and aliases created" force
        break
    done

    for Database in WF ILGDB BG; do
        Outcome2Achieve="Configure Database $Database"
        local ScriptFile="/db2uadm/${Database}-PostInstall.db2"
        Db2LogFile=$CX/log/Db2.Configure.$Database.$InstanceNS.$(date +%F_%H%M%S).log
        Counter=0
        while [[ -z $($Execute "ls $ScriptFile 2>/dev/null" 2>/dev/null) ]]; do
            (( Counter++ ))
            [[ $(expr $Counter % 6) -eq 0 ]] && info "  Still waiting for $ScriptFile after $(expr $Counter / 6) mins" force
            sleep 10
        done
        cat << EOF >> $LogFile

$(logCommand $Outcome2Achieve)$(echo -e $(getColor Purple))
$Execute "db2 -f $ScriptFile" > $Db2LogFile
$(echo -e $(getColor None))
EOF
        info "  $Outcome2Achieve" force
        $Execute "db2 -f $ScriptFile" > $Db2LogFile 2>&1
        [[ $(grep ^DB $Db2LogFile | awk '{print $1}' | sort -u | grep -v DB20000I | wc -l) -eq 0 ]] && pass "  $Outcome2Achieve" force || fail "  $Outcome2Achieve"
    done
}

#*------------------------------------------------------------
#* Add Resource Kind
#*    1: Resource Kind
#*------------------------------------------------------------

addResourceKind () {
    local ResourceKind=$1
    [[ $ResourceKind == null ]] && return
    [[ -z $ResourceKinds ]] && ResourceKinds=$ResourceKind || ResourceKinds+=",$ResourceKind"
}

#*------------------------------------------------------------
#* Check Custom Resources
#*    1: Component IDs
#*------------------------------------------------------------

checkCustomResources () {
    local ComponentIDs=$1
    local ResourceKinds=""
    for ComponentID in $(sed -e "s/,/ /g" <<< $ComponentIDs); do
        addResourceKind $(getMetadataID $ComponentID cr_kind)
        for DependentComponentID in $($run_utils list-prereqs --components=$ComponentID --release=$Release |\
                                      yq .$ComponentID | tr -d "[' ]" | sed -e "s/,/ /g") ; do
            addResourceKind $(getMetadataID $DependentComponentID cr_kind)
        done
    done
    sleep 60

    local CustomColumns="NAME:metadata.name"
    CustomColumns+=",VERSION:status.versions.reconciled"
    CustomColumns+=",START:metadata.creationTimestamp"
    CustomColumns+=",END:status.conditions[0].ansibleResult.completion"
    CustomColumns+=",PERCENT:status.progress"
    CustomColumns+=",MESSAGE:status.progressMessage"
    for ComponentID in $(sed -e "s/,/ /g" <<< $ComponentIDs); do
        local ResourceKind=$(getMetadataID $ComponentID cr_kind)
        local ResourceName=$(getMetadataID $ComponentID cr_name)
        local StatusField=$(getMetadataID $ComponentID status_field)
        local StatusSuccess=$(getMetadataID $ComponentID status_success)
        local Counter=0
        while true; do
            [[ $(oc get $ResourceKind $ResourceName --namespace $InstanceNS --output jsonpath="{.status.$StatusField}" 2>/dev/null) == $StatusSuccess || \
               -f $CX/data/Stop.Checking.Custom.Resources.$$ ]] && break
            (( Counter++ ))
            if [[ $(expr $Counter % 90) -eq 0 ]]; then
                info "  Still waiting for $ResourceKind $ResourceName status to be $StatusSuccess after $(expr $Counter / 6) mins ..." force
                echo 1>&2
                oc get $ResourceKinds --namespace $InstanceNS --output custom-columns=$CustomColumns 2>/dev/null
                echo 1>&2
            fi
            sleep 10
        done
    done
}

#*------------------------------------------------------------
#* Stop Checking Custom Resources
#*------------------------------------------------------------

stopCheckingCustomResources () {
    touch $CX/data/Stop.Checking.Custom.Resources.$$
    sleep 60
    rm -f $CX/data/Stop.Checking.Custom.Resources.$$
}

#*------------------------------------------------------------
#* Deploy Service
#*    1: Component ID
#*------------------------------------------------------------

deployService () {
    local ComponentID=$1
    local LogFile=$CX/log/Deploy.$DeployOption.$(date +%F_%H%M%S).log
    rm -f $LogFile
    prepareOLMutilities $LogFile

    info "Checking OpenShift Cluster Configurations" force
    local InstanceNS=$(jq --raw-output .namespace.instance $Config4ROSA)
    [[ $InstanceNS == null ]] && abort "Instance Namespace definition is missing in ROSA Configuration, $Config4ROSA"
    [[ -z $InstanceNS ]] && abort "Instance Namespace is missing in ROSA Configuration, $Config4ROSA"
    local OperatorNS=$(jq --raw-output .namespace.operator $Config4ROSA)
    [[ $OperatorNS == null ]] && abort "Operator Namespace definition is missing in ROSA Configuration, $Config4ROSA"
    [[ -z $OperatorNS ]] && abort "Operator Namespace is missing in ROSA Configuration, $Config4ROSA"

    local FileStorageClass=$(jq --raw-output .storageClass.file $Config4ROSA)
    [[ $FileStorageClass == null ]] && abort "File Storage Class definition is missing in ROSA Configuration, $Config4ROSA"
    [[ -z $FileStorageClass ]] && abort "File Storage Class is missing in ROSA Configuration, $Config4ROSA"
    local BlockStorageClass=$(jq --raw-output .storageClass.block $Config4ROSA)
    [[ $BlockStorageClass == null ]] && abort "Block Storage Class definition is missing in ROSA Configuration, $Config4ROSA"
    [[ -z $BlockStorageClass ]] && abort "Block Storage Class is missing in ROSA Configuration, $Config4ROSA"

    if [[ $DeployOption == IKC && $Release =~ 5.1. ]]; then
        local Db2FileStorageClass=$(jq --raw-output .storageClass.db2 $Config4ROSA)
        [[ $Db2FileStorageClass == null ]] && abort "Db2 File Storage Class definition is missing in ROSA Configuration, $Config4ROSA"
        [[ -z $Db2FileStorageClass ]] && abort "Db2 File Storage Class is missing in ROSA Configuration, $Config4ROSA"

        configureUnlimitedPrivilege4Db2U $LogFile
    fi

    local Outcome2Achieve="Create $DeployOption Catalog Source and Subscription in $OperatorNS namespace"
    AnsibleLogFile=$CX/log/OLM.Create.$DeployOption.Operator.$InstanceNS.$(date +%F_%H%M%S).log
    cat << EOF >> $LogFile

$(logCommand $Outcome2Achieve)$(echo -e $(getColor Purple))
$run_utils apply-olm \\
    --components=$ComponentID \\
    --release=$Release \\
    --cpd_operator_ns=$OperatorNS > $AnsibleLogFile
$(echo -e $(getColor None))
EOF
    info "  $Outcome2Achieve" force
    $run_utils apply-olm \
        --components=$ComponentID \
        --release=$Release \
        --cpd_operator_ns=$OperatorNS > $AnsibleLogFile 2>&1 \
        && pass "  $Outcome2Achieve" force || abort "Failed to $Outcome2Achieve"
 
    unset ParamFileOption
    local CustomSpecFile=$CX/work/CustomSpec.wkc.$(date +%F_%H%M%S).yaml
    local CustomSpecYAML="{}"
    if [[ $ComponentID == wkc ]]; then
        CustomSpecYAML=$(yq ".custom_spec.wkc.enableKnowledgeGraph=true" <<< $CustomSpecYAML)
        CustomSpecYAML=$(yq ".custom_spec.wkc.useFDB=true" <<< $CustomSpecYAML)
        if [[ $Release =~ 5.1. ]]; then
            CustomSpecYAML=$(yq ".custom_spec.wkc.wkc_db2u_restricted_mode=false" <<< $CustomSpecYAML)
            CustomSpecYAML=$(yq ".custom_spec.wkc.wkc_db2u_data_storage_class=\"$BlockStorageClass\"" <<< $CustomSpecYAML)
            CustomSpecYAML=$(yq ".custom_spec.wkc.wkc_db2u_meta_storage_class=\"$Db2FileStorageClass\"" <<< $CustomSpecYAML)
            CustomSpecYAML=$(yq ".custom_spec.wkc.wkc_db2u_backup_storage_class=\"$Db2FileStorageClass\"" <<< $CustomSpecYAML)
        fi
        yq <<< $CustomSpecYAML > $CustomSpecFile
        ParamFileOption+=" --param-file=/tmp/work/$(basename $CustomSpecFile)"
    fi

    Outcome2Achieve="Create $DeployOption Custom Resource in $InstanceNS namespace"
    AnsibleLogFile=$CX/log/OLM.Create.$DeployOption.Operands.$InstanceNS.$(date +%F_%H%M%S).log
    cat << EOF >> $LogFile

$(logCommand $Outcome2Achieve)$(echo -e $(getColor Purple))
$run_utils apply-cr \\
    --components=$ComponentID \\
    --release=$Release \\
    --file_storage_class=$FileStorageClass \\
    --block_storage_class=$BlockStorageClass \\
    --cpd_instance_ns=$InstanceNS \\
    --cpd_operator_ns=$OperatorNS \\
EOF
    [[ CustomSpecYAML == "{}" ]] || cat << EOF >> $LogFile
    --param-file=/tmp/work/$(basename $CustomSpecFile) \\
EOF
    cat << EOF >> $LogFile
    --license_acceptance=true > $AnsibleLogFile
$(echo -e $(getColor None))
EOF
    [[ -z $ParamFileOption ]] || cat << EOF >> $LogFile

$(logContent Custom Specification Parameters File, $CustomSpecFile)$(echo -e $(getColor Purple))
$(cat $CustomSpecFile | yq --colors)
$(jq --color-output . <<< $PatchJSON)$(echo -e $(getColor None))
EOF
    info "  $Outcome2Achieve" force
    [[ $DeployOption == IKC && $Release =~ 5.1. ]] && patchDb2 $LogFile &
    checkCustomResources $ComponentID &
    $run_utils apply-cr \
        --components=$ComponentID \
        --release=$Release \
        --file_storage_class=$FileStorageClass \
        --block_storage_class=$BlockStorageClass \
        --cpd_instance_ns=$InstanceNS \
        --cpd_operator_ns=$OperatorNS \
        $ParamFileOption \
        --license_acceptance=true > $AnsibleLogFile 2>&1
    local ExitCode=$?
    stopCheckingCustomResources
    [[ $ExitCode -eq 0 ]] || abort "Failed to $Outcome2Achieve"
    pass "  $Outcome2Achieve" force

    wait4AllRelatedComponents $ComponentID $LogFile
}

#*------------------------------------------------------------
#* Query CASE Version
#*    1: Component ID
#*------------------------------------------------------------

queryCaseVersion () {
    local ComponentID=$1

    unset CaseVersion
    ColorCase=normal

    local TargetCaseVersion=$(getReleaseMetadataID $ComponentID case_version)
    local CaseName=$(getMetadataID $ComponentID case_name)
    local CaseFolder=$CaseName
    [[ $ComponentID == postgresql ]] && CaseFolder=ibm-zen
    CaseVersion=$(ls "$CX/work/offline/$Release/.ibm-pak/data/cases/$CaseFolder/"*"/$CaseName"*.tgz 2>/dev/null |\
                  sed -n -e "s/^.*$CaseName-//;s/.tgz$//p" | tail -1)
    [[ -z $CaseVersion ]] && CaseVersion=$(ls "$CX/OLM/offline/$Release/.ibm-pak/data/cases/$CaseFolder/"*"/$CaseName"*.tgz 2>/dev/null |\
                                           sed -n -e "s/^.*$CaseName-//;s/.tgz$//p" | tail -1)
    [[ $CaseVersion =~ "+" ]] && CaseVersion=$(cut -d'+' -f1 <<< $CaseVersion)
    [[ $CaseVersion == $TargetCaseVersion ]] || ColorCase=red
}

#*------------------------------------------------------------
#* Query Operator Status
#*    1: Component ID
#*    2: Namespace
#*------------------------------------------------------------

queryOperatorStatus () {
    local ComponentID=$1
    local Namespace=$2

    unset ChannelCurrent VersionCSV OperatorStatus
    ColorChannel=normal
    ColorOperator=normal
    ColorCSV=normal

    local SubscriptionJSON=$(oc get Subscription --selector operators.coreos.com/$(getMetadataID $ComponentID pkg_name).$Namespace= \
                                                 --namespace $Namespace --output json 2> /dev/null)
    if [[ $ComponentID != postgresql ]]; then
        local SubscriptionName=$(getMetadataID $ComponentID sub_name)
        [[ $SubscriptionName == null ]] && SubscriptionName=$(getMetadataID $ComponentID operator_name)
        [[ $SubscriptionName == null ]] && SubscriptionName=$(getMetadataID $ComponentID pkg_name)
        SubscriptionJSON=$(oc get Subscription $SubscriptionName --namespace $Namespace --output json 2> /dev/null)
    fi
    local ChannelPlanned=$(getReleaseMetadataID $ComponentID sub_channel)
    ChannelCurrent=$(jq --raw-output .spec.channel <<< $SubscriptionJSON)
    [[ $ChannelPlanned == null || $ChannelCurrent == $ChannelPlanned ]] || ColorChannel=red
    local CurrentCSV=$(jq --raw-output .status.currentCSV <<< $SubscriptionJSON)
    local ClusterServiceVersionJSON=$(oc get ClusterServiceVersion $CurrentCSV --namespace $Namespace --output json 2>/dev/null)
    VersionCSV=$(jq --raw-output .spec.version <<< $ClusterServiceVersionJSON | cut -d '-' -f1)
    [[ $ComponentID == postgresql ]] && VersionCSV=$(cut -d '.' -f2- <<< $CurrentCSV | tr -d 'v')
    local PlannedCSV=$(getReleaseMetadataID $ComponentID csv_version)
    [[ $VersionCSV == $PlannedCSV ]] || ColorCSV=red
    OperatorStatus=$(jq --raw-output .status.phase <<< $ClusterServiceVersionJSON | cut -d '-' -f1)
    [[ $OperatorStatus == Succeeded ]] || ColorOperator=red
}

#*------------------------------------------------------------
#* Query Operand Status
#*    1: Component ID
#*    2: Namespace
#*------------------------------------------------------------

queryOperandStatus () {
    local ComponentID=$1
    local Namespace=$2

    unset ScaleConfig ResourceStatus SpecVersion ReconciledVersion
    ColorStatus=normal
    ColorOperand=normal
    ColorSpec=normal

    local ResourceKind=$(getMetadataID $ComponentID cr_kind)
    [[ $ResourceKind == null ]] && return 1
    local ResourceName=$(getMetadataID $ComponentID cr_name)
    [[ $ResourceName == null ]] && ResourceName=$(oc get $ResourceKind --namespace $Namespace --no-headers --output custom-columns=":metadata.name")
    [[ $ResourceName == null ]] && return 1
    local ResourceJSON=$(oc get $ResourceKind $ResourceName --namespace $Namespace --output json 2> /dev/null)

    local StatusField=$(getMetadataID $ComponentID status_field)
    [[ "|placeholderStatus|null|" =~ "|$StatusField|" ]] && return 1
    local StatusSuccess=$(getMetadataID $ComponentID status_success)
    [[ $StatusSuccess == null ]] && StatusSuccess=Completed
    ResourceStatus=$(jq --raw-output .status.$StatusField <<< $ResourceJSON)
    [[ $ResourceStatus == $StatusSuccess ]] || ColorStatus=red

    OperandVersion=$(getReleaseMetadataID $ComponentID cr_version) 
    SpecVersion=.spec.version
    [[ $ComponentID == opencontent_fdb ]] && SpecVersion=.spec.foundationdb_cluster_spec.version
    SpecVersion=$(jq --raw-output $SpecVersion <<< $ResourceJSON)
    [[ $SpecVersion == null ]] && unset SpecVersion
    VersionField=$(getMetadataID $ComponentID status_reconciled_version_field)
    case $ComponentID in
        datastage_ent)   VersionField=dsVersion;;
        dv)              VersionField=version;;
        mantaflow)       VersionField=version;;
        cpd_platform)    VersionField=version;;
    esac
    [[ $VersionField == null ]] && VersionField="versions.reconciled"
    ReconciledVersion=$(jq --raw-output .status.$VersionField <<< $ResourceJSON)
    [[ $ReconciledVersion == null ]] && unset ReconciledVersion
    [[ $ComponentID == db2aaservice ]] && ReconciledVersion=$(cut -d'+' -f1 <<< $ReconciledVersion)
    [[ $ComponentID == dmc ]] && ReconciledVersion=$OperandVersion
    if [[ $ComponentID != opencontent_fdb && $OperandVersion != null ]]; then
        [[ $ReconciledVersion == $OperandVersion ]] || ColorOperand=red
        [[ $SpecVersion       == $OperandVersion ]] || ColorSpec=red
    fi

    ScaleConfig=$(jq --raw-output .spec.scaleConfig <<< $ResourceJSON)
    if [[ $ScaleConfig == null ]]; then
        [[ $(jq --raw-output .spec.autoScaleConfig <<< $ResourceJSON) == true ]] && ScaleConfig=auto || unset ScaleConfig
    fi

    return 0
}

#*------------------------------------------------------------
#* Query Cluster Detail
#*------------------------------------------------------------

queryClusterDetail () {
    local LogFile=$CX/log/Query.Cluster.$(date +%F_%H%M%S).log
    rm -f $LogFile
    parseConfiguration Silently
    prepareOLMutilities $LogFile

    echo
    log "Query Cluster Detail\n"

    local ConsoleURL=$(oc get ConfigMap console-public --namespace openshift-config-managed --output jsonpath='{.data.consoleURL}' 2>/dev/null)
    local ProjectURL=$(oc get ZenService lite-cr --namespace $InstanceNS --ignore-not-found --output jsonpath='{.status.url}')
    [[ -z $ProjectURL ]] && ProjectURL=$(oc get route --no-headers --namespace $InstanceNS | awk '{if($1==Route) print $2}' Route=cpd)
    [[ -z $ProjectURL ]] || ProjectURL=https://$ProjectURL
    local AdminUsername AdminPassword
    local Retry=0
    while true; do
        if [[ -z $(oc get secret platform-auth-idp-credentials --namespace $InstanceNS --no-headers 2>/dev/null) ]]; then
            AdminUsername=admin
            AdminPassword=$(oc get secret admin-user-details --namespace $InstanceNS --output jsonpath='{.data.initial_admin_password}' 2>/dev/null | base64 --decode)
        else
            local AdminCredentialJSON=$(oc get secret platform-auth-idp-credentials --namespace $InstanceNS --output json 2>/dev/null | jq .data)
            AdminUsername=$(jq --raw-output .admin_username <<< $AdminCredentialJSON | base64 --decode)
            AdminPassword=$(jq --raw-output .admin_password <<< $AdminCredentialJSON | base64 --decode)
        fi
        [[ -z $AdminUsername || -z $AdminPassword ]] || break
        (( Retry++ ))
        [[ $Retry -eq 30 ]] && abort "Failed to get Admin credentials within 5 mins"
        sleep 10
    done

    local HostWidth=${#APIURL}
    [[ ! -z $ProjectURL && ${#ProjectURL} -gt $HostWidth ]] && HostWidth=${#ProjectURL}
    local UserWidth=${#UserName4OCP}
    [[ ! -z $ProjectURL && ${#AdminUsername} -gt $UserWidth ]] && UserWidth=${#AdminUsername}
    local PasswordWidth=${#WithPassword}
    [[ ! -z $ProjectURL && ${#AdminPassword} -gt $PasswordWidth ]] && PasswordWidth=${#AdminPassword}
    local Format="  %-33s  %-$(expr $HostWidth + 11)s  %-$(expr $UserWidth + 11)s  %-$(expr $PasswordWidth + 11)s\n"
    printf "$Format" "$(boldBlue Access Info)" $(boldBlue URL )             $(boldBlue User)             $(boldBlue Password)
    printf "$Format"  $(bold $(dashes 22))     $(bold $(dashes $HostWidth)) $(bold $(dashes $UserWidth)) $(bold $(dashes $PasswordWidth))
    [[ -z $ProjectURL ]] || printf "$Format" "$(bold Project Instance URL)" "$(normal $ProjectURL)" "$(normal $AdminUsername)" "$(normal $AdminPassword)"
    [[ -z $Token4REST ]] \
        && printf "$Format" "$(bold REST API URL)" "$(normal $URL4REST)" "$(normal $User4REST)" "$(normal $Password4REST)" \
        || printf "$Format" "$(bold REST API URL)" "$(normal $URL4REST)" "$(normal '<Token>')"
    printf "$Format" "$(bold OpenShift Console URL)" "$(normal $ConsoleURL)"
    echo

    local ValueWidth=$(expr $HostWidth + $UserWidth + $PasswordWidth - 11)
    Format="  %-48s  %-101s\n"
    GitFormat="  %-37s  %-$(expr $ValueWidth + 11)s\n"
    printf "$Format" $(boldBlue Configuration) $(boldBlue Value)
    printf "$Format" $(bold $(dashes 37))      $(bold $(dashes $ValueWidth))

    local ConfigurationValue=$(oc version | awk '/Server Version/{print $3}')
    ConfigurationValue+=" (Client: $(oc version | awk '/Client Version/{print $3}'),"
    ConfigurationValue+=" Kubernetes: $(oc version | awk '/Kubernetes Version/{print $3}'))"
    printf "$Format" "$(bold OpenShift Container Platform)" "$(normal $ConfigurationValue)"

    ConfigurationValue="File: $FileStorageClass"
    ConfigurationValue+=", Block: $BlockStorageClass"
    [[ $Release =~ 5.1. ]] && ConfigurationValue+=", Db2 File: $Db2FileStorageClass"
    printf "$Format" "$(bold OpenShift Persistent Storage Classes)" "$(normal $ConfigurationValue)"

    ConfigurationValue=$WorkerNodes
    case $(uname -m) in
        x86_64)  ConfigurationValue+=" Intel";;
        ppc64le) ConfigurationValue+=" Power";;
    esac
    ConfigurationValue+=" worker nodes"
    [[ -z $(oc get ConfigMap cluster-config-v1 --namespace kube-system --output jsonpath='{.data}' | grep -i fips) ]] || ConfigurationValue+=", FIPS encryption enabled"
    printf "$Format" "$(bold OpenShift Cluster Configuration)" "$(normal $ConfigurationValue)"

    if [[ -z $ProjectURL ]]; then
        echo
        return
    fi

    ConfigurationValue="Private Topology"
    [[ $(oc get ZenService lite-cr --namespace $InstanceNS -o jsonpath='{.spec.iamIntegration}' 2>/dev/null) == true ]] && ConfigurationValue+=", IAM integration enabled"
    [[ $(oc get configmap product-configmap --namespace $InstanceNS -o jsonpath='{.data.VAULT_ENABLED_STATUS}' 2>/dev/null) == true ]] && ConfigurationValue+=", Vault enabled"
    printf "$Format" "$(bold Project Instance Configuration)" "$(normal $ConfigurationValue)"

    ConfigurationValue="Instance: $InstanceNS"
    ConfigurationValue+=", Operator: $OperatorNS"
    printf "$Format" "$(bold Project Instance-related Namespaces)" "$(normal $ConfigurationValue)"

    ConfigurationValue="Scheduler: $SchedulerNS"
    ConfigurationValue+=", Cert Manager: $CertManagerNS"
    ConfigurationValue+=", Licensing: $LicensingNS"
    printf "$Format" "$(bold Cluster-wide Namespaces)" "$(normal $ConfigurationValue)"

    printf "$Format" "$(bold Cloud Pak for Data)" $(normal $Release)

    echo
    Format="  %-29s  %-17s  %-24s  %18.18s  %21.21s  %-21s  %19.19s  %23.23s  %18.18s\n"
    printf "$Format" "$(boldBlue CP4D Service)" $(boldBlue Scale)  "$(boldBlue CR Status)" $(boldBlue Version) $(boldBlue Reconciled) \
                                               "$(boldBlue OLM Status)" $(boldBlue Operator) $(boldBlue Channel)  $(boldBlue CASE)
    printf "$Format"  $(bold $(dashes 18))      $(bold $(dashes 6)) $(bold $(dashes 13))   $(bold $(dashes 7)) $(bold $(dashes 10)) \
                                                $(bold $(dashes 10))    $(bold $(dashes 8))  $(bold $(dashes 12)) $(bold $(dashes 7))
    for ComponentID in $(yq '.global_components_meta | keys' < $CX/data/global.yml | grep -v "^#" | sed '/^\s*$/d;s/- //'); do
        oc get Subscription $(yq .global_components_meta.$ComponentID.sub_name < $CX/data/global.yml) --namespace $OperatorNS > /dev/null 2>&1 || continue
        queryCaseVersion $ComponentID
        queryOperatorStatus $ComponentID $OperatorNS
        queryOperandStatus $ComponentID $InstanceNS
        printf "$Format" "$(bold $ComponentID)" "$(normal $ScaleConfig)" "$($ColorStatus $ResourceStatus)" "$($ColorSpec $SpecVersion)" "$($ColorOperand $ReconciledVersion)" \
                                                "$($ColorOperator $OperatorStatus)" "$($ColorCSV $VersionCSV)" "$($ColorChannel $ChannelCurrent)" "$($ColorCase $CaseVersion)"
    done

    if [[ ! -z $(oc get crd | awk -F '.' '{if($1!=WKC&&$2==WKC) print $1}' WKC=wkc |\
                 xargs -n 1 oc get --namespace $InstanceNS --no-headers 2>/dev/null) ]]; then
        echo
        Format="  %-26s  %-29s  %-17s  %-24s  %18.18s  %21.21s\n"
        printf "$Format" "$(boldBlue WKC Component)" "$(boldBlue Custom Resource)" $(boldBlue Scale)   $(boldBlue Status)   $(boldBlue Version) $(boldBlue Reconciled)
        printf "$Format"  $(bold $(dashes 15))        $(bold $(dashes 18))         $(bold $(dashes 6)) $(bold $(dashes 13)) $(bold $(dashes 7)) $(bold $(dashes 10))
        for Component in $(oc get crd | awk -F '.' '{if($1!=WKC&&$2==WKC) print $1}' WKC=wkc); do
            [[ "|dataquality|wkcgovui|" =~ "|$Component|" ]] && ComponentStatus=componentStatus || ComponentStatus=${Component}Status
            ComponentJSON=$(oc get $Component --namespace $InstanceNS --output json |\
                            jq --compact-output ".items[] | {name: .metadata.name,
                                                             version: .spec.version,
                                                             scale: .spec.scaleConfig,
                                                             status: .status,
                                                             reconciled: .status.versions.reconciled}")
            [[ -z $ComponentJSON ]] && continue
            local Scale=$(jq --raw-output .scale <<< $ComponentJSON)
            [[ $Scale == null ]] && unset Scale
            local StatusWKC=$(jq --raw-output --arg Status $ComponentStatus '.status | .[$Status]' <<< $ComponentJSON)
            local StatusColor=normal
            [[ $StatusWKC == Completed ]] || StatusColor=red
            printf "$Format" "$(bold $Component)" "$(bold   $(jq --raw-output .name       <<< $ComponentJSON))" \
                                                  "$(normal $Scale)" "$($StatusColor $StatusWKC)" \
                                                  "$(normal $(jq --raw-output .version    <<< $ComponentJSON))" \
                                                  "$(normal $(jq --raw-output .reconciled <<< $ComponentJSON))"
        done
    fi

    if [[ ! -z $(oc get neo4j --namespace $InstanceNS 2>/dev/null) ]]; then
        echo
        Format="  %-29s  %-20s  %18.18s  %21.21s\n"
        printf "$Format" "$(boldBlue Neo4J Cluster)" $(boldBlue Status)  $(boldBlue Version) $(boldBlue Reconciled)
        printf "$Format"  $(bold $(dashes 18))       $(bold $(dashes 9)) $(bold $(dashes 7)) $(bold $(dashes 10))
        for Neo4jJSON in $(oc get neo4j --namespace $InstanceNS --output json |\
                           jq --compact-output '.items[] | {name: .metadata.name,
                                                            status: .status.neo4jStatus,
                                                            current: .status.versions.current,
                                                            reconciled: .status.versions.reconciled}'); do
            local NameNeo4j=$(jq --raw-output .name <<< $Neo4jJSON)
            local StatusNeo4j=$(jq --raw-output .status <<< $Neo4jJSON)
            local StatusColor=normal
            [[ $StatusNeo4j == Completed ]] || StatusColor=red
            printf "$Format" "$(bold $NameNeo4j)" "$($StatusColor $StatusNeo4j)" \
                             "$(normal $(jq --raw-output .current    <<< $Neo4jJSON))" \
                             "$(normal $(jq --raw-output .reconciled <<< $Neo4jJSON))"
        done
    fi

    if [[ ! -z $(oc get cluster.postgresql --namespace $InstanceNS 2>/dev/null) ]]; then
        echo
        Format="  %-48s  %-35s\n"
        printf "$Format" "$(boldBlue Postgres Cluster)" $(boldBlue Status)
        printf "$Format"  $(bold $(dashes 37))          $(bold $(dashes 24))
        for PostgresClusterJSON in $(oc get cluster.postgresql --namespace $InstanceNS --output json |\
                             jq --compact-output '.items[] | {name: .metadata.name,
                                                              status: .status.phase}' | tr ' ' '#'); do
            local NamePostgreSQL=$(jq --raw-output .name <<< $PostgresClusterJSON | tr '#' ' ')
            local StatusPostgreSQL=$(jq --raw-output .status <<< $PostgresClusterJSON | tr '#' ' ')
            local StatusColor=normal
            [[ $StatusPostgreSQL == "Cluster in healthy state" ]] || StatusColor=red
            printf "$Format" "$(bold $NamePostgreSQL)" "$($StatusColor $StatusPostgreSQL)"
        done
    fi

    [[ $Release =~ 5.1. ]] || return
    if [[ ! -z $(oc get db2ucluster --namespace $InstanceNS 2>/dev/null) ]]; then
        echo
        Format="  %-23s  %-20s\n"
        printf "$Format" "$(boldBlue Db2U Cluster)" $(boldBlue Status)
        printf "$Format"  $(bold $(dashes 12))      $(bold $(dashes 9))
        for Db2uClusterJSON in $(oc get db2ucluster --namespace $InstanceNS --output json |\
                             jq --compact-output '.items[] | {name: .metadata.name, status: .status.state}'); do
            local StatusDb2U=$(jq --raw-output .status <<< $Db2uClusterJSON)
            local StatusColor=normal
            [[ $StatusDb2U == Ready ]] || StatusColor=red
            printf "$Format" "$(bold $(jq --raw-output .name <<< $Db2uClusterJSON))" "$($StatusColor $StatusDb2U)"
        done
    fi
    echo
}

#*------------------------------------------------------------
#* Delete Namespace
#*    1: Namespace ID
#*    2: Namespace
#*------------------------------------------------------------

deleteNamespace () {
    local NamespaceID=$1
    local Namespace=$2

    local DeleteProjectNamespace=$CX/tools/delete-cpd-namespace.sh
    if [[ ! -f $DeleteProjectNamespace ]]; then
        curl https://raw.githubusercontent.com/IBM/cpd-cli/refs/heads/master/cpdops/files/delete-cpd-namespace.sh 2> /dev/null |\
            sed -e "s/read -p.*/REPLY=Y/;s/retry_delay=5/retry_delay=30/" > $DeleteProjectNamespace
        chmod 755 $DeleteProjectNamespace
    fi

    local Outcome2Achieve="Delete ${NamespaceID^} Namespace, $Namespace"
    local DeleteLogFile=$CX/log/Delete.Namespace.$Namespace.$(date +%F_%H%M%S).log
    cat << EOF >> $LogFile

$(logCommand $Outcome2Achieve)$(echo -e $(getColor Purple))
$DeleteProjectNamespace $Namespace > $DeleteLogFile
$(echo -e $(getColor None))
EOF
    info "  $Outcome2Achieve" force
    $DeleteProjectNamespace $Namespace > $DeleteLogFile 2>&1 || abort "Failed to $Outcome2Achieve"
}

#*------------------------------------------------------------
#* Purge existing Deployment
#*------------------------------------------------------------

purgeDeployment () {
    log "Purge existing Deployment"
    LogFile=$CX/log/Purge.Existing.Deployment.$(date +%F_%H%M%S).log
    rm -f $LogFile

    prepareOLMutilities $LogFile

    local SchedulerNS=$(jq --raw-output .namespace.scheduler $Config4ROSA)
    [[ $SchedulerNS == null ]] && abort "IBM CPD Scheduler Namespace definition is missing in ROSA Configuration, $Config4ROSA"
    [[ -z $SchedulerNS ]] && abort "IBM CPD Scheduler Namespace is missing in ROSA Configuration, $Config4ROSA"

    if [[ ! -z $(oc project $SchedulerNS 2>/dev/null) ]]; then
        [[ -z $(oc get Scheduling ibm-cpd-scheduler --namespace $SchedulerNS 2>/dev/null) ]] || \
            abortOnFail "Delete IBM CPD Scheduler Custom Resource" \
                        "oc delete Scheduling ibm-cpd-scheduler --namespace $SchedulerNS"
        [[ -z $(oc get CustomResourceDefinition scheduling.scheduler.spectrumcomputing.ibm.com 2>/dev/null) ]] || \
            abortOnFail "Delete IBM CPD Scheduler Custom Resource Definition" \
                        "oc delete CustomResourceDefinition scheduling.scheduler.spectrumcomputing.ibm.com"
        for NamespaceID in $(jq --raw-output '.namespace | keys_unsorted | .[]' $Config4ROSA); do
            local Namespace=$(jq --raw-output --arg ID $NamespaceID '.namespace | .[$ID]' $Config4ROSA)
            oc project $Namespace >/dev/null 2>&1 || continue
            oc get pods --namespace $Namespace --no-headers | while read Pod Ready Status Misc; do
                if [[ $(oc get pod $Pod --namespace $Namespace --output jsonpath='{.spec.schedulerName}') == ibm-cpd-scheduler && \
                      $Status == Pending ]]; then
                    abortOnFail "Delete pending pod $Pod in namespace $Namespace" "oc delete pod $Pod --namespace $Namespace"
                fi
            done
        done
        deleteNamespace scheduler $SchedulerNS
    fi

    for NamespaceID in $(jq --raw-output '.namespace | keys_unsorted | .[]' $Config4ROSA); do
        local Namespace=$(jq --raw-output --arg ID $NamespaceID '.namespace | .[$ID]' $Config4ROSA)
        oc project $Namespace >/dev/null 2>&1 || continue
        deleteNamespace $NamespaceID $Namespace
    done

    for ExistingContainerOLM in $(podman ps | awk '/olm-utils-play/{print $NF}'); do
        abortOnFail "Terminate running OLM Utility, $ExistingContainerOLM" "podman rm --force $ExistingContainerOLM" Silently
    done
    for ImageID in $(podman images | awk '/olm-utils/{print $3}'); do
        abortOnFail "Delete existing OLM Utility Image with ID, $ImageID" "podman rmi --force $ImageID" Silently
    done
    [[ -d $CX/CPD ]] && abortOnFail "Delete CPD CLI" "rm -rf $CX/CPD" Silently

    pass "Purged existing Deployment" force
}

#*------------------------------------------------------------
#* Init BAR
#* https://www.ibm.com/docs/en/software-hub/5.1.x?topic=utility-offline-backup-restore-same-cluster
#*------------------------------------------------------------

initBAR () {
    LogFile=$CX/log/Execute.BAR.$(date +%F_%H%M%S).log
    info "Track progress via log file $(basename $LogFile)" force
    parseConfiguration Silently
    prepareOLMutilities $LogFile

    log "  Checking Archive Configurations"
    if [[ $(jq --raw-output .archive $Config4ROSA) == null ]]; then
        local OldConfig4ROSA=$(sed -s "s/json/$(date +"%Y%m%d%H%M").json/" <<< $Config4ROSA)
        debug "Saving current configuration as $OldConfig4ROSA" force
        cp $Config4ROSA $OldConfig4ROSA
        jq --arg ArchiveSuffix $(hostname -f | awk -F'.' '{print $1}') \
           '.archive += {"suffix":                  $ArchiveSuffix,
                         "data-protection-plan": {
                           "backup":                "service-orchestration",
                           "restore":               "cpd-offline-tenant/restore-service-orchestrated-parent-workflow"
                         },
                         "reporting-interval":      15,
                         "image-prefix":            "registry.redhat.io/ubi9",
                         "vol-mnt-pod-mem-request": "1Gi",
                         "vol-mnt-pod-mem-limit":   "4Gi"}' $OldConfig4ROSA > $Config4ROSA
        abort "Please update the ROSA Archive Configuration, $Config4ROSA, if needed, before attempting the same command again"
    fi

    ArchiveSuffix=$(jq --raw-output .archive.suffix $Config4ROSA)
    [[ $ArchiveSuffix == null ]] && abort "Archive Suffix definition is missing in ROSA Configuration, $Config4ROSA"
    if [[ -z $ArchiveSuffix ]]; then
        abort "Archive Suffix is missing in ROSA Configuration, $Config4ROSA"
    else
        [[ $ArchiveID =~ -$ArchiveSuffix$ ]] || ArchiveID+="-$ArchiveSuffix"
        [[ $_Action == executeRestore && ! $RestoreID+ =~ -$ArchiveID$ ]] && RestoreID+="-$ArchiveID"
    fi
    OperatorNS=$(jq --raw-output .namespace.operator $Config4ROSA)
    [[ $OperatorNS == null ]] && abort "Operator Namespace definition is missing in ROSA Configuration, $Config4ROSA"
    [[ -z $OperatorNS ]] && abort "Operator Namespace is missing in ROSA Configuration, $Config4ROSA"
    InstanceNS=$(jq --raw-output .namespace.instance $Config4ROSA)
    [[ $InstanceNS == null ]] && abort "Instance Namespace definition is missing in ROSA Configuration, $Config4ROSA"
    [[ -z $InstanceNS ]] && abort "Instance Namespace is missing in ROSA Configuration, $Config4ROSA"
    OadpNS=$(jq --raw-output .namespace.oadp $Config4ROSA)
    [[ -z $OadpNS ]] && abort "OADP Namespace is missing in ROSA Configuration, $Config4ROSA"
    BackupPlan=$(jq --raw-output '.archive | .["data-protection-plan"] | .backup' $Config4ROSA)
    [[ $BackupPlan == null ]] && abort "Backup Data Protection Plan definition is missing in ROSA Configuration, $Config4ROSA"
    RestorePlan=$(jq --raw-output '.archive | .["data-protection-plan"] | .restore' $Config4ROSA)
    [[ $RestorePlan == null ]] && abort "Restore Data Protection Plan definition is missing in ROSA Configuration, $Config4ROSA"
    ReportingInterval=$(jq --raw-output '.archive | .["reporting-interval"]' $Config4ROSA)
    [[ $ReportingInterval == null ]] && abort "Reporting Interval definition is missing in ROSA Configuration, $Config4ROSA"
    ImagePrefix=$(jq --raw-output '.archive | .["image-prefix"]' $Config4ROSA)
    [[ $ImagePrefix == null ]] && abort "Image Prefix definition is missing in ROSA Configuration, $Config4ROSA"
    VolumeMountPodMemoryRequest=$(jq --raw-output '.archive | .["vol-mnt-pod-mem-request"]' $Config4ROSA)
    [[ $VolumeMountPodMemoryRequest == null ]] && abort "Volume Mount Pod memory Request definition is missing in ROSA Configuration, $Config4ROSA"
    VolumeMountPodMemoryLimit=$(jq --raw-output '.archive | .["vol-mnt-pod-mem-limit"]' $Config4ROSA)
    [[ $VolumeMountPodMemoryLimit == null ]] && abort "Volume Mount Pod memory Limit definition is missing in ROSA Configuration, $Config4ROSA"
}

#*------------------------------------------------------------
#* Check Registry for Platform Backup and Restore Support
#*    1: Skip Init BAR
#*------------------------------------------------------------

checkRegistry () {
    local SkipInitBAR=$1
    log "Check if all deployed services support platform backup and restore"
    [[ -z $SkipInitBAR ]] && initBAR
    local Outcome2Achieve="Check if all deployed services support platform backup and restore"
    local CheckRegistryLogFile=$CX/log/OADP.Check.Service.Registry.$(date +%F_%H%M%S).log
    local Command2Execute="cpd-cli oadp service-registry check"
    cat << EOF >> $LogFile

$(logCommand $Outcome2Achieve)$(echo -e $(getColor Purple))
cpd-cli oadp service-registry check \\
EOF
    Command2Execute+=" --tenant-operator-namespace $OperatorNS"
    if [[ $_LoggingMode == --verbose ]]; then
        Command2Execute+=" --log-level=debug --verbose"
        cat << EOF >> $LogFile
  --tenant-operator-namespace $OperatorNS \\
  --log-level=debug \\
  --verbose > $CheckRegistryLogFile
$(echo -e $(getColor None))
EOF
    else
        cat << EOF >> $LogFile
  --tenant-operator-namespace $OperatorNS > $CheckRegistryLogFile
$(echo -e $(getColor None))
EOF
    fi
    info "  $Outcome2Achieve" force
    info "  Track progress via log file $(basename $CheckRegistryLogFile)" force
    $Command2Execute > $CheckRegistryLogFile 2>&1 || abort "$Outcome2Achieve. Check https://www.ibm.com/docs/en/software-hub/5.1.x?topic=hub-services-that-support-backup-restore for services that support platform backup and restore"
    pass "  $Outcome2Achieve" force
}

#*------------------------------------------------------------
#* Estimate Backup Size
#*    1: Skip Init BAR
#*------------------------------------------------------------

estimateSize () {
    local SkipInitBAR=$1
    local Outcome2Achieve="Estimate Backup Size"
    log "$Outcome2Achieve"
    [[ -z $SkipInitBAR ]] && initBAR
    for NamespaceType in cpdops-namespace cpd-namespace; do
        if [[ -z $(cpd-cli oadp client config get --namespace $OadpNS 2>/dev/null |\
                   awk -F': ' '{if($1==Type) print $NF}' Type=$NamespaceType) ]]; then
            local Namespace=$OperatorNS
            [[ $NamespaceType == cpd-namespace ]] && Namespace=$InstanceNS
            abortOnFail "Set OADP Client Config $NamespaceType to $Namespace" \
                        "cpd-cli oadp client config set $NamespaceType=$Namespace" Silently
        fi
    done
    if [[ -z $(oc get DaemonSet cpdbr-agent --namespace $OadpNS 2>/dev/null) ]]; then
        Outcome2Achieve="Install CPD BR Agent"
        cat << EOF >> $LogFile

$(logCommand $Outcome2Achieve)$(echo -e $(getColor Purple))
cpd-cli oadp install --component=cpdbr-agent \\
  --namespace=$OadpNS \\
  --cpd-namespace=$InstanceNS
$(echo -e $(getColor None))
EOF
        info "  $Outcome2Achieve" force
        cpd-cli oadp install --component=cpdbr-agent \
          --namespace=$OadpNS \
          --cpd-namespace=$InstanceNS >> $LogFile 2>&1 || abort "$Outcome2Achieve"
        pass "  $Outcome2Achieve" force
    fi

    Outcome2Achieve="Estimate Backup Size"
    local EstimateSizeLogFile=$CX/log/OADP.Estimage.Backup.Size.$(date +%F_%H%M%S).log
    cat << EOF >> $LogFile

$(logCommand $Outcome2Achieve)$(echo -e $(getColor Purple))
export CPDBR_ENABLE_FEATURES=volume-util
cpd-cli oadp du-pv > $EstimateSizeLogFile
$(echo -e $(getColor None))
EOF
    info "  $Outcome2Achieve" force
    info "  Track progress via log file $(basename $EstimateSizeLogFile)" force
    export CPDBR_ENABLE_FEATURES=volume-util
    cpd-cli oadp du-pv > $EstimateSizeLogFile 2>&1 || abort "$Outcome2Achieve"
    pass "  $Outcome2Achieve: $(awk '/Total estimated volume usage size/{print $NF}' $EstimateSizeLogFile)" force
}

#*------------------------------------------------------------
#* Query Backups from S3 ObjectStore
#*    1: Archive Suffix
#*------------------------------------------------------------

queryBackups () {
    echo $(blue NAME MODE ORCHESTRATION RESOLVED_NAMESPACES STATUS ERRORS WARNINGS START_TIME END_TIME)
    while IFS= read -r Backup; do
        [[ ! -z $AllBackups || -z $ArchiveSuffix || $(awk '{print $1}' <<< $Backup) =~ -$ArchiveSuffix$ ]] || continue
        echo $(purple "$(cut -f1-7 <<< $Backup) $(awk -F' ' '{print $8"#"$9"#"$10}' <<< $Backup) $(awk -F' ' '{print $11"#"$12"#"$13}' <<< $Backup)")
    done < <(cpd-cli oadp tenant-backup list | grep -v NAME)
}

#*------------------------------------------------------------
#* List of Backups matching Archive suffix in S3 Object Store
#*    1: Skip Init BAR
#*------------------------------------------------------------

listBackups () {
    local SkipInitBAR=$1
    [[ -z $AllBackups ]] && log "List of Backups matching Archive suffix in S3 Object Store" \
                         || log "List all Backups in S3 Object Store"
    [[ -z $SkipInitBAR ]] && initBAR
    [[ -z $AllBackups ]] && info "  List of Backups matching Archive suffix, $ArchiveSuffix, in S3 Object Store" force
    echo 
    queryBackups | column -t | sed -e "s/#/ /g"
    echo
}

#*------------------------------------------------------------
#* Check Backup Restore Status
#*------------------------------------------------------------

checkStatus4BAR () {
    local StopCheckingStatusFile=$StopCheckingBackupStatusFile
    local TenantAction=tenant-backup
    local ID=$ArchiveID
    local DataProtectionPlan=$BackupPlan
    if [[ $_Action == executeRestore ]]; then
        StopCheckingStatusFile=$StopCheckingRestoreStatusFile
        TenantAction=tenant-restore
        ID=$RestoreID
        DataProtectionPlan=$RestorePlan
    fi
    local Counter=0
    (( ReportingInterval*=6 ))
    while true; do
        (( Counter++ ))
        if [[ $(expr $Counter % $ReportingInterval) -eq 0 || -f $StopCheckingStatusFile ]]; then
            echo 
            info "  $(sed -e "s/Create/Status of/;s/Restore/Status of Restore/" <<< $Outcome2Achieve)" force
            cpd-cli oadp $TenantAction status $ID --details |\
                awk "/^Plan:/{flag=1} /^Undo Plan:/{flag=0} flag" |\
                awk '{if($1==Name) print $3"|"$5"|"$6"|"$7"_"$8"_"$9"|"$10"_"$11"_"$12}' Name=$DataProtectionPlan |\
                awk 'BEGIN {print "Action|Phase|Error|Started|Completed"} { print }' |\
                tr "|" " " | column -t | tr "_" " " | sed -e "s/- -//g;s/- Name:.*//g"
            echo 
        fi
        [[ -f $StopCheckingStatusFile ]] && break
        sleep 10
    done
    rm -f $StopCheckingStatusFile
}

#*------------------------------------------------------------
#* Status of specified Backup from S3 Object Store
#*    1: Skip Init BAR
#*------------------------------------------------------------

statusBackup () {
    local SkipInitBAR=$1
    log "Query Status of Backup $ArchiveID from S3 Object Store"
    if [[ -z $SkipInitBAR ]]; then
        initBAR
        echo -e -n "\n  $(blue Archive): $(purple $ArchiveID)\n  $(blue Status):  $(getColor Purple)"
    fi
    cpd-cli oadp tenant-backup status $ArchiveID 2>/dev/null | grep "^Status:" | cut -f2
    [[ -z $SkipInitBAR ]] && echo -e $(getColor None)
}

#*------------------------------------------------------------
#* Confirm Operation
#*    1: Action Name
#*------------------------------------------------------------

confirmOperation () {
    local ActionName=$1
    if [[ -z $BypassConfirmation ]]; then
        cat << EOF

You could specify [$(option --yes)] option to bypass this confirmation request.

Do you want to $ActionName? Please confirm (Y/N)
EOF
        unset Response
        while [[ ! "|Y|y|N|n|" =~ "|$Response|" ]]; do
            read Response
            [[ "|N|n|" =~ "|$Response|" ]] && abort "$ActionName"
            [[ "|Y|y|" =~ "|$Response|" ]] && break
            echo "Valid response is either Y or N"
        done
    fi
}

#*------------------------------------------------------------
#* Erase OADP Backup from S3 Object Store
#*    1: Skip Init BAR
#*------------------------------------------------------------

eraseBackup () {
    local SkipInitBAR=$1
    log "Erase OADP Backup $ArchiveID from S3 Object Store"
    [[ -z $SkipInitBAR ]] && initBAR
    if [[ -z $(cpd-cli oadp tenant-backup status $ArchiveID 2>&1 | grep "Error: status not found for") ]]; then
        local Outcome2Achieve="Delete OADP backup $ArchiveID from S3 Object Store"
        confirmOperation "$Outcome2Achieve"
        cat << EOF >> $LogFile

$(logCommand $Outcome2Achieve)$(echo -e $(getColor Purple))
cpd-cli oadp tenant-backup delete $ArchiveID > $LogFile
$(echo -e $(getColor None))
EOF
        info "  $Outcome2Achieve" force
        cpd-cli oadp tenant-backup delete $ArchiveID >> $LogFile 2>&1 || abort "Failed to $Outcome2Achieve"
        local Counter=1
        while true; do
            [[ -z $(cpd-cli oadp tenant-backup list | awk '{if($1==ID) print $4}' ID=$ArchiveID) ]] && break
            [[ $Counter -eq 180 ]] && abort "Still waiting for $ArchiveID to be deleted even after $(expr $Counter / 6) mins"
            [[ $(expr $Counter % 12) -eq 0 ]] && info "  Still waiting for $ArchiveID to be deleted after $(expr $Counter / 6) mins" force
            (( Counter++ ))
            sleep 10
        done
        pass "  $Outcome2Achieve" force
    fi
}

#*------------------------------------------------------------
#* Wait for all Custom Resources
#*    1: Maintenance Mode OK
#*------------------------------------------------------------

wait4AllCRs () {
    local MaintenanceModeOK=$1
    local StatusOK="in Completed"
    [[ -z $MaintenanceModeOK ]] || StatusOK="either in Completed or Maintenance"
    info "Sleep 2 mins before waiting for all existing Custom Resources to be $StatusOK state" force
    sleep 120
    for ComponentID in $(yq ".global_components_meta | keys" < $CX/data/global.yml | grep -v "^#" | sed '/^\s*$/d;s/- //'); do
        local ResourceKind=$(getMetadataID $ComponentID cr_kind)
        [[ $ResourceKind == null ]] && continue
        local ComponentName=$(getMetadataID $ComponentID description)
        [[ $ComponentName == null ]] && ComponentName="$ComponentID"
        local StatusField=$(getMetadataID $ComponentID status_field)
        [[ "|placeholderStatus|null|" =~ "|$StatusField|" ]] && continue
        local StatusSuccess=$(getMetadataID $ComponentID status_success)
        [[ $StatusSuccess == null ]] && StatusSuccess=Completed
        local StatusFailed=$(getMetadataID $ComponentID status_failed)
        [[ $StatusFailed == null ]] && StatusFailed=Failed
        local MaxRetries=$(getMetadataID $ComponentID status_max_retries)
        [[ $MaxRetries == null ]] && MaxRetries=25
        MaxRetries=$(expr $MaxRetries \* 6)
        for ResourceName in $(oc get $ResourceKind --namespace $InstanceNS --no-headers 2> /dev/null |\
                              awk '{if($2!=Type) print $1}' Type=serviceInstance); do
            cat << EOF >> $LogFile

$(logCommand Check $ComponentName)$(echo -e $(getColor Purple))
oc get $ResourceKind $ResourceName --namespace $InstanceNS --output jsonpath="{.status.$StatusField}"
$(echo -e $(getColor None))
EOF
            local FailedCount=0
            local Retry=0
            while true; do
                (( Retry++ ))
                local ElapsedMins=$(expr $Retry / 6)
                local ResourceStatus=$(oc get $ResourceKind $ResourceName --namespace $InstanceNS --output jsonpath="{.status.$StatusField}" 2> /dev/null)
                if [[ $ResourceStatus == $StatusSuccess ]]; then
                    [[ $ElapsedMins -eq 0 ]] && pass "  $ComponentName is in $StatusSuccess state" force \
                                             || pass "  $ComponentName is in $StatusSuccess state after $ElapsedMins mins" force
                    break
                elif [[ ! -z $MaintenanceModeOK && $ResourceStatus == InMaintenance ]]; then
                    [[ $ElapsedMins -eq 0 ]] && pass "  $ComponentName is in Maintenance mode" force \
                                             || pass "  $ComponentName is in Maintenance mode after $ElapsedMins mins" force
                    break
                elif [[ $ResourceStatus == $StatusFailed ]]; then
                    [[ $FailedCount -gt 180 ]] && abort "Failed to wait for $ComponentName"
                    if [[ $FailedCount -eq 0 ]]; then
                        debug "Ignoring Failed reported by $ResourceKind.$ResourceName.$StatusField. Normally would have aborted ..." force
                    elif [[ $(expr $FailedCount % 6) -eq 0 ]]; then
                        debug "Ignoring Failed reported by $ResourceKind.$ResourceName.$StatusField after $(expr $FailedCount / 6) mins. Normally would have aborted ..." force
                    else
                        debug "Ignoring Failed reported by $ResourceKind.$ResourceName.$StatusField. Normally would have aborted ..."
                    fi
                    ResourceStatus="In-Progress"
                    (( FailedCount++ ))
                else
                    FailedCount=0
                fi
                if [[ $Retry -eq 1 ]]; then
                    info "  Waiting for $ComponentName to be $StatusOK state" force
                    debug "    oc get $ResourceKind $ResourceName --namespace $InstanceNS --output jsonpath='{.status.$StatusField}'" force
                fi
                [[ $(expr $Retry % 30) -eq 0 ]] && info "  Still waiting for $ComponentName to be $StatusOK state after $ElapsedMins mins" force
                sleep 10
                [[ $Retry -ge $MaxRetries ]] && abort "Still waiting for $ComponentName to be $StatusOK state after $ElapsedMins mins"
            done
        done
    done
}

#*------------------------------------------------------------
#* Execute OADP Backup
#*------------------------------------------------------------

executeBackup () {
    log "Create OADP Offline Backup with Archive prefix $ArchiveID in S3 Object Store"
    initBAR
    local Outcome2Achieve="Create OADP Offline Backup wth Archive ID $ArchiveID in S3 Object Store"
    echo
    listBackups SkipInitBAR
    echo
    [[ -z $CheckBAR ]] || checkRegistry SkipInitBAR
    [[ -z $CheckBAR ]] || estimateSize SkipInitBAR
    [[ -z $(statusBackup SkipInitBAR) ]] || eraseBackup SkipInitBAR
    wait4AllCRs MaintenanceModeOK
    local BackupLogFile=$CX/log/OADP.Offline.Backup.$ArchiveID.$(date +%F_%H%M%S).log
    local Command2Execute="cpd-cli oadp tenant-backup create $ArchiveID"
    Command2Execute+=" --tenant-operator-namespace $OperatorNS"
    cat << EOF >> $LogFile

$(logCommand $Outcome2Achieve)$(echo -e $(getColor Purple))
cpd-cli oadp tenant-backup create $ArchiveID \\
  --tenant-operator-namespace $OperatorNS \\
EOF
    if [[ ! -z $ImagePrefix ]]; then
        Command2Execute+=" --image-prefix=$ImagePrefix"
        cat << EOF >> $LogFile
  --image-prefix=$ImagePrefix \\
EOF
    fi
    if [[ ! -z $VolumeMountPodMemoryRequest ]]; then
        Command2Execute+=" --vol-mnt-pod-mem-request=$VolumeMountPodMemoryRequest"
        cat << EOF >> $LogFile
  --vol-mnt-pod-mem-request=$VolumeMountPodMemoryRequest \\
EOF
    fi
    if [[ ! -z $VolumeMountPodMemoryLimit ]]; then
        Command2Execute+=" --vol-mnt-pod-mem-limit=$VolumeMountPodMemoryLimit"
        cat << EOF >> $LogFile
  --vol-mnt-pod-mem-limit=$VolumeMountPodMemoryLimit \\
EOF
    fi
    Command2Execute+=" --namespace $OadpNS --mode offline"
    if [[ $_LoggingMode == --verbose ]]; then
        Command2Execute+=" --log-level=debug --verbose"
        cat << EOF >> $LogFile
  --namespace $OadpNS \\
  --mode offline \\
  --log-level=debug \\
  --verbose > $BackupLogFile
$(echo -e $(getColor None))
EOF
    else
        cat << EOF >> $LogFile
  --namespace $OadpNS \\
  --mode offline > $BackupLogFile
$(echo -e $(getColor None))
EOF
    fi
    info "  $Outcome2Achieve" force
    info "  Track progress via log file $(basename $BackupLogFile)" force
    local StopCheckingBackupStatusFile=$CX/data/Stop.Checking.Backup.Status.$ArchiveID
    checkStatus4BAR &
    $Command2Execute > $BackupLogFile 2>&1
    local ExitCode=$?
    touch $StopCheckingBackupStatusFile
    while [[ -f $StopCheckingBackupStatusFile ]]; do
        sleep 10
    done
    [[ $ExitCode -eq 0 ]] && pass "  $Outcome2Achieve" force || abort "Failed to $Outcome2Achieve"
    echo
    listBackups SkipInitBAR
    wait4AllCRs MaintenanceModeOK
}

#*------------------------------------------------------------
#* Query Restore from S3 ObjectStore
#*    1: Archive Suffix
#*------------------------------------------------------------

queryRestores () {
    echo $(blue NAME MODE ORCHESTRATION RESOLVED_NAMESPACES STATUS ERRORS WARNINGS START_TIME END_TIME TENANT_BACKUP)
    while IFS= read -r Restore; do
        [[ ! -z $AllBackups || -z $ArchiveSuffix || $(awk '{print $(NF-1)}' <<< $Restore) =~ $ArchiveSuffix ]] || continue
        echo $(purple "$(cut -f1-7 <<< $Restore) $(awk -F' ' '{print $8"#"$9"#"$10}' <<< $Restore) $(awk -F' ' '{print $11"#"$12"#"$13}' <<< $Restore) $(awk -F' ' '{print $14}' <<< $Restore)")
    done < <(cpd-cli oadp tenant-restore list | grep -v NAME)
}

#*------------------------------------------------------------
#* List of Restores matching Archive suffix in S3 Object Store
#*    1: Skip Init BAR
#*------------------------------------------------------------

listRestores () {
    local SkipInitBAR=$1
    [[ -z $AllBackups ]] && log "List of Restores matching Archive suffix in S3 Object Store" \
                         || log "List all Restores in S3 Object Store"
    [[ -z $SkipInitBAR ]] && initBAR
    [[ -z $AllBackups ]] && info "  List of Restores matching Archive suffix, $ArchiveSuffix, in S3 Object Store" force
    echo
    queryRestores | column -t | sed -e "s/#/ /g"
    echo
}

#*------------------------------------------------------------
#* Execute OADP Restore
#* TODO Restore to another cluster
#*------------------------------------------------------------

executeRestore () {
    log "Restore OADP Offline Backup with Archive prefix $ArchiveID from S3 Object Store using Restore ID $RestoreID"
    initBAR
    local Outcome2Achieve="Restore OADP Offline Backup wth Archive ID $ArchiveID from S3 Object Store using Restore ID $RestoreID"
    echo
    listBackups SkipInitBAR
    echo
    listRestores SkipInitBAR
    echo
    local BackupStatus=$(statusBackup SkipInitBAR)
    [[ $BackupStatus == Completed ]] || abort "Skipping Restore request as Archive $ArchiveID Status is $BackupStatus not Completed"
    # TODO Replace below with ./cpd-pre-restore-cleanup.sh --tenant-operator-namespace="${PROJECT_CPD_INST_OPERATORS}"
    for NamespaceID in $(jq --raw-output '.namespace | keys_unsorted | .[]' $Config4ROSA); do
        [[ "|operator|instance|" =~ "|$NamespaceID|" ]] || continue
        local Namespace=$(jq --raw-output --arg ID $NamespaceID '.namespace | .[$ID]' $Config4ROSA)
        oc project $Namespace >/dev/null 2>&1 || continue
        deleteNamespace $NamespaceID $Namespace
    done
    local RestoreLogFile=$CX/log/OADP.Offline.Restore.$ArchiveID.$(date +%F_%H%M%S).log
    local Command2Execute="cpd-cli oadp tenant-restore create $RestoreID"
    cat << EOF >> $LogFile

$(logCommand $Outcome2Achieve)$(echo -e $(getColor Purple))
cpd-cli oadp tenant-restore create $RestoreID \\
EOF
    if [[ ! -z $ImagePrefix ]]; then
        Command2Execute+=" --image-prefix=$ImagePrefix"
        cat << EOF >> $LogFile
  --image-prefix=$ImagePrefix \\
EOF
    fi
    Command2Execute+=" --from-tenant-backup $ArchiveID"
    if [[ $_LoggingMode == --verbose ]]; then
        Command2Execute+=" --log-level=debug --verbose"
        cat << EOF >> $LogFile
  --from-tenant-backup $ArchiveID \\
  --log-level=debug \\
  --verbose > $RestoreLogFile
$(echo -e $(getColor None))
EOF
    else
        cat << EOF >> $LogFile
  --from-tenant-backup $ArchiveID > $RestoreLogFile
$(echo -e $(getColor None))
EOF
    fi
    info "  $Outcome2Achieve" force
    info "  Track progress via log file $(basename $RestoreLogFile)" force
    local StopCheckingRestoreStatusFile=$CX/data/Stop.Checking.Restore.Status.$RestoreID
    checkStatus4BAR &
    $Command2Execute > $RestoreLogFile 2>&1
    local ExitCode=$?
    touch $StopCheckingRestoreStatusFile
    while [[ -f $StopCheckingRestoreStatusFile ]]; do
        sleep 10
    done
    [[ $ExitCode -eq 0 ]] && pass "  $Outcome2Achieve" force || abort "Failed to $Outcome2Achieve"
    echo
    listRestores SkipInitBAR
    wait4AllCRs MaintenanceModeOK
}

#*------------------------------------------------------------
#* Test Snippet
#*------------------------------------------------------------

testSnippet () {
    log "Test Snippet"
}

#*------------------------------------------------------------
#* Main
#*------------------------------------------------------------

defineDefaults $(dirname $0)

parseOptions $*

case $_Action in
    configure)      configurePreRequisites;;
    deployHub)      deploySoftwareHub;;
    deployIKC)      deployService wkc;;
    deployMANTA)    deployService mantaflow;;
    deployBAR)      deployBAR;;
    queryDetail)    queryClusterDetail;;
    purgeDeploy)    purgeDeployment;;
    listBackups)    listBackups; listRestores;;
    statusBackup)   statusBackup;;
    checkRegistry)  checkRegistry;;
    estimateSize)   estimateSize;;
    eraseBackup)    eraseBackup;;
    executeBackup)  executeBackup;;
    executeRestore) executeRestore;;
    testSnippet)    testSnippet;;
esac

exit 0
