#*------------------------------------------------------------
#* Get Color
#*    1: Color
#*------------------------------------------------------------

getColor () {
    local Color=$1
    [[ -z $Monochrome ]] && case $Color in
        Black)      echo "\033[0;30m";;
        BoldBlack)  echo "\033[1;30m";;
        Red)        echo "\033[0;31m";;
        Blue)       echo "\033[0;34m";;
        Purple)     echo "\033[0;35m";;
        BoldPurple) echo "\033[1;35m";;
        None)       echo "\033[0m";;
    esac
}

#*------------------------------------------------------------
#* Color Text
#*    1: Text
#*------------------------------------------------------------

colorText () {
    echo -e -n "$*$(getColor None)"
}

#*------------------------------------------------------------
#* Bold Text
#*    1: Text
#*------------------------------------------------------------

bold () {
    colorText "$(getColor BoldBlack)$*"
}

#*------------------------------------------------------------
#* Red Text
#*    1: Text
#*------------------------------------------------------------

red () {
    colorText "$(getColor Red)$*"
}

#*------------------------------------------------------------
#* Purple Text
#*    1: Text
#*------------------------------------------------------------

purple () {
    colorText "$(getColor Purple)$*"
}

#*------------------------------------------------------------
#* Option Name Text
#*    1: Text
#*------------------------------------------------------------

option () {
    colorText "$(getColor Blue)$*"
}

#*------------------------------------------------------------
#* Option Value Text
#*    1: Text
#*------------------------------------------------------------

value () {
    colorText "$(getColor Purple)$*"
}

#*------------------------------------------------------------
#* Default Text
#*    1: Text
#*------------------------------------------------------------

default () {
    colorText "$(getColor BoldPurple)$*"
}

#*------------------------------------------------------------
#* Always log this message
#*    1: Message
#*------------------------------------------------------------

log () {
    echo -e "[$(date +"%Y-%m-%d %H:%M %Z")] $*$(getColor None)" 1>&2
}

#*------------------------------------------------------------
#* Always log this Fail Message
#*    1: Message
#*------------------------------------------------------------

fail () {
    log "$(getColor Red)FAIL: $*"
}

#*------------------------------------------------------------
#* Always log this Abort Message
#*    1: Message
#*------------------------------------------------------------

abort () {
    log "$(getColor Red)Aborting: $*\n"
    exit 1
}

#*------------------------------------------------------------
#* Show help
#*    1: Exit Code
#*------------------------------------------------------------

showHelp () {
    cat << EOF 1>&2

Usage:
  $(bold $(basename $0)) $(option --extract) [$(option --CX) <$(value home)>] [$(option --monochrome)]

  $(bold $(basename $0)) $(option --help) [$(option --monochrome)]

    where
      $(option --extract)        Extract deploy tool and configuration files
                       - This script needs to be executed as $(red root)
                       - This script will create $(purple $CX) sub-directory.
                         Under $CX, it will create the following sub-directories
                         - $(purple data): for the $(purple cx.rosa.json) file. $(red This needs to be configured to define)
                                 $(red registry, cluster, S3 Object Store access and identify namespaces)
                         - $(purple log): for script generated
                                - log files
                                - scripts containing the plan
                         - $(purple tools): for the $(purple cx.rosa.sh) script that will
                                  - configure the pre-requisites,
                                  - deploy services like IBM Software Hub, IBM Knowledge Catalog, MANTA OEM
                                  - configure/execute or Backup/Restore operations
                                  - query the cluster health or
                                  - purge all the services

      $(option --CX)             CX Home ($(value default):- $(default $CX))
      $(option --monochrome)     Monochrome Logging

      $(option --help)           Print this usage help

EOF
    exit $?
}

#*------------------------------------------------------------
#* Log Usage
#*    1: Message
#*------------------------------------------------------------

usage () {
    echo 1>&2
    fail "$1"
    echo 1>&2
    showHelp 1
}

#*------------------------------------------------------------
#* Check Parameter
#*    1: Name of Option
#*    2: Name of Value
#*    3: Value specified
#*------------------------------------------------------------

checkParameter () {
    local OptionName=$1
    local ValueName=$2
    local Value=$3
    [[ -z $Value || $(cut -c1,1 <<< $Value) == - ]] && usage "--$OptionName <$ValueName> not specified"
}

#*------------------------------------------------------------
#* Parse Options
#*------------------------------------------------------------

parseOptions () {
    unset Monochrome
    _Action=showHelp
    for opt in $*; do
        case $1 in
            -e | --extract)                                                       _Action=extractTool;  shift;;
            -T | --Test)                                                          _Action=testSnippet;  shift;;    # Hidden Option

            -C | --CX)         checkParameter CX home $2;      CX=$2;                                   shift 2;;
            -m | --monochrome)                                 Monochrome=true;                         shift;;

            -h | --help)                                                          _Action=showHelp;     shift;;
            -u | --usage)                                                         _Action=showHelp;     shift;;
            *) break;;
        esac
    done
    [[ $# -ne 0 ]] && usage "Invalid option $1"
}

#*------------------------------------------------------------
#* Extract Tool
#*------------------------------------------------------------

extractTool () {
    log "Extract Tool for Cloud Pak for Data Deployment"
    [[ $(id -u) -eq 0 ]] || abort "Please run this script as root user"
    mkdir -p $CX/{data,log,tools,tmp$$}
    tail -n+$(awk '/^__ARCHIVE__/ {print NR + 1; exit 0; }' $0) $0 | tar x -C $CX/tmp$$
    cp -p $CX/tmp$$/tools/cx.rosa.sh $CX/tools
    if [[ -f $CX/data/cx.rosa.json ]]; then
        local ArchiveJSON=$CX/data/cx.rosa.$(date +"%Y%m%d%H%M").json
        cp $CX/data/cx.rosa.json $ArchiveJSON
        local DeployConfigJSON=$(jq . $CX/data/cx.rosa.json)
        DeployConfigJSON=$(jq --arg Namespace  $(jq --raw-output .namespace.oadpApp $CX/tmp$$/data/cx.rosa.json) \
                              '.namespace += {"oadpApp": $Namespace}' <<< $DeployConfigJSON)
        DeployConfigJSON=$(jq --arg Release    $(jq --raw-output '.release'   $CX/tmp$$/data/cx.rosa.json) \
                              --arg URL4CPDCLI $(jq --raw-output '."cpd-cli"' $CX/tmp$$/data/cx.rosa.json) \
                              --arg AppWebHook $(jq --raw-output '."oadp-app-webhook"' $CX/tmp$$/data/cx.rosa.json) \
                              '. += {"release": $Release,
                                     "cpd-cli": $URL4CPDCLI,
                                     "oadp-app-webhook": $AppWebHook}' <<< $DeployConfigJSON)
        jq . <<< $DeployConfigJSON > $CX/data/cx.rosa.json
        diff $CX/data/cx.rosa.json $ArchiveJSON &> /dev/null && rm -f $ArchiveJSON
    else
        cp -p $CX/tmp$$/data/cx.rosa.json $CX/data
    fi
    mkdir -p $CX/app/{config,oadp_app,docker,scripts}
    cp -p $CX/tmp$$/app/oadp_app/deploy.sh $CX/app/oadp_app
    cp -p $CX/tmp$$/app/oadp_app/app.py $CX/app/oadp_app
    cp -p $CX/tmp$$/app/docker/Dockerfile.oadp-app $CX/app/docker
    cp -p $CX/tmp$$/app/scripts/cx.oadp.app.sh $CX/app/scripts
    rm -rf $CX/tmp$$

    cat << EOF

Please update $(purple \$CX/data/cx.rosa.json) to configure registry, cluster, S3 Object Store access

To view the various options available in the deploy tool, execute the following

  $(bold \$CP4D/tools/cx.rosa.sh) $(option --help) $(option --verbose)

EOF
}

#*------------------------------------------------------------
#* Test Snippet
#*------------------------------------------------------------

testSnippet () {
    log "Test Snippet"
}

#*------------------------------------------------------------
#* Main
#*------------------------------------------------------------

CX="/usr/local/CX"
parseOptions $*

case $_Action in
    extractTool) extractTool;;
    testSnippet) testSnippet;;
    showHelp)    showHelp 0;;
esac

exit 0

__ARCHIVE__
app/␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀0000755␀0000000␀0000000␀00000000000␀15116205704␀010335␀ 5␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀ustar  ␀root␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀root␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀app/oadp_app/␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀0000755␀0000000␀0000000␀00000000000␀15116205704␀012120␀ 5␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀ustar  ␀root␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀root␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀app/oadp_app/deploy.sh␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀0000755␀0000000␀0000000␀00000024171␀15116127271␀013762␀ 0␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀ustar  ␀root␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀root␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀#!/bin/bash
# Usage: ./deploy.sh -c <openshift-url> -u <openshift-username> -p <openshift-password>
set -euo pipefail

# Define a usage function for errors or help
usage() {
  echo "Usage: $0 -c <openshift-url> -u <openshift-username> -p <openshift-password>"
  echo "  -c: OpenShift Cluster URL"
  echo "  -u: OpenShift Username"
  echo "  -p: OpenShift Password"
  echo "  -h: Show this help message"
  exit 1
}

# Initialize variables
CLUSTER_URL=""
USERNAME=""
PASSWORD=""

# Use getopts to parse options
while getopts ":hc:u:p:" opt; do
  case ${opt} in
    h) usage ;;
    c) CLUSTER_URL=$OPTARG ;;
    u) USERNAME=$OPTARG ;;
    p) PASSWORD=$OPTARG ;;
    \?) echo "Invalid option: -$OPTARG" >&2; usage ;;
    :) echo "Option -$OPTARG requires an argument." >&2; usage ;;
  esac
done

# --- Validation ---
if [[ -z "$CLUSTER_URL" || -z "$USERNAME" || -z "$PASSWORD" ]]; then
  echo "Error: Missing one or more required arguments."
  usage
fi

# --- Check for dependencies ---
if ! command -v podman &> /dev/null; then
    echo "Error: podman is not installed." >&2
    exit 1
fi

if ! command -v jq &> /dev/null; then
    echo "Error: jq is not installed. Please install it to parse the config JSON." >&2
    exit 1
fi

# --- Define Paths (Moved Up) ---
# We need these early to read the config before setting variables
SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
REPO_ROOT=$(cd "$SCRIPT_DIR/.." && pwd)
CUSTOM_ROOT=/usr/local/CX/app

# --- Load Configuration ---
# Logic to determine which config file to read (Repo default vs Custom host)
DEFAULT_CONFIG_REPO_PATH="$REPO_ROOT/config/cx.oadp.app.json"
CUSTOM_CONFIG_HOST_PATH="$CUSTOM_ROOT/config/cx.oadp.app.json"
CONFIG_TO_READ=""

if [ -f "$CUSTOM_CONFIG_HOST_PATH" ]; then
    echo "--- Reading configuration from custom path: $CUSTOM_CONFIG_HOST_PATH"
    CONFIG_TO_READ="$CUSTOM_CONFIG_HOST_PATH"
else
    echo "--- Reading configuration from repo path: $DEFAULT_CONFIG_REPO_PATH"
    CONFIG_TO_READ="$DEFAULT_CONFIG_REPO_PATH"
fi

# --- Extract Variables from JSON ---
# Extract NAMESPACE from "oadpApp"
NAMESPACE=$(jq -r '.namespace.oadpApp' "$CONFIG_TO_READ")

# Extract IMAGE_NAME from "oadp-app-webhook"
IMAGE_NAME=$(jq -r '."oadp-app-webhook"' "$CONFIG_TO_READ")

# Validate that variables were found
if [[ "$NAMESPACE" == "null" || -z "$NAMESPACE" ]]; then
    echo "Error: Could not find key 'oadpApp' in $CONFIG_TO_READ"
    exit 1
fi
if [[ "$IMAGE_NAME" == "null" || -z "$IMAGE_NAME" ]]; then
    echo "Error: Could not find key 'oadp-app-webhook' in $CONFIG_TO_READ"
    exit 1
fi

echo "Configuration Loaded:"
echo "  Namespace:  $NAMESPACE"
echo "  Image Name: $IMAGE_NAME"

# --- Main Script Logic ---

echo "1. Logging into OpenShift..."
oc login "$CLUSTER_URL" --username="$USERNAME" --password="$PASSWORD" --insecure-skip-tls-verify

echo "2. Creating namespace if it doesn't exist..."
oc get ns "$NAMESPACE" &>/dev/null || oc create ns "$NAMESPACE"

# --- Create or ensure the ServiceAccount exists ---
SA_NAME="${IMAGE_NAME}-sa"

echo "3. Creating ServiceAccount ($SA_NAME)..."
oc apply -f - <<EOF
apiVersion: v1
kind: ServiceAccount
metadata:
  name: $SA_NAME
  namespace: $NAMESPACE
EOF

# --- Grant admin-level permissions to the ServiceAccount ---
echo "4. Granting cluster-admin privileges to $SA_NAME..."
oc adm policy add-cluster-role-to-user cluster-admin "system:serviceaccount:$NAMESPACE:$SA_NAME"

# --- Build image ---
REGISTRY=$(oc get route default-route -n openshift-image-registry --template='{{ .spec.host }}')
FULL_IMAGE="$REGISTRY/$NAMESPACE/$IMAGE_NAME:latest"

# Define the script's absolute path and then its directory
SCRIPT_PATH="$(readlink -f "$0")"
SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"
# Define the directory to skip
SKIP_DIR="$CUSTOM_ROOT/oadp_app"

SCRIPT_BACKUP_NEEDED=false
DELETE_SCRIPT_BACKUP_NEEDED=false
BACKUP_NEEDED=false

# Check if current directory is NOT the skip directory
if [ "$SCRIPT_DIR" != "$SKIP_DIR" ]; then
    # --- Script File Logic ---
    DEFAULT_SCRIPT_REPO_PATH="$REPO_ROOT/scripts/cx.oadp.app.sh"
    CUSTOM_SCRIPT_HOST_PATH="$CUSTOM_ROOT/scripts/cx.oadp.app.sh"
    
    trap "if [ \"$SCRIPT_BACKUP_NEEDED\" = true ]; then echo '--- Restoring original repo script...'; mv '$DEFAULT_SCRIPT_REPO_PATH.bak' '$DEFAULT_SCRIPT_REPO_PATH'; fi" EXIT

    if [ -f "$CUSTOM_SCRIPT_HOST_PATH" ]; then
        echo "--- Found custom script. Using it for build."
        mv "$DEFAULT_SCRIPT_REPO_PATH" "$DEFAULT_SCRIPT_REPO_PATH.bak"
        cp "$CUSTOM_SCRIPT_HOST_PATH" "$DEFAULT_SCRIPT_REPO_PATH"
        SCRIPT_BACKUP_NEEDED=true
    fi

    # --- Delete Script Logic ---
    DEFAULT_DEL_REPO_PATH="$REPO_ROOT/scripts/delete-cpd-namespace.sh"
    CUSTOM_DEL_HOST_PATH="$CUSTOM_ROOT/scripts/delete-cpd-namespace.sh"
    
    trap "if [ \"$DELETE_SCRIPT_BACKUP_NEEDED\" = true ]; then echo '--- Restoring delete script...'; mv '$DEFAULT_DEL_REPO_PATH.bak' '$DEFAULT_DEL_REPO_PATH'; fi" EXIT

    if [ -f "$CUSTOM_DEL_HOST_PATH" ]; then
        echo "--- Found custom delete script. Using it for build."
        mv "$DEFAULT_DEL_REPO_PATH" "$DEFAULT_DEL_REPO_PATH.bak"
        cp "$CUSTOM_DEL_HOST_PATH" "$DEFAULT_DEL_REPO_PATH"
        DELETE_SCRIPT_BACKUP_NEEDED=true
    fi

    # --- Config File Logic ---
    # We already determined paths earlier, but we need to do the physical file swap for the Docker build context
    
    trap "if [ \"$BACKUP_NEEDED\" = true ]; then echo '--- Restoring original repo config...'; mv '$DEFAULT_CONFIG_REPO_PATH.bak' '$DEFAULT_CONFIG_REPO_PATH'; fi" EXIT

    if [ -f "$CUSTOM_CONFIG_HOST_PATH" ]; then
        echo "--- Swapping custom config into build context."
        mv "$DEFAULT_CONFIG_REPO_PATH" "$DEFAULT_CONFIG_REPO_PATH.bak"
        cp "$CUSTOM_CONFIG_HOST_PATH" "$DEFAULT_CONFIG_REPO_PATH"
        BACKUP_NEEDED=true
    fi

    # --- Global Config Logic ---
    REPO_GLOBAL_CONFIG="$REPO_ROOT/config/global.yml"
    CUSTOM_GLOBAL_CONFIG="$CUSTOM_ROOT/config/global.yml"

    if [ -f "$CUSTOM_GLOBAL_CONFIG" ]; then
        cp "$CUSTOM_GLOBAL_CONFIG" "$REPO_GLOBAL_CONFIG"
    else
        echo "ERROR: Required custom config not found at $CUSTOM_GLOBAL_CONFIG"
        exit 1
    fi
fi

echo "5. Building Docker/Podman image..."
podman build \
  -t "$FULL_IMAGE" \
  -f "$REPO_ROOT/docker/Dockerfile.oadp-app" \
  "$REPO_ROOT"

# Restore files (Logic handled by manual blocks here in case traps didn't catch specific flow)
if [ "$SCRIPT_BACKUP_NEEDED" = true ]; then
    mv "$REPO_ROOT/scripts/cx.oadp.app.sh.bak" "$REPO_ROOT/scripts/cx.oadp.app.sh"
    SCRIPT_BACKUP_NEEDED=false
fi
if [ "$DELETE_SCRIPT_BACKUP_NEEDED" = true ]; then
    mv "$REPO_ROOT/scripts/delete-cpd-namespace.sh.bak" "$REPO_ROOT/scripts/delete-cpd-namespace.sh"
    DELETE_SCRIPT_BACKUP_NEEDED=false
fi
if [ "$BACKUP_NEEDED" = true ]; then
    mv "$REPO_ROOT/config/cx.oadp.app.json.bak" "$REPO_ROOT/config/cx.oadp.app.json"
    BACKUP_NEEDED=false 
fi

# Clear traps
trap - EXIT

echo "6. Logging into OpenShift internal registry..."
TOKEN=$(oc whoami -t)
podman login -u $(oc whoami) -p "$TOKEN" "$REGISTRY"

echo "7. Pushing image to OpenShift internal registry..."
podman push "$FULL_IMAGE"

echo "8. Deploying $IMAGE_NAME with persistent logs..."

# --- 1. Create PVC for Database ---
# Check if PVC exists first to avoid 'AlreadyExists' error causing script exit
if oc get pvc oadp-app-db-pvc -n "$NAMESPACE" >/dev/null 2>&1; then
    echo "PVC 'oadp-app-db-pvc' already exists. Skipping creation."
else
    echo "Creating PVC 'oadp-app-db-pvc'..."
    oc apply -f - <<EOF
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: oadp-app-db-pvc
  namespace: $NAMESPACE
spec:
  accessModes:
    - ReadWriteOnce
  resources:
    requests:
      storage: 1Gi
EOF
fi

# --- 2. Create PVC for Logs ---
if oc get pvc oadp-app-logs-pvc -n "$NAMESPACE" >/dev/null 2>&1; then
    echo "PVC 'oadp-app-logs-pvc' already exists. Skipping creation."
else
    echo "Creating PVC 'oadp-app-logs-pvc'..."
    oc apply -f - <<EOF
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: oadp-app-logs-pvc
  namespace: $NAMESPACE
spec:
  accessModes:
    - ReadWriteMany
  resources:
    requests:
      storage: 5Gi
  storageClassName: efs-sc
EOF
fi

# --- 3. Deployment with Dual Mounts ---
oc apply -f - <<EOF
apiVersion: apps/v1
kind: Deployment
metadata:
  name: $IMAGE_NAME
  namespace: $NAMESPACE
spec:
  replicas: 1
  selector:
    matchLabels:
      app: $IMAGE_NAME
  template:
    metadata:
      labels:
        app: $IMAGE_NAME
    spec:
      securityContext:
        fsGroup: 1001
      serviceAccountName: $SA_NAME
      containers:
      - name: $IMAGE_NAME
        image: $FULL_IMAGE
        ports:
        - containerPort: 8443
        env:
        - name: POD_NAMESPACE
          valueFrom:
            fieldRef:
              fieldPath: metadata.namespace
        - name: JOB_IMAGE
          value: $FULL_IMAGE
        - name: APP_NAME
          value: $IMAGE_NAME
        volumeMounts:
        - name: oadp-app-db-vol
          mountPath: /usr/local/CX/db
        - name: oadp-app-logs-vol
          mountPath: /usr/local/CX/log
      volumes:
      - name: oadp-app-db-vol
        persistentVolumeClaim:
          claimName: oadp-app-db-pvc
      - name: oadp-app-logs-vol
        persistentVolumeClaim:
          claimName: oadp-app-logs-pvc
---
apiVersion: v1
kind: Service
metadata:
  name: $IMAGE_NAME
  namespace: $NAMESPACE
spec:
  selector:
    app: $IMAGE_NAME
  ports:
    - name: https
      port: 443
      targetPort: 8443
---
apiVersion: route.openshift.io/v1
kind: Route
metadata:
  name: $IMAGE_NAME
  namespace: $NAMESPACE
spec:
  to:
    kind: Service
    name: $IMAGE_NAME
  tls:
    termination: edge
EOF

# --- Force redeploy to pick up new image ---
echo "9. Forcing rollout with latest image..."
oc set image deployment/$IMAGE_NAME $IMAGE_NAME="$FULL_IMAGE" -n "$NAMESPACE"
oc patch deployment $IMAGE_NAME -n "$NAMESPACE" -p '{"spec": {"template": {"metadata": {"annotations": {"redeploy-timestamp": "'$(date +%s)'"}}}}}'
oc rollout status deployment/$IMAGE_NAME -n "$NAMESPACE"

# --- Show pod status and route ---
echo "10. Current pod status:"
oc get pods -n "$NAMESPACE"

ROUTE_URL=$(oc get route $IMAGE_NAME -n "$NAMESPACE" -o jsonpath='{.spec.host}')
echo "Webhook deployed successfully!"
echo "Webhook URL: https://$ROUTE_URL/token/validate"␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀app/oadp_app/app.py␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀0000644␀0000000␀0000000␀00000054253␀15116127250␀013262␀ 0␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀ustar  ␀root␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀root␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀from flask import Flask, request, jsonify
from kubernetes import client, config
import os
import subprocess
import uuid
import sqlite3
import threading
import time
from datetime import datetime

app = Flask(__name__)

# --- Script/K8s Constants ---
CX_SCRIPT_PATH = "/usr/local/CX/tools/cx.oadp.app.sh"

# --- Environment-derived Configuration ---
POD_NAMESPACE = os.getenv("POD_NAMESPACE", "openshift-adp-app")
JOB_IMAGE = os.getenv("JOB_IMAGE")
APP_NAME = os.getenv("APP_NAME", "oadp-app-webook")

# Construct names dynamically based on APP_NAME
JOB_SERVICE_ACCOUNT = f"{APP_NAME}-sa"
K8S_JOB_LABEL = f"app={APP_NAME}-job"

# --- Database Configuration ---
# Store the DB on the persistent volume
DB_PATH = "/usr/local/CX/db/jobs.db"

# Ensure the data directory exists (Python usually handles the file creation, 
# but the folder must be there. The mount ensures it, but this is a safety check).
if not os.path.exists(os.path.dirname(DB_PATH)):
    try:
        os.makedirs(os.path.dirname(DB_PATH))
    except OSError:
        pass

# --- K8s API Client Initialization ---
try:
    config.load_incluster_config()
    auth_v1_api = client.AuthenticationV1Api()
    batch_v1_api = client.BatchV1Api()
    core_v1_api = client.CoreV1Api()
    if not JOB_IMAGE:
        app.logger.warning("JOB_IMAGE environment variable is not set. Job creation will fail.")
except Exception as e:
    app.logger.error(f"Failed to load Kubernetes in-cluster config: {e}")
    auth_v1_api, batch_v1_api, core_v1_api = None, None, None

# --- Database Helper Functions ---

def get_db():
    """Get a thread-safe connection to the SQLite database."""
    db = getattr(threading.local(), '_database', None)
    if db is None:
        db = threading.local()._database = sqlite3.connect(DB_PATH, timeout=10)
        db.row_factory = sqlite3.Row
    return db

@app.teardown_appcontext
def close_connection(exception):
    """Close the database connection at the end of the request."""
    db = getattr(threading.local(), '_database', None)
    if db is not None:
        db.close()

def init_db():
    """Initialize the database and create tables if they don't exist."""
    with app.app_context():
        try:
            db = get_db()
            cursor = db.cursor()
            cursor.execute("""
                CREATE TABLE IF NOT EXISTS jobs (
                    job_id TEXT PRIMARY KEY,
                    k8s_job_name TEXT NOT NULL,
                    job_type TEXT,
                    status TEXT NOT NULL,
                    username TEXT,
                    created_at TEXT NOT NULL,
                    finished_at TEXT,
                    logs TEXT
                )
            """)
            db.commit()
            app.logger.info("Database initialized successfully.")
        except Exception as e:
            app.logger.error(f"Failed to initialize database: {e}")

# --- Reusable Helper Functions ---

def get_api_server():
    cluster_url = os.getenv("KUBERNETES_SERVICE_HOST")
    cluster_port = os.getenv("KUBERNETES_SERVICE_PORT")
    return f"https://{cluster_url}:{cluster_port}"

def validate_token_with_k8s(token):
    if not auth_v1_api:
        return None, "Kubernetes API client not initialized"
    try:
        review = client.V1TokenReview(spec=client.V1TokenReviewSpec(token=token))
        response = auth_v1_api.create_token_review(review)
        if response.status.authenticated:
            return response.status.user.username, None
        return None, "Token not authenticated"
    except Exception as e:
        app.logger.error(f"TokenReview API failed: {e}")
        return None, str(e)

def extract_token():
    auth_header = request.headers.get("Authorization")
    if not auth_header or not auth_header.startswith("Bearer "):
        return None, jsonify({"error": "Missing or invalid Authorization header"}), 401
    return auth_header.split()[1], None, None

# --- SYNCHRONOUS FUNCTION (Kept for fast endpoints) ---
def run_cx_script(api_server, token, args):
    try:
        safe_cmd = [CX_SCRIPT_PATH] + args + ["--API", api_server, "--token", "REDACTED"]
        app.logger.info(f"Running synchronous command: {' '.join(safe_cmd)}")
        cmd = [CX_SCRIPT_PATH] + args + ["--API", api_server, "--token", token]
        result = subprocess.run(cmd, capture_output=True, text=True, check=True, encoding='utf-8')
        stdout = result.stdout.strip() if result.stdout else ""
        stderr = result.stderr.strip() if result.stderr else ""
        if not stdout and stderr:
            return stderr, None
        return stdout, None
    except subprocess.CalledProcessError as e:
        err_msg = e.stderr.strip() if e.stderr else "Process failed with no stderr."
        app.logger.error(f"Script failed: {err_msg}")
        return None, err_msg
    except Exception as e:
        app.logger.error(f"Script failed: {e}")
        return None, str(e)

# --- NEW ASYNCHRONOUS JOB FUNCTIONS ---

def create_k8s_job(job_name_prefix, command_args, token, api_server, username):
    """
    Creates a K8s Job that mounts the SHARED LOGS volume.
    """
    if not batch_v1_api or not JOB_IMAGE:
        err = "Job orchestrator not initialized."
        app.logger.error(err)
        return None, err

    try:
        k8s_job_name = f"{job_name_prefix}-{uuid.uuid4().hex[:10]}"
        job_command = [CX_SCRIPT_PATH] + command_args + ["--API", api_server, "--token", token]

        # --- MOUNT CONFIGURATION ---
        log_mount = client.V1VolumeMount(
            name="job-logs-vol",
            mount_path="/usr/local/CX/log"
        )

        log_volume = client.V1Volume(
            name="job-logs-vol",
            persistent_volume_claim=client.V1PersistentVolumeClaimVolumeSource(
                claim_name="oadp-app-logs-pvc" 
            )
        )

        container = client.V1Container(
            name=f"{job_name_prefix}-worker",
            image=JOB_IMAGE,
            command=job_command,
            env=[client.V1EnvVar(name="CPD_CLI_WORKSPACE", value="/usr/local/CX/work")],
            volume_mounts=[log_mount]
        )
        
        job_template_labels = {
            "app": f"{APP_NAME}-job", 
            "owner": username.replace(":", "-").lower()[:63],
            "k8s-job-name": k8s_job_name
        }

        job_spec = client.V1JobSpec(
            template=client.V1PodTemplateSpec(
                metadata=client.V1ObjectMeta(labels=job_template_labels),
                spec=client.V1PodSpec(
                    containers=[container],
                    volumes=[log_volume],
                    restart_policy="Never",
                    service_account_name=JOB_SERVICE_ACCOUNT,
                    security_context=client.V1PodSecurityContext(fs_group=1001)
                )
            ),
            backoff_limit=0
        )

        job = client.V1Job(
            api_version="batch/v1",
            kind="Job",
            metadata=client.V1ObjectMeta(
                name=k8s_job_name,
                labels={"app": f"{APP_NAME}-job", "job-type": job_name_prefix}
            ),
            spec=job_spec
        )

        batch_v1_api.create_namespaced_job(body=job, namespace=POD_NAMESPACE)
        return k8s_job_name, None

    except Exception as e:
        app.logger.error(f"Failed to create Kubernetes job: {e}")
        return None, str(e)

# --- NEW GENERIC STATUS ENDPOINT ---

@app.route("/job/status/<job_id>", methods=["GET"])
def get_job_status(job_id):
    """
    Generic endpoint to check the status of any job from the SQLite DB.
    """
    token, resp, status = extract_token()
    if not token:
        return resp, status
    username, error = validate_token_with_k8s(token)
    if error:
        return jsonify({"error": error}), 403

    try:
        db = get_db()
        cursor = db.cursor()
        cursor.execute("SELECT * FROM jobs WHERE job_id = ?", (job_id,))
        job = cursor.fetchone()

        if not job:
            return jsonify({"error": "Job not found"}), 404

        # The user who created the job is the only one who can see it
        if job["username"] != username:
             return jsonify({"error": "Forbidden: You do not own this job"}), 403

        return jsonify({
            "job_id": job["job_id"],
            "job_type": job["job_type"],
            "status": job["status"],
            "created_at": job["created_at"],
            "finished_at": job["finished_at"],
            "output": job["logs"] if job["status"] in ('SUCCEEDED', 'FAILED') else None,
        }), 200

    except Exception as e:
        app.logger.error(f"Failed to query job status from DB: {e}")
        return jsonify({"error": "Internal server error reading job status"}), 500


# --- ASYNCHRONOUS ENDPOINTS (Refactored to use DB) ---
# All /backup/create, /restore, /erase, /estimate_size endpoints follow this pattern

def start_async_job(job_type_prefix, command_args, token, username):
    """
    Helper function to:
    1. Create K8s Job
    2. Create DB entry
    3. Return DB job_id
    """
    k8s_job_name, error = create_k8s_job(
        job_name_prefix=job_type_prefix,
        command_args=command_args,
        token=token,
        api_server=get_api_server(),
        username=username
    )
    if error:
        return jsonify({"error": f"Failed to create Kubernetes job: {error}"}), 500

    job_id = str(uuid.uuid4())
    created_at = datetime.utcnow().isoformat()
    
    try:
        db = get_db()
        cursor = db.cursor()
        cursor.execute(
            """
            INSERT INTO jobs (job_id, k8s_job_name, job_type, status, username, created_at)
            VALUES (?, ?, ?, ?, ?, ?)
            """,
            (job_id, k8s_job_name, job_type_prefix, "PENDING", username, created_at)
        )
        db.commit()
    except Exception as e:
        app.logger.error(f"Failed to write job {job_id} to DB: {e}")
        # Try to clean up the K8s job we just created
        try:
            batch_v1_api.delete_namespaced_job(k8s_job_name, POD_NAMESPACE)
        except Exception as e2:
            app.logger.error(f"Failed to cleanup orphaned K8s job {k8s_job_name}: {e2}")
        return jsonify({"error": "Failed to register job in database"}), 500

    return jsonify({
        "message": f"Job '{job_type_prefix}' has been started.",
        "job_id": job_id,
        "status_url": f"/job/status/{job_id}"
    }), 202


@app.route("/backup/estimate_size", methods=["GET"])
def estimate_backup_size():
    token, resp, status = extract_token()
    if not token:
        return resp, status
    username, error = validate_token_with_k8s(token)
    if error:
        return jsonify({"error": error}), 403
    return start_async_job("estimate-size", ["--archive", "Size"], token, username)

@app.route("/backup/create", methods=["POST"])
def create_backup():
    token, resp, status = extract_token()
    if not token:
        return resp, status
    username, error = validate_token_with_k8s(token)
    if error:
        return jsonify({"error": error}), 403
    data = request.get_json(silent=True) or {}
    archive_id = data.get("archive_id")
    if not archive_id:
        return jsonify({"error": "Missing required field: 'archive_id'"}), 400
    cmd_args = ["--archive", archive_id, "--backup", "--yes"]
    return start_async_job("backup-create", cmd_args, token, username)

@app.route("/backup/restore", methods=["POST"])
def restore_backup():
    token, resp, status = extract_token()
    if not token:
        return resp, status
    username, error = validate_token_with_k8s(token)
    if error:
        return jsonify({"error": error}), 403
    data = request.get_json(silent=True) or {}
    archive_id = data.get("archive_id")
    restore_id = data.get("restore_id")
    if not archive_id or not restore_id:
        return jsonify({"error": "Missing 'archive_id' and 'restore_id'"}), 400
    cmd_args = ["--archive", archive_id, "--restore", restore_id]
    return start_async_job("backup-restore", cmd_args, token, username)

@app.route("/backup/erase", methods=["POST"])
def erase_backup():
    token, resp, status = extract_token()
    if not token:
        return resp, status
    username, error = validate_token_with_k8s(token)
    if error:
        return jsonify({"error": error}), 403
    data = request.get_json(silent=True) or {}
    archive_id = data.get("archive_id")
    if not archive_id:
        return jsonify({"error": "Missing required field: 'archive_id'"}), 400
    cmd_args = ["--archive", archive_id, "--erase", "--yes"]
    return start_async_job("backup-erase", cmd_args, token, username)

# --- SYNCHRONOUS ENDPOINTS (Unchanged) ---
@app.route("/backup/list", methods=["GET"])
def list_backups():
    token, resp, status = extract_token()
    if not token:
        return resp, status
    username, error = validate_token_with_k8s(token)
    if error:
        return jsonify({"error": error}), 403
    show_all = request.args.get("all", "false").lower() == "true"
    cmd_args = ["--archive", "List"]
    if show_all: cmd_args.append("--all")
    output, error = run_cx_script(get_api_server(), token, cmd_args)
    if error:
        return jsonify({"user": username, "error": error, "raw_output": output}), 500
    return jsonify({"user": username, "raw_output": output}), 200

@app.route("/backup/check_support", methods=["GET"])
def check_backup_support():
    token, resp, status = extract_token()
    if not token:
        return resp, status
    username, error = validate_token_with_k8s(token)
    if error:
        return jsonify({"error": error}), 403
    cmd_args = ["--archive", "Check"]
    output, error = run_cx_script(get_api_server(), token, cmd_args)
    if error:
        return jsonify({"error": error}), 500
    return jsonify({"user": username, "output": output}), 200

@app.route("/token/validate", methods=["POST"])
def validate_token_endpoint():
    token, resp, status = extract_token()
    if not token:
        return resp, status

    username, error = validate_token_with_k8s(token)
    if error:
        return jsonify({"authenticated": False, "error": error}), 403
    return jsonify({"authenticated": True, "user": username}), 200

# --- BACKGROUND JOB REAPER THREAD ---

def job_reaper_thread():
    """
    A background thread that monitors K8s jobs to:
    1. Update DB jobs from PENDING to RUNNING.
    2. Find completed K8s jobs, update their status/logs in the DB, and delete the K8s job.
    """
    app.logger.info("Job Reaper thread starting...")
    while True:
        try:
            if not batch_v1_api:
                app.logger.warning("Reaper: K8s API not ready, sleeping...")
                time.sleep(30)
                continue

            with app.app_context():
                db = get_db()
                cursor = db.cursor()

                # --- 1. Check for jobs moving from PENDING to RUNNING ---
                # (This part is crucial for PENDING -> RUNNING transition)
                try:
                    # Find all DB jobs that are PENDING
                    cursor.execute("SELECT k8s_job_name FROM jobs WHERE status = 'PENDING'")
                    pending_db_jobs = cursor.fetchall()

                    running_updates = []
                    for db_job in pending_db_jobs:
                        k8s_job_name = db_job["k8s_job_name"]
                        try:
                            # Fetch the K8s Job resource to check its status
                            k8s_job = batch_v1_api.read_namespaced_job_status(
                                name=k8s_job_name,
                                namespace=POD_NAMESPACE
                            )
                            
                            # If active is > 0, the job is now running
                            if k8s_job.status.active is not None and k8s_job.status.active > 0:
                                running_updates.append(k8s_job_name)
                                
                        except client.rest.ApiException as e:
                            if e.status != 404:
                                app.logger.error(f"Reaper: Failed to read status of K8s job {k8s_job_name}: {e}")
                        except Exception as e:
                            app.logger.error(f"Reaper: Error during K8s job status check for {k8s_job_name}: {e}")

                    # Batch update the DB for all jobs that are now running
                    if running_updates:
                        placeholders = ','.join('?' * len(running_updates))
                        update_query = f"UPDATE jobs SET status = 'RUNNING' WHERE k8s_job_name IN ({placeholders})"
                        cursor.execute(update_query, running_updates)
                        db.commit()
                        app.logger.info(f"Reaper: Updated {len(running_updates)} jobs from PENDING to RUNNING.")

                except Exception as e:
                    app.logger.error(f"Reaper: Unhandled exception in PENDING->RUNNING check: {e}")


                # --- 2. Check for jobs that moved to SUCCEEDED/FAILED (Final State) ---
                
                # REFACTOR: Fetch all jobs for our app and check their status counts locally for robustness.
                
                jobs_to_process = []
                
                try:
                    # List all K8s jobs with our application label
                    all_webhook_jobs = batch_v1_api.list_namespaced_job(
                        namespace=POD_NAMESPACE,
                        label_selector=K8S_JOB_LABEL
                    )
                except Exception as e:
                    app.logger.error(f"Reaper: Failed to list all webhook jobs: {e}")
                    time.sleep(60) # Re-try in a minute
                    continue


                for job in all_webhook_jobs.items:
                    # A K8s Job is finished if it has a non-zero succeeded count OR a non-zero failed count.
                    succeeded_count = job.status.succeeded or 0
                    failed_count = job.status.failed or 0
                    
                    if succeeded_count > 0 or failed_count > 0:
                        jobs_to_process.append(job)
                
                if not jobs_to_process:
                    # app.logger.info("Reaper: No finished jobs found.")
                    time.sleep(60) # Poll every 60 seconds
                    continue

                app.logger.info(f"Reaper: Found {len(jobs_to_process)} finished jobs to process.")

                for job in jobs_to_process:
                    k8s_job_name = job.metadata.name
                    
                    # Check if we are already processing this job in the DB
                    cursor_check = db.cursor()
                    cursor_check.execute("SELECT status FROM jobs WHERE k8s_job_name = ?", (k8s_job_name,))
                    db_job = cursor_check.fetchone()

                    # Only process the logs/final status if the job isn't already marked finished in the DB
                    if not db_job:
                        app.logger.warning(f"Reaper: Found orphaned K8s job {k8s_job_name}, deleting.")
                    elif db_job['status'] in ('PENDING', 'RUNNING'):
                        app.logger.info(f"Reaper: Processing final status for job {k8s_job_name}...")
                        process_finished_job(db, job)
                    else:
                        app.logger.info(f"Reaper: Job {k8s_job_name} already processed, cleaning up K8s only.")
                    
                    # Clean up the K8s job regardless of DB status (it's finished in K8s)
                    try:
                        batch_v1_api.delete_namespaced_job(
                            name=k8s_job_name,
                            namespace=POD_NAMESPACE,
                            body=client.V1DeleteOptions(propagation_policy="Background")
                        )
                        app.logger.info(f"Reaper: Deleted K8s job {k8s_job_name}.")
                    except client.rest.ApiException as e:
                        if e.status != 404: # Ignore "not found"
                            app.logger.error(f"Reaper: Failed to delete K8s job {k8s_job_name}: {e}")
                    except Exception as e:
                        app.logger.error(f"Reaper: Error deleting K8s job {k8s_job_name}: {e}")

        except Exception as e:
            app.logger.error(f"Reaper: Unhandled exception in reaper thread: {e}")
        
        time.sleep(60) # Poll every 60 seconds

def process_finished_job(db, job):
    """
    Helper for the Reaper: Updates the DB with logs and final status.
    """
    k8s_job_name = job.metadata.name
    # Determine status: SUCCEEDED if job.status.succeeded is not None and > 0, otherwise FAILED.
    status = "SUCCEEDED" if (job.status.succeeded is not None and job.status.succeeded > 0) else "FAILED"
    logs = ""
    
    try:
        # Find the pod for this job
        pod_label_selector = f"job-name={k8s_job_name}" # K8s default
        
        pods_list = core_v1_api.list_namespaced_pod(
            namespace=POD_NAMESPACE, 
            label_selector=pod_label_selector
        )
        if not pods_list.items:
            logs = f"Error: Pod for job {k8s_job_name} not found."
            app.logger.warning(f"Reaper: {logs}")
        else:
            pod_name = pods_list.items[0].metadata.name
            logs = core_v1_api.read_namespaced_pod_log(
                name=pod_name, 
                namespace=POD_NAMESPACE
            )
    except Exception as e:
        logs = f"Error retrieving logs for {k8s_job_name}: {str(e)}"
        app.logger.error(f"Reaper: {logs}")
    
    finished_at = datetime.utcnow().isoformat()
    try:
        cursor = db.cursor()
        # This update applies if the job was PENDING or RUNNING
        cursor.execute(
            """
            UPDATE jobs 
            SET status = ?, finished_at = ?, logs = ?
            WHERE k8s_job_name = ? AND status IN ('PENDING', 'RUNNING')
            """,
            (status, finished_at, logs, k8s_job_name)
        )
        db.commit()
        app.logger.info(f"Reaper: Updated DB for {k8s_job_name} to {status}.")
    except Exception as e:
        app.logger.error(f"Reaper: Failed to update DB for {k8s_job_name}: {e}")


# --- Main Application Start ---
if __name__ == "__main__":
    # Use Gunicorn in a real deployment
    app.run(host="0.0.0.0", port=8443, debug=False)
else:
    # This block runs when Gunicorn imports the file
    init_db()
    reaper_thread = threading.Thread(target=job_reaper_thread, daemon=True)
    reaper_thread.start()␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀app/docker/␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀0000755␀0000000␀0000000␀00000000000␀15116205704␀011604␀ 5␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀ustar  ␀root␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀root␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀app/docker/Dockerfile.oadp-app␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀0000644␀0000000␀0000000␀00000010500␀15116127231␀015270␀ 0␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀ustar  ␀root␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀root␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀# Base image
FROM registry.access.redhat.com/ubi9/ubi-minimal:latest AS builder

# Switch to root to install OS packages and prepare directories
USER root

# Update packages to make sure that we have the latest
# glibc-langpack-en is needed for the en_US.UTF-8 locale (/bin/sh: warning: setlocale: LC_ALL: cannot change locale (en_US.UTF-8) if not installed)
# ca-certificates to get the well known/trusted CA certificates
# tar needed for kubectl file copy support
# Cleanup cache after installation
RUN set -eux; \
    # python3.11 does not appear to install pip or other unwanted dependencies like python3.9
    microdnf install -y --nodocs tar glibc-langpack-en ca-certificates python3.11; \
    ln -s /usr/bin/python3.11 /usr/bin/python; \
    microdnf update -y; \
    microdnf clean all

# Set up pip
RUN curl -fsSLo get-pip.py "https://bootstrap.pypa.io/get-pip.py"; \
    python get-pip.py --ignore-installed

# Install Python dependencies
RUN pip3 install --no-cache-dir flask kubernetes gunicorn

# Remove pip to address potential security vulnerabilities in pip
RUN python -m pip uninstall -y pip

FROM registry.access.redhat.com/ubi9/ubi-minimal:latest

# Switch to root to install OS packages and prepare directories
USER root

# Update packages to make sure that we have the latest
# glibc-langpack-en is needed for the en_US.UTF-8 locale (/bin/sh: warning: setlocale: LC_ALL: cannot change locale (en_US.UTF-8) if not installed)
# ca-certificates to get the well known/trusted CA certificates
# tar needed for kubectl file copy support
# Cleanup cache after installation
RUN set -eux; \
    # python3.11 does not appear to install pip or other unwanted dependencies like python3.9
    microdnf install -y --nodocs tar glibc-langpack-en ca-certificates python3.11; \
    ln -s /usr/bin/python3.11 /usr/bin/python; \
    microdnf update -y; \
    microdnf clean all

# Copy Python packages and executables from builder
COPY --from=builder /usr/local/lib/python3.11 /usr/local/lib/python3.11
COPY --from=builder /usr/local/lib64/python3.11 /usr/local/lib64/python3.11
COPY --from=builder /usr/local/bin/gunicorn /usr/local/bin/gunicorn
COPY --from=builder /usr/local/bin/flask /usr/local/bin/flask

# Working directory
WORKDIR /app

# Copy Flask application
COPY oadp_app/app.py .

# Create required directories and ensure write permissions for non-root users
RUN mkdir -p /usr/local/CX/work /usr/local/CX/log /usr/local/CX/tools /usr/local/CX/data && \
    chmod -R 777 /usr/local/CX

# Copy the required CX files from the build context
COPY scripts/cx.oadp.app.sh /usr/local/CX/tools/cx.oadp.app.sh
COPY scripts/delete-cpd-namespace.sh /usr/local/CX/tools/delete-cpd-namespace.sh
# This will copy the default config OR the custom one placed by the deploy script
COPY config/cx.oadp.app.json /usr/local/CX/data/cx.oadp.app.json
COPY config/global.yml /usr/local/CX/data/global.yml

# Install CLI dependencies required by cx.oadp.app.sh
RUN microdnf install -y jq tar gzip util-linux && \
    curl -L https://github.com/mikefarah/yq/releases/download/v4.46.1/yq_linux_amd64 -o /usr/local/bin/yq && \
    chmod +x /usr/local/bin/yq && \
    microdnf clean all

# Install OpenShift CLI (oc)
RUN curl -LO https://mirror.openshift.com/pub/openshift-v4/clients/ocp/latest/openshift-client-linux.tar.gz && \
    tar -xzf openshift-client-linux.tar.gz -C /usr/local/bin oc && \
    chmod +x /usr/local/bin/oc && \
    rm openshift-client-linux.tar.gz

# --- Install CPD CLI ---
# Use 'jq' to extract the 'cpd-cli' URL from the configuration JSON file.
RUN CPD_CLI_URL=$(jq -r '."cpd-cli"' /usr/local/CX/data/cx.oadp.app.json) && \
    echo "Installing CPD CLI from $CPD_CLI_URL" && \
    curl -L $CPD_CLI_URL -o /tmp/cpd-cli.tgz && \
    # Extract the CLI to /usr/local/bin, stripping the top-level directory from the tarball
    tar --strip-components=1 -xzf /tmp/cpd-cli.tgz -C /usr/local/bin && \
    chmod +x /usr/local/bin/cpd-cli && \
    # Clean up the downloaded tarball to reduce image size
    rm /tmp/cpd-cli.tgz
    
ENV CPD_CLI_WORKSPACE=/usr/local/CX/work

# Add utilities to PATH if needed
ENV PATH="/usr/local/CX/tools:/usr/local/bin:$PATH"

# Drop privileges to non-root (OpenShift requires this)
USER 1001
ENV HOME=/usr/local/CX/work

# Expose HTTPS port
EXPOSE 8443

# Start Flask app using Gunicorn (Production Server)
CMD ["gunicorn", "--workers", "4", "--bind", "0.0.0.0:8443", "app:app"]␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀app/scripts/␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀0000755␀0000000␀0000000␀00000000000␀15116205704␀012024␀ 5␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀ustar  ␀root␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀root␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀app/scripts/cx.oadp.app.sh␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀0000755␀0000000␀0000000␀00000111674␀15115737711␀014517␀ 0␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀ustar  ␀root␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀root␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀#!/bin/bash
